---
/**
 * Native Landing Page: Penakluk Sawit Ganoderma & Daun Kuning Sengkleh (AUSSIE)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: aussie-pupuk-cair-organik (ID: 26039)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/penakluk-sawit-ganoderma.css';

export const prerender = false;

const SLUG = 'penakluk-sawit-ganoderma';

const product =
  (await getStorefrontProduct(Astro.locals, 'aussie-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '26039'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/penakluk-sawit-ganoderma/hero-problem.webp';
---

<BaseLayout
  title={`Obat Sawit Ganoderma & Daun Kuning Sengkleh: Aussie - ${Astro.locals.tenant.name}`}
  description="Solusi darurat kelapa sawit terserang jamur Ganoderma, busuk pangkal batang, dan pelepah kuning sengkleh. Aktifkan imun sawit, kunci jamur, dan pulihkan TBS lebat."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">JANGAN DITEBANG ATAU DIBAKAR DULU!</span>
          Sawit Kuning Sengkleh & Rawan Ganoderma Dijamin <span class="hl-brush">PUPUS SEGAR TEGAP</span> & Pangkal Batang Mengering!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup kocor piringan & semprot pangkal batang <strong class="text-slate-950 font-bold">AUSSIE</strong>: miselium jamur Ganoderma terkunci mati, pupus tombak membuka hijau pekat, dan janjang TBS kembali padat!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan kelapa sawit terserang busuk pangkal batang Ganoderma vs pulih hijau tegap berbuah TBS lebat"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil 21 Hari: Pangkal batang berjamur mengering keras, pelepah kuning kembali hijau tegap!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Immune Cellactivator</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Formula Sawit High-End</span>
        </div>

        <!-- 4 Point Checklist + Above-the-Fold CTA -->
        <div class="mx-5 mt-5 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Kunci Mati Hifa Ganoderma</strong> sebelum pangkal batang keropos & roboh</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Pelepah Kuning Sengkleh</strong> bangkit hijau gelap berlapis silika</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Pacu Akar Adventif Baru</strong> di piringan tanah gambut & mineral masam</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Selamatkan Pohon Produktif</strong> tanpa rugi puluhan juta biaya tumbang-tanam ulang</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Paket Penyelamat Sawit Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Tanda Bahaya Sawit <span class="hl-brush-red">Rawan Tumbang Ganoderma</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Jangan tunggu jamur kipas cokelat keluar dan menular ke seluruh blok kebun:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/gejala-1.webp"
              alt="Pangkal batang kelapa sawit membusuk basah dan keluar jamur kipas Ganoderma boninense"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Pangkal Batang Busuk & Berjamur Kipas
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Serangan Miselium Ganoderma boninense</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Jamur menggerogoti jaringan kayu bagian dalam pangkal batang hingga lunak berair, menghitam, dan tiba-tiba pohon tumbang meski angin pelan.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/gejala-2.webp"
              alt="Pelepah kelapa sawit menguning pucat sengkleh terkulai seperti payung patah dan tombak pupus tidak membuka"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Pelepah Kuning Sengkleh & Tombak Akumulasi
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Saluran Hara Tersumbat & Akar Piringan Mati</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Pelepah bawah patah menggantung kering mengelilingi batang, tombak pupus atas mengumpul tidak mau mekar, dan buah menjadi landak kurus.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Progres Nyata: <span class="hl-brush-red">Pangkal Busuk</span> Jadi <span class="hl-brush">Kekar Produktif</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/overclaim-timeline.webp"
          alt="Tahapan pemulihan kelapa sawit dari gejala Ganoderma minggu ke-1, minggu ke-2, hingga minggu ke-4"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Minggu 1: Jamur Kering</span>
          <span class="text-amber-300">Minggu 2: Akar Baru</span>
          <span class="text-emerald-400">Minggu 4: Pupus Mekar</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/penakluk-sawit-ganoderma/kondisi-rusak.webp"
            alt="Kondisi pangkal batang kelapa sawit busuk terserang jamur Ganoderma dan pelepah sengkleh"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa AUSSIE
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Keropos & Tumbang</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Pangkal batang busuk meluas, pelepah patah, menular ke pokok sebelah.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/penakluk-sawit-ganoderma/kondisi-pulih.webp"
            alt="Kondisi kelapa sawit pulih sehat pelepah hijau tegap dan tandan buah segar padat"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai AUSSIE
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Batang Keras & Subur</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Luka busuk mengering keras, pupus baru membuka, TBS kembali lebat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/aussie-hero.webp"
          alt="Botol Nutrisi Fungisida Organik AUSSIE Asli Dipegang Petani di Kebun Kelapa Sawit"
          class="aspect-[4/5] w-full object-cover object-top"
          width="960"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi AUSSIE Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">AUSSIE Original - Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Immune Cellactivator + Asam Salisilat Alami + Bio-Silika Humat (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Mekanisme <span class="hl-brush">AUSSIE Penakluk Ganoderma</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Mengaktifkan pertahanan sistemik dari akar piringan hingga pucuk tombak:
      </p>

      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/overclaim-1.webp"
              alt="Jaringan pangkal batang kelapa sawit mengering keras terlindungi perisai kalus pasca aplikasi AUSSIE"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • SEGEL JARINGAN BATANG
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Kunci Mati Hifa Ganoderma & Keraskan Pangkal Batang!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam Salisilat alami & Bio-Silika memicu reaksi <em>Systemic Acquired Resistance</em> (SAR) yang menghentikan enzim pelapuk kayu Ganoderma dan mengeraskan dinding sel batang.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/overclaim-2.webp"
              alt="Pupus tombak muda kelapa sawit membuka tegap hijau gelap pasca pemulihan AUSSIE"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • BUKA KUNCIAN PUPUS TOMBAK
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Tombak Mengumpul Langsung Mekar & Pelepah Hijau Tegap!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam amino L-bebas dan Humat-Fulvat memacu keluarnya akar serap baru di piringan sehingga aliran air dan nutrisi kembali deras sampai ke titik tumbuh atas.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penakluk-sawit-ganoderma/overclaim-3.webp"
              alt="Tandan buah segar kelapa sawit kembali padat mengelilingi batang pasca perawatan AUSSIE"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • PULIHKAN PRODUKSI TBS
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Batal Tebang Pohon, Janjang TBS Kembali Padat Berbobot!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mengembalikan keseimbangan hormon pembungaan sehingga ketiak pelepah kembali mengeluarkan bunga betina yang jadi tandan buah segar berondol besar.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/macro-proof.webp"
          alt="Detail makro pupus kelapa sawit hijau segar membuka tegap bebas busuk pucuk"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Bukti Pemulihan: Pupus muda membuka hijau mengkilap, tanda akar piringan kembali aktif bekerja!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/penakluk-sawit-ganoderma/aplikasi-kebun.webp"
          alt="Petani menyemprot dan mengocor larutan nutrisi AUSSIE di pangkal batang dan piringan kelapa sawit"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            <strong>60–80 ml AUSSIE</strong> per tangki 16L air bersih.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Semprot pangkal batang 1,5m & <strong>kocor piringan akar</strong>.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Ulangi tiap <strong>14 hari sekali</strong> (cukup 3 kali).
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Lapangan: <span class="hl-brush">Ribuan Pokok Sawit Selamat</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/penakluk-sawit-ganoderma/testi-1.webp"
            alt="Pak Syamsuddin di Rokan Hulu Riau bersama pokok kelapa sawit yang pulih dari serangan Ganoderma"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
