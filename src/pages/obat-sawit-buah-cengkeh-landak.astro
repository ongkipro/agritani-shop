---
/**
 * Native Landing Page: Obat Sawit Buah Cengkeh, Buah Landak & Bunga Jantan Vesipera (AUSSIE)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: aussie-pupuk-cair-organik (ID: 26039)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/obat-sawit-buah-cengkeh-landak.css';

export const prerender = false;

const SLUG = 'obat-sawit-buah-cengkeh-landak';

const product =
  (await getStorefrontProduct(Astro.locals, 'aussie-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '26039'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/obat-sawit-buah-cengkeh-landak/hero-problem.webp';
---

<BaseLayout
  title={`Obat Sawit Buah Cengkeh, Buah Landak & Bunga Jantan Vesipera: Aussie - ${Astro.locals.tenant.name}`}
  description="Jangan buru-buru ditumbang! Ubah kelapa sawit berbuah cengkeh, buah landak, dan bunga jantan Vesipera menjadi tandan buah segar (TBS) normal 30+ kg berondol merah padat dengan AUSSIE Original."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Over-Claim, Competitor-Killer, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">SAWIT BERBUAH CENGKEH, BUAH LANDAK ATAU JANTAN TERUS?</span>
          Ubah Sawit Buah Cengkeh, Buah Landak & Bunga Jantan Vesipera Jadi <span class="hl-brush">TANDAN NORMAL 30+ KG</span> Berondol Merah Padat!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Jangan buru-buru ditumbang! Kocor piringan akar dengan <strong class="text-slate-950 font-bold">AUSSIE Original (Bisa Scan Barcode)</strong>: buka kuncian hara tanah gambut/mineral masam, seimbangkan hormon bunga betina, dan ubah janjang cengkeh/landak jadi TBS bulat berbobot!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan tandan kelapa sawit buah cengkeh dan buah landak vs berubah jadi TBS normal 30+ kg berondol merah padat"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Batal Tumbang Pokok: Bunga betina kembali muncul melingkar & berondol terisi penuh daging minyak!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Pembuka Kunci Bunga Betina</span>
          <span class="text-slate-300">•</span>
          <span>Bisa Scan Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
        </div>

        <!-- 4 Point Over-Claim Checklist + Above-the-Fold CTA -->
        <div class="mx-5 mt-5 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Normalisasi Buah Cengkeh & Buah Landak</strong> akibat gagal penyerbukan dan defisiensi mikro Boron-Kalium</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Ubah Dominasi Bunga Jantan (Vesipera)</strong> kembali mengeluarkan seludang bunga betina di tiap ketiak pelepah</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Buka Kuncian Hara Tanah Masam/Gambut</strong> sehingga pupuk NPK yang selama ini tertahan langsung terserap</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Dongkrak Bobot Janjang +4 s/d 7 Kg</strong> dengan berondol bulat besar, merah mengkilap, dan lolos sortir RAM/PKS</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Paket Penormal Buah Sawit Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Kerugian Besar <span class="hl-brush-red">Sawit Cengkeh, Landak & Jantan</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Sudah keluar uang jutaan beli pupuk tabur, tapi hasil panen tetap ditolak tengkulak dan RAM:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/obat-sawit-buah-cengkeh-landak/gejala-1.webp"
              alt="Tandan kelapa sawit berbuah cengkeh kecil-kecil dan buah landak berduri rapat tanpa daging minyak"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Buah Cengkeh & Buah Landak Kecil-Kecil Tanpa Daging Minyak (Ditolak RAM/PKS)
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Buah Cengkeh & Buah Landak Kecil-Kecil Tanpa Daging Minyak (Ditolak RAM/PKS)</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Akibat malnutrisi mikro dan stres fisiologis, berondol gagal membesar (kerdil lancip seperti cengkeh atau terjepit duri landak), tidak berdaging minyak, dan kena potongan berat di PKS.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/obat-sawit-buah-cengkeh-landak/gejala-2.webp"
              alt="Kelapa sawit hanya mengeluarkan bunga jantan Vesipera mengering dan mengalami trek panjang"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Dominasi Bunga Jantan (Vesipera) & Trek Panjang Akibat Akar Terkunci Tanah Masam
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Dominasi Bunga Jantan (<em>Vesipera</em>) & Trek Panjang Akibat Akar Terkunci Tanah Masam</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Saat akar tercekik keasaman tanah (pH rendah) dan stres kemarau, pohon otomatis mengubah bakal bunga menjadi bunga jantan semua sehingga pokok kosong berbulan-bulan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Cengkeh & Jantan</span> Jadi <span class="hl-brush">TBS Bulat Padat</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/obat-sawit-buah-cengkeh-landak/overclaim-timeline.webp"
          alt="Tahapan perubahan sawit dari bunga jantan dan buah cengkeh menjadi tandan buah segar normal berbobot"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Tahap 1: Buka Kunci Akar</span>
          <span class="text-amber-300">Tahap 2: Bunga Betina</span>
          <span class="text-emerald-400">Tahap 3: TBS 30+ Kg</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/obat-sawit-buah-cengkeh-landak/kondisi-rusak.webp"
            alt="Tandan kelapa sawit tanpa AUSSIE berbuah cengkeh landak kerdil dan bunga jantan"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa AUSSIE
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Cengkeh, Landak & Jantan</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Berondol kempes tanpa minyak, ditolak RAM, panen trek parah.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/obat-sawit-buah-cengkeh-landak/kondisi-pulih.webp"
            alt="Tandan kelapa sawit pakai AUSSIE berubah jadi TBS normal berondol bulat besar merah mengkilap"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai AUSSIE
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Janjang Normal 30+ Kg</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Bunga betina jadi buah sempurna, berondol besar padat minyak.
            </p>
          </div>
        </div>
      </div>

      <!-- Competitor-Killer Head-to-Head Matrix -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-50/60 shadow-sm">
        <div class="bg-slate-900 px-3.5 py-2.5 text-center">
          <h3 class="text-[13px] font-bold text-white">
            Mengapa Tabur NPK & Borax Biasa Gagal vs Keunggulan Mutlak AUSSIE?
          </h3>
        </div>
        <div class="divide-y divide-slate-200 text-[11px] leading-snug">
          <div class="grid grid-cols-2 bg-slate-100 font-bold text-slate-900">
            <div class="p-2.5 text-red-700 border-r border-slate-200">✗ Tabur NPK Tunggal & Borax/Garam Biasa</div>
            <div class="p-2.5 text-emerald-800 bg-emerald-50/60">✓ AUSSIE Pembuka Kunci Bunga Betina & Pengisi Daging TBS</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Terkunci di Tanah Masam:</strong> Pupuk butiran NPK mengendap terikat zat asam/besi di gambut sehingga akar gagal menyerap.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Chelate Humat-Fulvat Aktif:</strong> Membuka ikatan hara tanah masam dan menyuapi akar piringan secara instan.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Tidak Mengubah Hormon Jantan:</strong> Garam/pupuk makro biasa tidak mampu menekan hormon stres pemicu bunga jantan <em>Vesipera</em>.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Pacu Diferensiasi Bunga Betina:</strong> L-Amino & Boron-Chelate mengembalikan rasio bunga betina produktif di tiap pelepah.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Penyerbukan Tetap Gagal:</strong> Putik bunga lemah dan mengering sehingga janjang tumbuh jadi buah cengkeh atau buah landak.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Sempurnakan Pengisian Berondol:</strong> Memperkuat putik bunga & memompa Kalium organik agar berondol bulat penuh minyak.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Boros Tonase & Menguap:</strong> Butuh ratusan kilo pupuk tabur yang habis hanyut terbawa air hujan.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Cukup Kocor Rp 5.500/Pokok:</strong> Langsung meresap ke zona akar aktif, hemat biaya pupuk kimia hingga 50%.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/obat-sawit-buah-cengkeh-landak/aussie-hero.webp"
          alt="Botol Resmi Nutrisi Kelapa Sawit AUSSIE Original Dipegang Petani"
          class="aspect-[4/5] w-full object-cover"
          width="960"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Barcode Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi AUSSIE Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">AUSSIE Original — Bisa Scan Barcode & Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Awas barang tiruan! Kemasan resmi dilengkapi Barcode Verifikasi Keaslian + Pembuka Kunci Bunga Betina (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Cara Kerja <span class="hl-brush">AUSSIE Pengubah Buah Sawit</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Memperbaiki akar, hormon pembungaan, dan pengisian daging buah dari dalam:
      </p>

      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/obat-sawit-buah-cengkeh-landak/overclaim-1.webp"
              alt="Tandan kelapa sawit yang semula buah cengkeh berubah menjadi berondol bulat besar seragam"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • NORMALISASI BUAH CENGKEH & LANDAK
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Sempurnakan Penyerbukan & Pembesaran Berondol!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Suplai mikro Boron-Chelate dan Asam Amino mengaktifkan kesuburan putik bunga sehingga tandan baru terisi berondol bulat besar secara merata tanpa terjepit duri.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/obat-sawit-buah-cengkeh-landak/overclaim-2.webp"
              alt="Munculnya seludang bunga betina baru yang padat melingkari batang kelapa sawit"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • HENTIKAN BUNGA JANTAN VESIPERA
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Keluarkan Bunga Betina Melingkar di Tiap Ketiak Pelepah!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Menurunkan stres fisiologis pohon akibat tanah masam dan kemarau sehingga titik tumbuh ketiak pelepah kembali memproduksi bunga betina calon TBS.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/obat-sawit-buah-cengkeh-landak/overclaim-3.webp"
              alt="Hasil panen tandan buah segar kelapa sawit super berat 30+ kg merah mengkilap"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • POMPA BOBOT & RENDEMEN MINYAK
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daging Mesokarp Tebal, Timbangan Janjang Naik 4–7 Kg!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
