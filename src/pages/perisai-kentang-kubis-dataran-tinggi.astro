---
/**
 * Native Landing Page: Perisai Kentang & Kubis Anti Busuk Daun Lodoh Phytophthora: Kojien
 *
 * Clean, High-Contrast Direct-Response LP (Precision Visuals & Scannable Copy)
 * Master Product: kojien (ID: 99118)
 * Architecture Contract: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/perisai-kentang-kubis-dataran-tinggi.css';

export const prerender = false;

const SLUG = 'perisai-kentang-kubis-dataran-tinggi';

const product =
  (await getStorefrontProduct(Astro.locals, 'kojien')) ??
  (await getStorefrontProduct(Astro.locals, '99118'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/perisai-kentang-kubis-dataran-tinggi/hero-problem.webp';
---

<BaseLayout
  title={`Perisai Kentang & Kubis Anti Busuk Daun Lodoh Phytophthora: Kojien - ${Astro.locals.tenant.name}`}
  description="Lindungi tanaman kentang dan kubis dataran tinggi dari serangan busuk daun lodoh (Phytophthora), akar gada, dan cetak umbi kentang Grade A dengan KOJIEN!."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-5">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white">
          PERISAI KENTANG & KUBIS DATARAN TINGGI
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[24px] font-bold leading-[1.18] tracking-tight text-slate-950">
          Bentengi Kentang & Kubis Dari Kabut <span class="hl-brush">BUSUK DAUN LODOH</span> & Panen Umbi Grade A!
        </h1>
        <p class="mx-auto mt-2.5 max-w-[400px] text-[14px] font-normal leading-snug text-slate-700">
          Lapisi daun dengan perisai Bio-Silika penolak air kabut dingin agar bebas jamur Phytophthora dan umbi membengkak mulus.
        </p>
      </div>

      <div class="mt-4">
        <div class="overflow-hidden bg-slate-950">
          <img
            src={heroImage}
            alt="Perisai Kentang & Kubis Anti Busuk Daun Lodoh Phytophthora: Kojien"
            class="aspect-[16/9] w-full object-cover"
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="grid grid-cols-2 border-t border-slate-800 bg-slate-950 text-xs font-bold">
            <div class="border-r border-slate-800 bg-red-950/80 px-2.5 py-2 text-red-200">
              SEBELUM: Daun Lodoh Hitam Busuk
            </div>
            <div class="bg-emerald-950/80 px-2.5 py-2 text-emerald-200">
              SESUDAH: Daun Kaku & Umbi Jumbo
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-4 text-xs font-semibold text-slate-700">
          <span>✓ Garansi 100% Asli</span>
          <span class="text-slate-300">•</span>
          <span>✓ Segel Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>✓ Bisa COD</span>
        </div>

        <!-- Scannable 4-Point Checklist + Primary CTA -->
        <div class="mx-5 mt-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Efek Daun Talas Penolak Air Kabut:</strong> Air hujan dan embun beku langsung menggelinding tanpa merusak daun.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Hentikan Busuk Daun (Lodoh Hitam):</strong> Blokir jamur Phytophthora infestans yang menghanguskan kebun dalam semalam.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Cegah Pecah Krop Kubis & Busuk Lunak:</strong> Dinding sel kubis rapat, padat berat, dan tahan angkut jarak jauh.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Umbi Kentang Mulus Ukuran Super A/B:</strong> Kulit kentang tebal bersih bebas bercak busuk dan bobot naik tajam.</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Perisai KOJIEN! Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION -->
    <section class="bg-red-50/40 px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        2 Ancaman Mematikan <span class="hl-brush-red">Kebun Sayur Dataran Tinggi</span>
      </h2>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/perisai-kentang-kubis-dataran-tinggi/gejala-1.webp"
              alt="Serangan Lodoh Hitam (Phytophthora) Saat Kabut Tebal"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 1
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Serangan Lodoh Hitam (Phytophthora) Saat Kabut Tebal</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Kelembapan tinggi membuat bercak basah hitam menyebar cepat membakar seluruh daun kentang hanya dalam 3 hari.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/perisai-kentang-kubis-dataran-tinggi/gejala-2.webp"
              alt="Umbi Kentang Kecil Berair & Krop Kubis Busuk Dalam"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 2
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Umbi Kentang Kecil Berair & Krop Kubis Busuk Dalam</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Daun yang rusak sebelum waktunya menghentikan pengisian umbi dan memicu bakteri Erwinia pembusuk krop.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        Bukti Perubahan: <span class="hl-brush-red">Lodoh & Busuk</span> Jadi <span class="hl-brush">Daun Tebal & Panen Super</span>
      </h2>

      <div class="-mx-5 mt-3.5 mb-4 overflow-hidden bg-slate-950">
        <img
          src="/images/landing/perisai-kentang-kubis-dataran-tinggi/overclaim-timeline.webp"
          alt="Tahapan pemulihan dan panen"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 border-t border-slate-800 bg-slate-950 px-2 py-2 text-center text-xs font-bold">
          <span class="text-amber-300">7 Hari: Daun Tebal Berlilin</span>
          <span class="text-emerald-300">30 Hari: Kebal Kabut & Hujan</span>
          <span class="text-emerald-400">Panen: Kentang Super & Kubis Padat</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
          <img
            src="/images/landing/perisai-kentang-kubis-dataran-tinggi/kondisi-rusak.webp"
            alt="Hangus Lodoh Hitam"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
            Tanpa KOJIEN!
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-slate-900">Hangus Lodoh Hitam</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-slate-600">
              Daun lonyot menghitam, umbi busuk berair, modal bibit hangus.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40">
          <img
            src="/images/landing/perisai-kentang-kubis-dataran-tinggi/kondisi-pulih.webp"
            alt="Daun Utuh & Umbi Mulus"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-xs font-bold text-white">
            Pakai KOJIEN!
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-emerald-950">Daun Utuh & Umbi Mulus</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-emerald-900">
              Tahan gempuran kabut hujan, umbi Grade A besar mulus.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SHOWCASE & 3 CORE PILLARS -->
    <section class="bg-emerald-950 px-5 py-7 text-white">
      <div class="text-center">
        <span class="inline-block rounded-full bg-emerald-800 px-3 py-1 text-xs font-bold text-emerald-100">
          FORMULA BIOAKTIF RESMI
        </span>
        <h2 class="mx-auto mt-2 text-[20px] font-bold leading-[1.2] tracking-tight text-white">
          3 Keunggulan <span class="hl-brush">Formula Bio-Silika KOJIEN! Dataran Tinggi</span>
        </h2>
      </div>

      <!-- Full-Width 16:9 Precision Product Bottle Card -->
      <div class="mt-4 overflow-hidden rounded-xl border border-emerald-700 bg-emerald-900/60 shadow-sm">
        <img
          src="/images/landing/perisai-kentang-kubis-dataran-tinggi/kojien-hero.webp"
          alt="KOJIEN! 500ML — Perisai Bio-Silika Dataran Tinggi"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3.5 text-center">
          <h3 class="text-[15px] font-bold text-white">KOJIEN! 500ML — Perisai Bio-Silika Dataran Tinggi</h3>
          <p class="mt-0.5 text-xs font-normal text-emerald-200">
            Thailand Technology • Anti-Lodoh Kentang & Pengunci Krop Kubis
          </p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Lapisan Kutikula Silika Anti-Embun</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Membentuk perisai mikroskopis pada daun sehingga spora jamur tidak bisa menempel.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Imun Seluler Sulfur & Molibdenum</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Mengeringkan luka bercak lodoh dengan cepat dan menjaga daun tetap hijau.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Pemadat Umbi Kentang & Krop Kubis</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Meningkatkan berat jenis umbi kentang dan kerapatan gulungan daun kubis.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. COMPACT SOP FIELD GUIDE -->
    <section class="bg-slate-50 px-5 py-7">
      <h2 class="text-center text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        3 Langkah Mudah <span class="hl-brush">Dosis & Aplikasi</span>
      </h2>

      <div class="mt-4 space-y-2.5">
        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Perlindungan Awal (20–30 HST)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Semprot 2–3 ml KOJIEN! per liter air tiap 7 hari untuk menebalkan daun.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Musim Kabut / Hujan Ekstrem</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Rapatkan jadwal semprot 5 hari sekali untuk mengunci ketahanan lodoh.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Fase Pengisian Umbi / Krop</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Teruskan aplikasi hingga 2 minggu sebelum panen agar bobot maksimal.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FARMER TESTIMONIALS -->
    <section class="bg-white px-5 py-7">
      <div class="text-center">
        <h2 class="mx-auto text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Hasil Nyata di Lapangan
        </h2>
      </div>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/perisai-kentang-kubis-dataran-tinggi/testi-1.webp"
            alt="Pak Haji Munir — Dieng, Wonosobo"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Haji Munir — Dieng, Wonosobo</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Aman Dari Badai Kabut Lodoh</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Musim hujan kemarin banyak kebun kentang Dieng yang ludes menghitam umur 50 hari. Kebun saya rutin KOJIEN daunnya kaku tebal, panen utuh umur 95 hari!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/perisai-kentang-kubis-dataran-tinggi/testi-2.webp"
            alt="Mas Hendri — Batu, Malang"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Mas Hendri — Batu, Malang</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Kentang Dominan Grade Super</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Kulit kentangnya bersih kuning mulus dan berat banget. Dari 1 ton bibit panen bersih tembus 18 ton!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/perisai-kentang-kubis-dataran-tinggi/testi-3.webp"
            alt="Pak Ginting — Berastagi, Karo"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Ginting — Berastagi, Karo</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Kubis Padat Nggak Pecah</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Krop kubisnya bulat padat kayak batu dan nggak ada yang busuk basah. Masuk truk kirim ke Medan aman tanpa susut."
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION -->
    <section id="checkout-form" class="scroll-mt-8 border-t border-slate-100 bg-white py-8">
      <div class="px-5 pb-5 text-center">
        <h2 class="mx-auto max-w-[360px] text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Perisai Sayur KOJIEN! Original</span>
        </h2>
        <p class="mx-auto mt-1.5 max-w-[360px] text-[13px] font-normal text-slate-600">
          Pilih kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}). Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={preferredVariant?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <StickyLandingCtaBar
    ctaText="Pesan KOJIEN! Sekarang — Bisa COD"
    subText="Garansi Original Thailand Technology • Bayar di Tempat"
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
