---
/**
 * Native Landing Page: Serum Anggrek Mekar Lebat, Mawar & Aglonema Tanpa Bau Amis (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/serum-anggrek-mekar-tanpa-amis.css';

export const prerender = false;

const SLUG = 'serum-anggrek-mekar-tanpa-amis';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/serum-anggrek-mekar-tanpa-amis/hero-problem.webp';
---

<BaseLayout
  title={`Serum Anggrek Mekar Lebat, Mawar & Aglonema Merona 100% Tanpa Bau Amis | ${Astro.locals.tenant.name}`}
  description="Pecahkan spike anggrek mekar lebat, mawar & aglonema merona dalam 14 hari dengan SARATOGA Japanese Odorless Serum. 100% tanpa bau amis di teras rumah."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">TANAMAN HIAS SUBUR DAUN TAPI SUSAH MUNCUL BUNGA?</span>
          Pecahkan Spike Anggrek Mekar Lebat, Mawar & Aglonema Merona Dalam 14 Hari — <span class="hl-brush">100% TANPA BAU AMIS</span> di Teras Rumah!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup tetes & semprot <strong class="text-slate-950 font-bold">SARATOGA</strong> (Japanese Odorless Serum): bangunkan mata tidur spike anggrek yang mogok berbunga bertahun-tahun, tajamkan mutasi warna merah Aglonema, dan belah daun Monstera tanpa bau busuk!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi anggrek mekar lebat di halaman rumah serta aglonema merah merona dan monstera setelah aplikasi serum SARATOGA tanpa bau amis"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Terbukti di Teras Rumah: Pecah 2–3 spike anggrek dalam 14 hari, mekar awet 90 hari & 100% bebas bau amis!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Japanese Odorless Serum</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Pupuk Cair Hemat Tetes</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Bangunkan mata tidur anggrek & mawar yang mogok berbunga hingga pecah spike dalam 14 hari</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>100% Odorless (Tanpa Bau Amis) — bersih higienis di teras rumah tanpa mengundang semut & kecoa</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tajamkan mutasi warna merah merona Aglonema Suksom/Khanza & pacu daun Monstera belah jumbo</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Pupuk cair konsentrat hemat tetes: 1 botol cukup untuk ratusan pot tanaman hias selama berbulan-bulan</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Serum Anggrek & Tanaman Hias SARATOGA — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Keluhan Utama <span class="hl-brush-red">Pecinta Anggrek & Tanaman Hias</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Kenapa tanaman hias di teras rumah cuma keluar daun hijau tapi gak pernah berbunga:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/serum-anggrek-mekar-tanpa-amis/gejala-1.webp"
              alt="Anggrek dan mawar cuma tumbuh daun hijau tapi mogok berbunga bertahun-tahun"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Subur Daun Tapi Mogok Bunga
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Anggrek & Mawar Cuma Tumbuh Daun Hijau Tapi Mogok Berbunga Bertahun-Tahun</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Kelebihan nitrogen dan kurangnya asam amino pembunga (L-Prolin, Boron & GA3 aktif) membuat mata tunas spike anggrek tertidur permanen dan warna merah aglonema pudar menghijau.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/serum-anggrek-mekar-tanpa-amis/gejala-2.webp"
              alt="Pupuk organik cair biasa berbau amis menyengat di teras rumah dan mengundang semut kecoa"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. POC Biasa Bau Amis di Teras Rumah
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Pupuk Organik Biasa Berbau Amis Menyengat di Teras Rumah & Mengundang Semut/Kecoa</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Menyemprot POC atau asam amino ikan di balkon dan ruang tamu menyebarkan bau bangkai berhari-hari serta memancing koloni semut bersarang di media pot anggrek.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Mogok Bunga</span> Jadi <span class="hl-brush">Mekar Rimbun</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/serum-anggrek-mekar-tanpa-amis/overclaim-timeline.webp"
          alt="Tahapan kebangkitan anggrek mogok berbunga hingga pecah spike 14 hari dan mekar lebat dengan SARATOGA"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Mogok Spike</span>
          <span class="text-amber-300">Hari 7: Akar Jalan</span>
          <span class="text-emerald-400">14 Hari: Pecah Spike</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/serum-anggrek-mekar-tanpa-amis/kondisi-rusak.webp"
            alt="Kondisi anggrek gundul susah muncul bunga dan aglonema pucat tanpa SARATOGA"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Susah Muncul Bunga</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Cuma tumbuh daun hijau kusam, bertahun-tahun gak keluar spike.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/serum-anggrek-mekar-tanpa-amis/kondisi-pulih.webp"
            alt="Kondisi anggrek mekar lebat dan aglonema merah merona di teras rumah berkat SARATOGA"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Mekar Lebat & Merona</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Spike anggrek mekar serempak tahan 3 bulan & 100% bebas bau amis.
            </p>
          </div>
        </div>
      </div>

      <!-- HEAD-TO-HEAD COMPETITOR-KILLER MATRIX -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-50/80 shadow-sm">
        <div class="bg-slate-950 px-4 py-3 text-center">
          <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            RAHASIA KOLEKTOR ANGGREK & AGLONEMA!
          </span>
          <h3 class="mt-1 text-[15px] font-bold leading-snug text-white">
            Mengapa Vitamin B1 & POC Amis Gagal Membungakan vs SARATOGA?
          </h3>
        </div>

        <div class="divide-y divide-slate-200 text-[12px]">
          <div class="grid grid-cols-2 bg-slate-100 font-bold text-slate-900">
            <div class="border-r border-slate-200 p-2.5 text-red-700">
              ✗ Vitamin B1 Biasa & POC Bau Amis Menyengat di Teras
            </div>
            <div class="p-2.5 text-emerald-900">
              ✓ SARATOGA Japanese Odorless Serum (L-Prolin + Boron + GA3 Aktif)
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Cuma Anti-Stres Tanpa Pembunga:</strong>
              Vitamin B1 hanya menyegarkan akar pindah pot, tidak punya hormon pemecah spike bunga anggrek.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Pecah Spike Anggrek 14 Hari:</strong>
              L-Prolin + Boron + GA3 aktif langsung membangunkan mata tunas tidur agar keluar 2–3 spike bunga!
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Bau Busuk & Undang Semut/Kecoa:</strong>
              POC biasa membuat teras rumah bau amis menyengat dan mengundang hama merusak akar di dalam pot.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">100% Tanpa Bau Amis (Odorless):</strong>
              Serum jernih teknologi Jepang yang bersih higienis, sangat aman disemprot di ruang tamu & teras rumah.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Pupuk Kimia Membakar Akar Angin:</strong>
              Garam NPK butiran membuat ujung akar anggrek menghitam gosong dan daun aglonema lonyot.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Sejuk di Akar & Tajamkan Warna:</strong>
              Memicu ujung akar hijau jalan cepat, menyalakan merah Aglonema & membelah daun Monstera simetris.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Boros Beli Botol Kecil-Kecil:</strong>
              Harus beli botol khusus akar, daun, dan bunga terpisah yang cepat habis dalam beberapa minggu.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Pupuk Cair Hemat Tetes All-in-One:</strong>
              Cukup 1–2 tutup per sprayer untuk Anggrek, Mawar, Bougenville, Aglonema & Monstera sekaligus!
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Image -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/serum-anggrek-mekar-tanpa-amis/saratoga-hero.webp"
          alt="Botol SARATOGA Original 100% Odorless Japanese Serum di teras tanaman anggrek mekar"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram + Shieldtag Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Original 100% Odorless Japanese Serum Berhologram"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <span class="inline-block rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">
            GARANSI 100% ORIGINAL • ODORLESS JAPANESE SERUM
          </span>
          <p class="mt-1 text-[12px] font-bold text-emerald-950">SARATOGA Original — 100% Odorless Japanese Serum Berhologram</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Lindungi koleksi anggrek & tanaman hias kesayangan Anda dari pupuk palsu! SARATOGA resmi bersegel hologram & Shieldtag verifikasi (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Keajaiban <span class="hl-brush">Odorless Serum SARATOGA</span> di Teras Anda
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Nutrisi seluler siap serap untuk membungakan dan mempercantik seluruh tanaman hias rumah:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/serum-anggrek-mekar-tanpa-amis/overclaim-1.webp"
              alt="Spike bunga anggrek bulan dan dendrobium mekar lebat serempak di halaman rumah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • BOOSTER BUNGA SUSAH MUNCUL
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Pecahkan Spike Anggrek, Mawar & Bougenville Dalam 14 Hari!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Menembus batang dan ketiak daun anggrek untuk membangunkan mata tidur hingga muncul tangkai bunga panjang penuh knop yang mekar awet 90 hari.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/serum-anggrek-mekar-tanpa-amis/overclaim-2.webp"
              alt="Daun Aglonema Suksom merah menyala mengkilap dan keluar banyak tunas caling"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • MUTASI WARNA MERAH AGLONEMA
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daun Tebal Mengkilap Merona & Pecah 3–4 Anakan Caling!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Meningkatkan pigmen warna merah menyala pada Aglonema sekaligus merangsang munculnya jarum tunas anakan baru dari bonggol bawah.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/serum-anggrek-mekar-tanpa-amis/overclaim-3.webp"
              alt="Daun baru Monstera membuka lebar belah simetris bersih tanpa bau amis di dalam ruangan"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • MONSTERA JUMBO & 100% TANPA AMIS
              </span>
