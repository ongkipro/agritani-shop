          alt="Foto panorama hamparan sawah padi menguning keemasan siap panen"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-950 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Hamparan Sawah Kuning Emas: Malai padi merunduk berat tanda gabah padat berisi!
