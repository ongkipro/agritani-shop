---
/**
 * Native Landing Page: Penyembuh Asem-Aseman Padi (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/penyembuh-asem-aseman.css';

export const prerender = false;

const SLUG = 'penyembuh-asem-aseman';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/penyembuh-asem-aseman/hero-problem.webp';
---

<BaseLayout
  title={`Obat Padi Asem-Aseman: 4 Hari Daun Merah Karat Jadi Hijau Royo & 40+ Anakan | ${Astro.locals.tenant.name}`}
  description="Solusi darurat padi sawah kerdil asem-aseman akibat tanah masam dan jerami belum matang. Cuci asam seketika, akar putih gondrong, anakan meledak 40+ batang."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">JANGAN DIBIARKAN MENGUNING KARAT!</span>
          Padi Asem-Aseman Dijamin <span class="hl-brush">HIJAU ROYO-ROYO</span> & Meledak 40+ Anakan
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup semprot kabut <strong class="text-slate-950 font-bold">BENSU</strong>, racun asam tanah & besi pirit netral seketika, akar putih keluar gondrong, anakan produktif melimpah tanpa buang modal NPK!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi padi asem-aseman daun merah karat vs pulih hijau royo-royo sehabis semprot BENSU"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil 4 Hari: Daun merah karat pulih hijau pekat, anakan produktif meledak 40+ batang!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>100% Organik Dingin</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Garansi Pulih 4 Hari</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Netralisir racun asam jerami mentah & besi pirit (Fe) di lumpur sawah</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Terserap instan lewat stomata daun dalam 2 jam tanpa membebani akar</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tumbuhkan akar serabut putih baru & ledakkan 40+ anakan produktif</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Selamatkan sawah umur 10–25 HST tanpa perlu bongkar atau tanam ulang</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Paket Penyembuh Asem-Aseman — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Bahaya Fatal <span class="hl-brush-red">Padi Asem-Aseman di Umur 10–25 HST</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Jangan nekat menabur Urea/NPK saat akar padi sedang keracunan asam lumpur:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyembuh-asem-aseman/gejala-1.webp"
              alt="Daun padi sawah berkarat merah menguning dan kerdil akibat asem-aseman"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Daun Karat Merah & Stomata Mengunci
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Pembusukan Jerami Mentah & Keracunan Besi (Fe)</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Sisa jerami yang belum matang menurunkan pH lumpur drastis dan melepaskan besi pirit beracun yang membuat daun padi merah berkarat.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyembuh-asem-aseman/gejala-2.webp"
              alt="Akar padi menghitam busuk di lumpur dan anakan padi macet kerdil"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Akar Hitam Busuk & Anakan Macet
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Salah Hantam Urea Bikin Akar Makin Gosong</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Menabur pupuk kimia panas saat akar sedang lemas menghitam membuat rumpun mati suri dan anakan mentok 7–10 batang.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Asem-Aseman</span> Jadi <span class="hl-brush">Anakan Meledak</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/penyembuh-asem-aseman/overclaim-timeline.webp"
          alt="Tahapan pemulihan padi dari asem-aseman hari ke-0 hingga meledak anakan dengan Bensu"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Merah Karat</span>
          <span class="text-amber-300">Hari 2: Akar Putih</span>
          <span class="text-emerald-400">Hari 4: Hijau & Beranak</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/penyembuh-asem-aseman/kondisi-rusak.webp"
            alt="Kondisi padi sawah asem-aseman daun merah karat dan kerdil"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Kondisi Asem-Aseman
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Daun Karat & Kerdil</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Akar hitam lemas di lumpur, pucuk kaku menguning, anakan macet.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/penyembuh-asem-aseman/kondisi-pulih.webp"
            alt="Kondisi padi sawah pulih subur anakan lebat sehabis semprot Bensu"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Hasil 4 Hari BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Hijau Royo & 40+ Anakan</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Daun jegrik hijau pekat, akar serabut putih gondrong, anakan rapat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Image -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/penyembuh-asem-aseman/bensu-hero.webp"
          alt="Botol Pupuk Organik Cair BENSU di Lahan Persawahan Subur Hijau"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi BENSU Segel Hologram"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">BENSU Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Asam Amino L-Isomer + Glisin Betain + Humat Bioaktif Dingin (500ml & 1L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Nutrisi Dingin BENSU</span> Pencuci Asam Tanah
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Menyelamatkan rumpun padi kerdil tanpa membebani perakaran yang sedang luka:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyembuh-asem-aseman/overclaim-1.webp"
              alt="Daun padi kembali hijau jegrik segar bebas karat merah setelah disemprot Bensu"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • SERAP INSTAN LEWAT DAUN 2 JAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daun Merah Karat Langsung Bangun Hijau Royo-Royo!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam amino L-isomer menembus jaringan stomata daun dalam 2 jam untuk menyuplai energi instan tanpa menunggu akar yang lemas.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyembuh-asem-aseman/overclaim-2.webp"
              alt="Akar serabut putih baru tumbuh gondrong menembus lumpur sawah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • CUCI PIRIT & LEDAKKAN AKAR PUTIH
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Netralisir Asam Lumpur & Tumbuhkan Akar Gondrong!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Humat bioaktif mengikat racun besi pirit di perakaran dan memicu tumbuhnya bulu akar serabut putih baru yang sehat.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyembuh-asem-aseman/overclaim-3.webp"
              alt="Rumpun padi sawah mekar rapat dengan 40 lebih anakan produktif"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • 40+ ANAKAN PRODUKTIF SEREMPAK
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Lipatgandakan Rumpun & Kejar Jadwal Panen Rekor!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Merangsang titik tumbuh basal di pangkal rumpun sehingga anakan produktif meletus serentak hingga 40+ batang per rumpun.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/penyembuh-asem-aseman/macro-proof.webp"
          alt="Foto makro akar serabut putih gondrong padi sawah sehabis semprot BENSU"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Hasil 4 Hari: Akar serabut putih baru gondrong menembus lumpur, rumpun mekar 40+ anakan kokoh!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span> di Sawah
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/penyembuh-asem-aseman/aplikasi-kebun.webp"
          alt="Petani menyemprot kabut nutrisi dingin BENSU di pematang sawah pagi hari"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 items-stretch gap-2.5 text-center">
        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">1</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Takaran</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Campur <strong>30–40 ml BENSU</strong> (2–3 tutup) per tangki 16L.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">2</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Aplikasi</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Semprot kabut halus ke daun <strong>pagi hari (06.00–09.00)</strong>.
          </p>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-emerald-100 bg-emerald-50/40 p-3">
          <span class="mx-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#14532D] text-[11px] font-bold text-white">3</span>
          <h3 class="mt-2 text-[12px] font-bold leading-tight text-slate-900">Interval</h3>
          <p class="mt-1 text-[11px] leading-snug text-slate-600">
            Ulangi selang <strong>4–5 hari sekali</strong> (cukup 2 kali aplikasi).
          </p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS & OVERCLAIM HARVEST GALLERY -->
    <section class="bg-slate-50/60 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Petani: <span class="hl-brush">Sawah Selamat & Panen Rekor</span>
      </h2>

      <div class="mt-5 space-y-5">
        <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
          <img
            src="/images/landing/penyembuh-asem-aseman/testi-1.webp"
            alt="Dokumentasi tanaman padi Pak Darsono pulih dan beranak lebat di Sragen"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Darsono, Sidoharjo, Sragen</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Tembus 42 Anakan</span>
            </div>
            <p class="mt-1.5 text-[12px] leading-snug text-slate-700 italic">
