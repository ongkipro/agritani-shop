---
/**
 * Native Landing Page: Paket Combo Cabai Sembuh Keriting Kuning & Berbuah Lebat: Bensu + Saratoga
 *
 * Clean, High-Contrast Direct-Response LP (Precision Visuals & Scannable Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Architecture Contract: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-combo-cabai-sembuh-lebat.css';

export const prerender = false;

const SLUG = 'paket-combo-cabai-sembuh-lebat';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/paket-combo-cabai-sembuh-lebat/hero-problem.webp';
---

<BaseLayout
  title={`Paket Combo Cabai Sembuh Keriting Kuning & Berbuah Lebat: Bensu + Saratoga - ${Astro.locals.tenant.name}`}
  description="Pulihkan tanaman cabai keriting kuning virus Gemini dan lebatkan bunga-buah cabai hingga 25+ kali petik dengan sinergi BENSU + SARATOGA."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-5">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white">
          SOLUSI CABAI KERITING KUNING & RONTOK
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[24px] font-bold leading-[1.18] tracking-tight text-slate-950">
          Pulihkan Cabai Keriting Kuning Jadi <span class="hl-brush">TUNAS HIJAU & BUAH LEBAT</span> Tembus 25+ Kali Petik!
        </h1>
        <p class="mx-auto mt-2.5 max-w-[400px] text-[14px] font-normal leading-snug text-slate-700">
          Jangan cabut pohon cabai yang macet! Hentikan keriting bule di pucuk dan lipat gandakan bunga jadi buah merah padat.
        </p>
      </div>

      <div class="mt-4">
        <div class="overflow-hidden bg-slate-950">
          <img
            src={heroImage}
            alt="Paket Combo Cabai Sembuh Keriting Kuning & Berbuah Lebat: Bensu + Saratoga"
            class="aspect-[16/9] w-full object-cover"
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="grid grid-cols-2 border-t border-slate-800 bg-slate-950 text-xs font-bold">
            <div class="border-r border-slate-800 bg-red-950/80 px-2.5 py-2 text-red-200">
              SEBELUM: Keriting Kuning Macet
            </div>
            <div class="bg-emerald-950/80 px-2.5 py-2 text-emerald-200">
              SESUDAH: Pucuk Pulih & Buah Lebat
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-4 text-xs font-semibold text-slate-700">
          <span>✓ Garansi 100% Asli</span>
          <span class="text-slate-300">•</span>
          <span>✓ Segel Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>✓ Bisa COD</span>
        </div>

        <!-- Scannable 4-Point Checklist + Primary CTA -->
        <div class="mx-5 mt-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Buka Pucuk Keriting & Mangkuk:</strong> Regenerasi sel pucuk baru yang membuka lebar, hijau gelap, dan sehat.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Imunitas Lapis Ganda Anti-Virus:</strong> Perkuat dinding sel daun dari serangan kutu kebul, thrips, dan Gemini.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Kunci Bunga Anti-Rontok:</strong> Ubah setiap titik cabang Y menjadi dompolan buah cabai rapat.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Buah Tebal, Panjang & Berbobot:</strong> Kulit cabai merah mengkilap, keras tahan simpan, timbangan berat.</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Paket Pemulih Cabai Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION -->
    <section class="bg-red-50/40 px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        2 Ancaman Utama <span class="hl-brush-red">Petani Cabai Gagal Panen</span>
      </h2>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/paket-combo-cabai-sembuh-lebat/gejala-1.webp"
              alt="Daun Keriting Kuning (Virus Gemini & Kutu Kebul)"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 1
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Daun Keriting Kuning (Virus Gemini & Kutu Kebul)</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Pucuk mengecil kaku seperti mangkuk, fotosintesis berhenti, dan tanaman kerdil tidak sanggup berbuah.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/paket-combo-cabai-sembuh-lebat/gejala-2.webp"
              alt="Bunga Gugur & Buah Kerdil Bengkok"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 2
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Bunga Gugur & Buah Kerdil Bengkok</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Tanaman yang stres penyakit menggugurkan bunga sehingga petikan habis hanya dalam 3–4 kali panen.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        Bukti Perubahan: <span class="hl-brush-red">Keriting & Macet</span> Jadi <span class="hl-brush">Pulih & Panen 25x Petik</span>
      </h2>

      <div class="-mx-5 mt-3.5 mb-4 overflow-hidden bg-slate-950">
        <img
          src="/images/landing/paket-combo-cabai-sembuh-lebat/overclaim-timeline.webp"
          alt="Tahapan pemulihan dan panen"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 border-t border-slate-800 bg-slate-950 px-2 py-2 text-center text-xs font-bold">
          <span class="text-amber-300">7 Hari: Tunas Baru Membuka</span>
          <span class="text-emerald-300">21 Hari: Bunga Rapat Terkunci</span>
          <span class="text-emerald-400">40 Hari: Buah Merah Merunduk</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
          <img
            src="/images/landing/paket-combo-cabai-sembuh-lebat/kondisi-rusak.webp"
            alt="Pucuk Kaku & Gugur"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
            Tanpa Perawatan
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-slate-900">Pucuk Kaku & Gugur</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-slate-600">
              Daun menguning keriting, bunga rontok, pohon mati muda.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40">
          <img
            src="/images/landing/paket-combo-cabai-sembuh-lebat/kondisi-pulih.webp"
            alt="Trubus Hijau & Lebat"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-xs font-bold text-white">
            BENSU + SARATOGA
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-emerald-950">Trubus Hijau & Lebat</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-emerald-900">
              Daun baru lebar mulus, buah merah berdompol sampai pucuk.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SHOWCASE & 3 CORE PILLARS -->
    <section class="bg-emerald-950 px-5 py-7 text-white">
      <div class="text-center">
        <span class="inline-block rounded-full bg-emerald-800 px-3 py-1 text-xs font-bold text-emerald-100">
          FORMULA BIOAKTIF RESMI
        </span>
        <h2 class="mx-auto mt-2 text-[20px] font-bold leading-[1.2] tracking-tight text-white">
          3 Keunggulan <span class="hl-brush">Formula Pemulih & Pelebat Cabai</span>
        </h2>
      </div>

      <!-- Full-Width 16:9 Precision Product Bottle Card -->
      <div class="mt-4 overflow-hidden rounded-xl border border-emerald-700 bg-emerald-900/60 shadow-sm">
        <img
          src="/images/landing/paket-combo-cabai-sembuh-lebat/bensu-hero.webp"
          alt="Sinergi BENSU + SARATOGA (Pemulih & Pelebat Cabai)"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3.5 text-center">
          <h3 class="text-[15px] font-bold text-white">Sinergi BENSU + SARATOGA (Pemulih & Pelebat Cabai)</h3>
          <p class="mt-0.5 text-xs font-normal text-emerald-200">
            Thailand & Japan Technology • Pulihkan Pucuk & Kunci Buah Lebat
          </p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Immune Cellactivator (Sulfur & Molibdenum)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Memutus stres virus kuning dan memicu tumbuhnya tunas baru yang sehat.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">18 Asam Amino Pengunci Bunga</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Menghentikan rontok tangkai bunga dan mempercepat pembentukan pentil buah.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Kalium-Silika Pengisi Daging Buah</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Membuat kulit cabai tebal mengkilap, tahan patek, dan berat di timbangan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. COMPACT SOP FIELD GUIDE -->
    <section class="bg-slate-50 px-5 py-7">
      <h2 class="text-center text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        3 Langkah Mudah <span class="hl-brush">Dosis & Aplikasi</span>
      </h2>

      <div class="mt-4 space-y-2.5">
        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Fase Pemulihan Pucuk</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Semprot & kocor 3 ml BENSU per liter air tiap 5–7 hari sekali.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Fase Pembungaan & Buah</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Tambahkan 2–3 ml SARATOGA per liter air untuk mengunci bunga & bobot.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Perawatan Rutin Panen</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Semprot pagi hari tiap minggu agar petikan tembus 25+ kali panen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FARMER TESTIMONIALS -->
    <section class="bg-white px-5 py-7">
      <div class="text-center">
        <h2 class="mx-auto text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Hasil Nyata di Lapangan
        </h2>
      </div>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-cabai-sembuh-lebat/testi-1.webp"
            alt="Mas Wahyu — Magelang, Jateng"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Mas Wahyu — Magelang, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Sembuh Dari Kuning</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "4.000 batang cabai rawit sudah kuning keriting mau dicabut. Rutin semprot BENSU 3 kali, trubus baru keluar hijau mulus dan sekarang sekali petik 3.5 kuintal!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-cabai-sembuh-lebat/testi-2.webp"
            alt="Pak Sutrisno — Kediri, Jatim"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Sutrisno — Kediri, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Panen Tembus 24x Petik</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Biasanya petikan ke-8 pohon sudah habis. Pakai kombinasi BENSU & SARATOGA, pucuk naik terus dan buah merah padat sampai petikan ke-24."
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-cabai-sembuh-lebat/testi-3.webp"
            alt="Kang Deden — Garut, Jabar"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Kang Deden — Garut, Jabar</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Bobot Karung Naik</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Buah cabai jadi panjang-panjang, kulitnya tebal mengkilap. Satu karung yang biasanya 28 kg sekarang tembus 33 kg padat!"
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION -->
    <section id="checkout-form" class="scroll-mt-8 border-t border-slate-100 bg-white py-8">
      <div class="px-5 pb-5 text-center">
        <h2 class="mx-auto max-w-[360px] text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Pemulih Cabai BENSU</span>
        </h2>
        <p class="mx-auto mt-1.5 max-w-[360px] text-[13px] font-normal text-slate-600">
          Pilih kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}). Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={preferredVariant?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <StickyLandingCtaBar
    ctaText="Pesan Paket Cabai — Bisa COD"
    subText="Garansi Original Segel Resmi • Bayar Saat Barang Sampai"
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
