---
/**
 * Native Landing Page: Kojien — Perisai Sel Baja Kebal Jamur & Virus (KOJIEN)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: kojien (ID: 99118)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/perisai-kebal-jamur.css';

export const prerender = false;

const SLUG = 'perisai-kebal-jamur';

const product =
  (await getStorefrontProduct(Astro.locals, 'kojien')) ??
  (await getStorefrontProduct(Astro.locals, '99118'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/perisai-kebal-jamur/hero-problem.webp';
---

<BaseLayout
  title={`Perisai Sel Baja Kebal Jamur & Virus Tanaman: Garansi Daun Kaku Jegrik | ${Astro.locals.tenant.name}`}
  description="Lapisi sel daun dengan perisai Nano-Silika KOJIEN. Tanaman dijamin kebal Patek Antraknosa, Bulai Jagung, Layu Fusarium, Moler & Keriting Kutu Kebul dalam 7 hari."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">STOP BOROS FUNGISIDA & INSEKTISIDA TANPA HASIL!</span>
          Lapisi Sel Daun dengan Perisai Nano-Silika KOJIEN: Tanaman Dijamin <span class="hl-brush">KEBAL PATEK ANTRAKNOSA, BULAI JAGUNG, LAYU FUSARIUM & KERITING KUTU KEBUL</span> Dalam 7 Hari!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup semprot kabut <strong class="text-slate-950 font-bold">KOJIEN</strong>, dinding sel daun & kulit buah terlapis kristal Bio-Silika OSA sekeras kaca hingga 99% jarum spora jamur patek, bulai putih, moler, kresek & tusukan kutu kebul terpental patah!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi kebun cabai terlindungi dari serangan jamur dan cuaca lembap berkat formula Kojien"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Dinding sel menebal sekeras kaca, spora jamur terpental & daun tegak jegrik dalam 3–7 hari!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Nano-Silika OSA + Bio-Sulfur</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Segel Hologram & Shieldtag Resmi</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Bentuk perisai kristal Nano-Silika sekeras kaca yang mematahkan jarum spora Patek & Bulai</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Keringkan luka basah jamur Moler, Layu Fusarium & Kresek Padi dalam 24 jam</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tegakkan daun jegrik kaku sehingga mulut Thrips & Kutu Kebul vektor Gemini gagal menusuk</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tidak luntur disapu hujan deras & pangkas belanja racun fungisida/insektisida hingga 50%</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Paket Perisai Jamur KOJIEN — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Biang Kerok Tanaman <span class="hl-brush-red">Lonyot, Bulai & Patek</span> di Musim Hujan
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Saat kelembapan tinggi dan daun lembek berair, spora jamur dan hama penusuk menembus jaringan tanaman dalam hitungan jam:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/perisai-kebal-jamur/gejala-1.webp"
              alt="Serangan jamur patek antraknosa dan busuk daun basah pada tanaman saat musim hujan"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Kutikula Daun Tipis & Lembek Berair
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Spora Patek, Bulai & Moler Mudah Menembus Sel</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Dinding sel tanaman yang tipis tanpa perisai silika membuat jarum infeksi jamur langsung menembus jaringan daun dan buah setiap kali habis diguyur hujan malam.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/perisai-kebal-jamur/gejala-2.webp"
              alt="Daun tanaman menggenangkan air embun malam sehingga jamur menyebar cepat sekebun"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Fungisida Kimia Cepat Luntur & Jamur Kebal
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Menular Sekebun Walau Sudah Disemprot Obat Mahal</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Daun yang terkulai lembek menahan air hujan dan embun malam, menjadi sarang perkembangbiakan spora jamur baru dan kutu kebul pembawa virus kuning.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Daun Lonyot</span> Jadi <span class="hl-brush">Jegrik Berlapis Baja</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/perisai-kebal-jamur/overclaim-timeline.webp"
          alt="Tahapan pembentukan perisai sel baja Bio-Silika Kojien dari luka jamur mengering hingga daun jegrik kaku"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Bercak Basah</span>
          <span class="text-amber-300">24 Jam: Luka Kering</span>
          <span class="text-emerald-400">Hari 7: Jegrik Kebal</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/perisai-kebal-jamur/kondisi-rusak.webp"
            alt="Kondisi daun dan buah busuk lonyot terserang jamur tanpa Kojien"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa KOJIEN
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Lonyot & Bulai</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Spora jamur tembus pori daun, buah busuk patek berjatuhan.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/perisai-kebal-jamur/kondisi-pulih.webp"
            alt="Kondisi tanaman sehat daun kaku jegrik berlapis silika sehabis semprot Kojien"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai KOJIEN
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Daun Kaku & Mulus</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Kutikula sekeras kaca mementalkan spora jamur dan tusukan hama.
            </p>
          </div>
        </div>
      </div>

      <!-- HEAD-TO-HEAD COMPETITOR-KILLER MATRIX -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-50/80 shadow-sm">
        <div class="bg-slate-950 px-4 py-3 text-center">
          <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            KENAPA OBAT JAMUR & HAMA BIASA JEBOL TERUS?
          </span>
          <h3 class="mt-1 text-[15px] font-bold leading-snug text-white">
            Fungisida/Insektisida Kimia Biasa vs Perisai Kaca Nano-Silika KOJIEN
          </h3>
        </div>

        <div class="divide-y divide-slate-200 text-[12px]">
          <div class="grid grid-cols-2 bg-slate-100 font-bold text-slate-900">
            <div class="border-r border-slate-200 p-2.5 text-red-700">
              ✗ Fungisida Kontak Tunggal & Insektisida Kimia
            </div>
            <div class="p-2.5 text-emerald-900">
              ✓ KOJIEN Perisai Kaca Nano-Silika + Ca-Kalium
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Luntur Disapu Hujan 1 Jam:</strong>
              Fungisida kontak hanya menempel di luar; begitu turun hujan langsung terbilas dan spora patek/bulai masuk lagi.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Menyatu Jadi Dinding Kristal Kaca:</strong>
              Ortho-Silicic Acid (OSA) diserap ke epidermis membentuk lapisan kaca permanen yang tidak luntur hujan!
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Daun Tetap Lunak & Lembek:</strong>
              Tidak memperkuat fisik sel daun sehingga jarum spora Bulai Jagung & Moler tetap mudah menembus.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Daun Jegrik Kaku & Keringkan Luka:</strong>
              Mengeraskan dinding sel hingga jarum spora jamur patah + Bio-Sulfur mengeringkan bercak basah dalam 24 jam.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Thrips & Kutu Kebul Cepat Kebal:</strong>
              Semprot racun kimia tiap 3 hari bikin hama resisten dan pucuk cabai yang rusak tetap keriting kaku.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Patahkan Tusukan Mulut Hama:</strong>
              Permukaan daun sekeras kaca membuat mulut Thrips/Kutu Kebul tumpul & pucuk baru mekar mulus dalam 7 hari.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Menguras Modal Jutaan Rupiah:</strong>
              Harus beli banyak merek fungisida dan abamektin mahal sepanjang musim hujan.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Pangkas Biaya Obat Kimia 50%:</strong>
              1 botol KOJIEN 1 Liter membentengi Cabai, Jagung, Bawang & Padi sekaligus sampai panen raya!
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/perisai-kebal-jamur/kojien-hero.webp"
          alt="Botol resmi KOJIEN Bio-Silika dan Sulfur Aktif di lahan tanaman sehat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram + Shieldtag Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi KOJIEN Segel Hologram dan Shieldtag Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <span class="inline-block rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">
            GARANSI 100% ORIGINAL • SHIELDTAG RESMI
          </span>
          <p class="mt-1 text-[12px] font-bold text-emerald-950">KOJIEN Asli Segel Hologram & Kode Verifikasi Shieldtag</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Waspada cairan silika palsu/oplosan Rp 30rb–50rb di marketplace! KOJIEN resmi bersegel hologram & Shieldtag anti-pemalsuan (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Perisai Sel Baja KOJIEN</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Menggabungkan pengering luka jamur instan dengan benteng fisik kristal Nano-Silika:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/perisai-kebal-jamur/overclaim-1.webp"
              alt="Lapisan kristal Bio-Silika OSA menebalkan kutikula daun sehingga menjadi kaku jegrik"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • PERISAI KRISTAL NANO-SILIKA
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Lapisi Kutikula Daun & Kulit Buah Sekeras Kaca!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Ortho-Silicic Acid (OSA) mengendap di jaringan epidermis membentuk perisai mekanis yang gagal ditembus jarum infeksi spora Patek, Bulai & Moler.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/perisai-kebal-jamur/overclaim-2.webp"
              alt="Bercak luka basah jamur mengering dan daun baru tumbuh tegak sehat"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • KERINGKAN LUKA BASAH 24 JAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Stop Penularan Patek, Moler, Bulai & Kresek!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Bio-Sulfur aktif melumpuhkan miselium jamur di permukaan tanaman dan mengeringkan bercak basah agar tidak menular ke pohon sebelah.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/perisai-kebal-jamur/overclaim-3.webp"
              alt="Daun tanaman berdiri kaku jegrik menolak genangan air hujan dan hama penusuk"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • DAUN JEGRIK ANTI-VEKTOR VIRUS
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daun Kaku Tegak, Kutu Kebul & Thrips Gagal Menusuk!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Daun yang tebal dan kaku membuat mulut pengisap kutu kebul/thrips tumpul sehingga tanaman aman dari penularan virus kuning gemini.
          </p>
        </div>
