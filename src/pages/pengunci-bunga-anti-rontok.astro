---
/**
 * Native Landing Page: Pengunci Bunga & Pencegah Rontok Pentil Buah (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/pengunci-bunga-anti-rontok.css';

export const prerender = false;

const SLUG = 'pengunci-bunga-anti-rontok';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/pengunci-bunga-anti-rontok/hero-problem.webp';
---

<BaseLayout
  title={`Solusi Bunga & Pentil Buah Rontok: Kunci 98% Jadi Buah Bernas | ${Astro.locals.tenant.name}`}
  description="Hentikan gugur bunga massal dan pentil buah rontok akibat cuaca ekstrem dalam 48 jam. Formula serum Jepang tanpa bau amis mengunci 98% bunga cabai, tomat, dan buah jadi bernas."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">STOP BUNGA & PENTIL BUAH GUGUR DI ATAS MULSA!</span>
          Kunci Cincin Tangkai dalam 48 Jam: Dijamin <span class="hl-brush">98% BUNGA MENGIKAT JADI BUAH BERNAS</span> & Panen Melimpah 2X Lipat Meski Cuaca Ekstrem!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup 1 kali semprot kabut <strong class="text-slate-950 font-bold">SARATOGA</strong> (Teknologi Jepang Tanpa Bau Amis), hormon etilen perontok langsung terblokir, cincin tangkai bunga mengunci kekar bebas serangan lalat buah, dan setiap ketukan cabang penuh buah padat Grade A!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi bunga cabai dan tomat lebat mengunci kuat di tangkai tidak rontok setelah aplikasi serum Saratoga"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Tangkai bunga mengunci tebal dalam 48 jam, 98% bunga sukses mengikat jadi buah super!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Japanese L-Amino Tanpa Bau Amis</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Segel Hologram & Shieldtag Resmi</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Blokir hormon etilen perontok & las kuat cincin tangkai bunga dalam 48 jam</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Kunci 98% bunga mekar jadi pentil buah bernas meski siang terik & malam hujan</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>100% tanpa bau amis bangkai — tidak mengundang lalat buah penyengat pentil cabai</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tebalkan dinding buah liat mengkilap kebal patek & dongkrak bobot panen 2x lipat</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Paket Pengunci Bunga SARATOGA — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Biang Kerok Bunga & Pentil <span class="hl-brush-red">Rontok Massal Semalam</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Setiap bunga yang jatuh di atas mulsa adalah potongan langsung dari uang hasil panen Anda:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pengunci-bunga-anti-rontok/gejala-1.webp"
              alt="Tangkai bunga cabai menguning pucat dan rontok berserakan di atas mulsa"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Lonjakan Hormon Etilen Pemutus Tangkai
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Cincin Pangkal Tangkai Menguning & Patah Sendiri</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Siang panas terik lalu disiram hujan malam memicu tanaman mengeluarkan sinyal stres (hormon etilen) yang memutus cincin tangkai bunga dalam semalam.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pengunci-bunga-anti-rontok/gejala-2.webp"
              alt="Pentil buah muda layu keriput gagal dibuahi dan gugur saat tersentuh"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Defisiensi Kalsium-Boron & Mabuk Nitrogen
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Pentil Buah Keriput & Ketukan Cabang Kosong Ompong</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Tanpa suplai Kalsium-Boron Nano instan ke mahkota bunga, serbuk sari menjadi mandul dan pentil buah muda langsung menguning gugur.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Rontok Parah</span> Jadi <span class="hl-brush">Full Pentil Buah</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/pengunci-bunga-anti-rontok/overclaim-timeline.webp"
          alt="Tahapan penguncian tangkai bunga cabai dan tomat dari rontok hingga jadi pentil buah bernas dengan Saratoga"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Jam 0: Rontok</span>
          <span class="text-amber-300">48 Jam: Tangkai Kekar</span>
          <span class="text-emerald-400">Hari 5: 98% Jadi Pentil</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/pengunci-bunga-anti-rontok/kondisi-rusak.webp"
            alt="Kondisi bunga cabai menguning rontok tanpa serum Saratoga"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Gugur di Atas Mulsa</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Cabang ompong tanpa buah, hasil petikan anjlok drastis.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/pengunci-bunga-anti-rontok/kondisi-pulih.webp"
            alt="Kondisi tangkai bunga hijau kekar dan pentil buah lebat berkat Saratoga"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Hasil 48 Jam
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">98% Mengikat Buah</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Setiap ketukan cabang mengunci pentil buah hijau mengkilap.
            </p>
          </div>
        </div>
      </div>

      <!-- HEAD-TO-HEAD COMPETITOR-KILLER MATRIX -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-50/80 shadow-sm">
        <div class="bg-slate-950 px-4 py-3 text-center">
          <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            AWAS SALAH PILIH PUPUK BUAH!
          </span>
          <h3 class="mt-1 text-[15px] font-bold leading-snug text-white">
            Mengapa Pupuk Bubuk & Asam Amino Ikan Biasa Gagal vs SARATOGA?
          </h3>
        </div>

        <div class="divide-y divide-slate-200 text-[12px]">
          <div class="grid grid-cols-2 bg-slate-100 font-bold text-slate-900">
            <div class="border-r border-slate-200 p-2.5 text-red-700">
              ✗ Pupuk Bubuk MKP/Gandasil & Amino Ikan Amis
            </div>
            <div class="p-2.5 text-emerald-900">
              ✓ SARATOGA Japanese L-Amino Odorless + Ca-Boron
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Bau Amis Undang Lalat Buah:</strong>
              Asam amino ikan kompetitor berbau bangkai menyengat yang justru memanggil lalat buah menyuntik busuk pentil cabai!
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">100% Tanpa Bau Amis (Odorless):</strong>
              Ekstraksi L-Amino Jepang murni bebas bau amis sehingga kebun aman dari serbuan lalat buah.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Lambat Diserap Saat Cuaca Ekstrem:</strong>
              Pupuk bubuk biasa butuh fotosintesis penuh; saat mendung/hujan malam bunga keburu rontok semua.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Blokir Etilen dalam 48 Jam:</strong>
              L-Prolin & Ca-Boron Nano langsung menembus stomata dalam 2 jam dan mengelas cincin tangkai bunga.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Endapan Bubuk Menyumbat Spuyer:</strong>
              Menyisakan kerak putih di daun dan tidak punya pelindung kulit buah dari jamur patek.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Plus Bio-Chitosan Anti-Patek:</strong>
              Larut 100% sempurna dan menebalkan kutikula kulit buah cabai agar lolos sortir Grade A.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Bunga Mekar Tapi Mandul:</strong>
              Serbuk sari lemah saat kelembapan tinggi sehingga bakal buah menguning keriput.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">98% Sukses Jadi Buah Bernas:</strong>
              Menyuburkan putik & serbuk sari sehingga setiap ruas cabang penuh dompolan buah padat!
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/pengunci-bunga-anti-rontok/saratoga-hero.webp"
          alt="Botol resmi Serum Tanaman Premium SARATOGA di kebun cabai berbuah lebat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram + Shieldtag Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Segel Hologram dan Shieldtag Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <span class="inline-block rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">
            GARANSI 100% ORIGINAL • SHIELDTAG RESMI
          </span>
          <p class="mt-1 text-[12px] font-bold text-emerald-950">SARATOGA Asli Segel Hologram & Kode Verifikasi Shieldtag</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Jangan pertaruhkan panen Anda dengan pupuk cair palsu/oplosan Rp 30rb–50rb di marketplace! SARATOGA resmi dilengkapi segel hologram & Shieldtag anti-palsu (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Pengunci Bunga SARATOGA</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Menghentikan rontok bunga dari sumber hormonnya dan mengawal pentil jadi buah bernas:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/pengunci-bunga-anti-rontok/overclaim-1.webp"
              alt="Cincin tangkai bunga cabai dan tomat menebal hijau ulet tahan guncangan cuaca"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • REDAM ETILEN 48 JAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Matikan Sinyal Rontok & Las Kuat Cincin Tangkai!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam amino L-Prolin meredam kejut suhu panas-hujan sementara Kalsium-Boron Nano mempertebal pangkal tangkai agar tidak mudah patah.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/pengunci-bunga-anti-rontok/overclaim-2.webp"
              alt="Penyerbukan bunga cabai dan tomat sempurna berubah menjadi pentil buah hijau"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • PENYERBUKAN SEMPURNA 98%
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                98% Bunga Mekar Langsung Mengikat Jadi Pentil!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Menyuburkan serbuk sari dan mempercepat pembuahan putik sehingga bakal buah langsung membengkak sehat tanpa mengundang lalat buah.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/pengunci-bunga-anti-rontok/overclaim-3.webp"
              alt="Dompolan buah tomat dan cabai penuh lebat di setiap ketukan cabang"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • FULL BUAH SETANDAN 2X LIPAT
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Setiap Ketukan Cabang Penuh Buah Bernas Berbobot!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mendorong pengisian daging buah yang padat dan kulit tebal mengkilap tahan patek tanpa menguras tenaga pohon untuk berbunga di atasnya.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
