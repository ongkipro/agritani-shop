---
/**
 * Native Landing Page: Paket Bawang Merah Anti Moler & Pengisi Umbi Jumbo: Bensu + Saratoga
 *
 * Clean, High-Contrast Direct-Response LP (Precision Visuals & Scannable Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Architecture Contract: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-combo-bawang-anti-moler-umbi-jumbo.css';

export const prerender = false;

const SLUG = 'paket-combo-bawang-anti-moler-umbi-jumbo';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/hero-problem.webp';
---

<BaseLayout
  title={`Paket Bawang Merah Anti Moler & Pengisi Umbi Jumbo: Bensu + Saratoga - ${Astro.locals.tenant.name}`}
  description="Hentikan serangan layu Fusarium (moler/inul) pada bawang merah dan pompa pengisian umbi super jumbo merah menyala dengan BENSU + SARATOGA."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-5">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white">
          PERISAI BAWANG ANTI-MOLER & UMBI JUMBO
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[24px] font-bold leading-[1.18] tracking-tight text-slate-950">
          Stop Layu Moler Bawang Merah & Cetak <span class="hl-brush">UMBI JUMBO MERAH PADAT</span> Timbangan Berbobot!
        </h1>
        <p class="mx-auto mt-2.5 max-w-[400px] text-[14px] font-normal leading-snug text-slate-700">
          Kunci daun bawang tetap tegak hijau di musim hujan, matikan jamur Fusarium di akar, dan pompa seluruh nutrisi ke umbi.
        </p>
      </div>

      <div class="mt-4">
        <div class="overflow-hidden bg-slate-950">
          <img
            src={heroImage}
            alt="Paket Bawang Merah Anti Moler & Pengisi Umbi Jumbo: Bensu + Saratoga"
            class="aspect-[16/9] w-full object-cover"
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="grid grid-cols-2 border-t border-slate-800 bg-slate-950 text-xs font-bold">
            <div class="border-r border-slate-800 bg-red-950/80 px-2.5 py-2 text-red-200">
              SEBELUM: Moler Melintir Busuk
            </div>
            <div class="bg-emerald-950/80 px-2.5 py-2 text-emerald-200">
              SESUDAH: Daun Tegak & Umbi Jumbo
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-4 text-xs font-semibold text-slate-700">
          <span>✓ Garansi 100% Asli</span>
          <span class="text-slate-300">•</span>
          <span>✓ Segel Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>✓ Bisa COD</span>
        </div>

        <!-- Scannable 4-Point Checklist + Primary CTA -->
        <div class="mx-5 mt-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Hentikan Penularan Moler / Inul:</strong> Blokir jamur Fusarium di perakaran dalam 3–5 hari aplikasi.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Daun Pipa Tegak & Tebal Berlilin:</strong> Tahan guyuran hujan malam dan embun tepung tanpa pucuk kuning.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Perbanyak Anakan & Belah Siung:</strong> Satu rumpun memecah 12–18 siung bawang ukuran seragam.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Umbi Padat Merah Menyala:</strong> Kulit umbi kering mengkilap, tidak gampang kempes saat dijemur.</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Paket Bawang Anti-Moler Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION -->
    <section class="bg-red-50/40 px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        2 Musuh Utama <span class="hl-brush-red">Petani Bawang Merah Merugi</span>
      </h2>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/gejala-1.webp"
              alt="Serangan Moler (Layu Fusarium) Menular Cepat"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 1
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Serangan Moler (Layu Fusarium) Menular Cepat</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Daun menguning melintir dari pangkal dan leher umbi membusuk berair hingga merembet satu petak sawah.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/gejala-2.webp"
              alt="Subur Daun Tapi Umbi Kecil Kempes"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 2
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Subur Daun Tapi Umbi Kecil Kempes</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Nutrisi terjebak di daun (ngacung) sehingga saat dicabut umbi kecil-kecil dan menyusut drastis ketika kering.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        Bukti Perubahan: <span class="hl-brush-red">Moler & Kempes</span> Jadi <span class="hl-brush">Umbi Jumbo Merah Padat</span>
      </h2>

      <div class="-mx-5 mt-3.5 mb-4 overflow-hidden bg-slate-950">
        <img
          src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/overclaim-timeline.webp"
          alt="Tahapan pemulihan dan panen"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 border-t border-slate-800 bg-slate-950 px-2 py-2 text-center text-xs font-bold">
          <span class="text-amber-300">5 Hari: Akar Bersih & Daun Tegak</span>
          <span class="text-emerald-300">25 Hari: Rumpun Pecah 15+ Siung</span>
          <span class="text-emerald-400">55 Hari: Umbi Jumbo Merah Padat</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
          <img
            src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/kondisi-rusak.webp"
            alt="Daun Melintir & Busuk"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
            Tanpa Perisai
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-slate-900">Daun Melintir & Busuk</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-slate-600">
              Akar busuk berair, daun rebah menguning, umbi gagal terbentuk.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40">
          <img
            src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/kondisi-pulih.webp"
            alt="Umbi Penuh & Berbobot"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-xs font-bold text-white">
            BENSU + SARATOGA
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-emerald-950">Umbi Penuh & Berbobot</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-emerald-900">
              Daun tegak kaku, siung besar merah menyala, susut jemur rendah.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SHOWCASE & 3 CORE PILLARS -->
    <section class="bg-emerald-950 px-5 py-7 text-white">
      <div class="text-center">
        <span class="inline-block rounded-full bg-emerald-800 px-3 py-1 text-xs font-bold text-emerald-100">
          FORMULA BIOAKTIF RESMI
        </span>
        <h2 class="mx-auto mt-2 text-[20px] font-bold leading-[1.2] tracking-tight text-white">
          3 Keunggulan <span class="hl-brush">Sinergi Pelindung & Pembesar Bawang</span>
        </h2>
      </div>

      <!-- Full-Width 16:9 Precision Product Bottle Card -->
      <div class="mt-4 overflow-hidden rounded-xl border border-emerald-700 bg-emerald-900/60 shadow-sm">
        <img
          src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/bensu-hero.webp"
          alt="Paket Bawang Merah BENSU + SARATOGA"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3.5 text-center">
          <h3 class="text-[15px] font-bold text-white">Paket Bawang Merah BENSU + SARATOGA</h3>
          <p class="mt-0.5 text-xs font-normal text-emerald-200">
            Anti-Moler Fusarium • Pengisi Umbi Bawang Super Jumbo
          </p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Bio-Fungisida Seluler Anti-Fusarium</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Menetralkan spora jamur tular tanah penyebab moler dan busuk pangkal.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Sulfur & Molibdenum Penguat Daun Pipa</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Menebalkan dinding daun bawang agar tegak kaku dan warna merah umbi tajam.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Kalium-Amino Pemompa Umbi (Bulbing)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Memindahkan seluruh fotosintat dari daun langsung ke pembesaran siung.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. COMPACT SOP FIELD GUIDE -->
    <section class="bg-slate-50 px-5 py-7">
      <h2 class="text-center text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        3 Langkah Mudah <span class="hl-brush">Dosis & Aplikasi</span>
      </h2>

      <div class="mt-4 space-y-2.5">
        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Fase Vegetatif (10–25 HST)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Semprot 3 ml BENSU per liter air tiap 5 hari agar daun tegak bebas moler.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Fase Pembentukan Umbi (28–45 HST)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Padukan BENSU + SARATOGA (3 ml/liter) untuk memompa ukuran siung.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Fase Pemadatan Akhir (45–55 HST)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Semprot SARATOGA agar umbi padat keras dan merah mengkilap.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FARMER TESTIMONIALS -->
    <section class="bg-white px-5 py-7">
      <div class="text-center">
        <h2 class="mx-auto text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Hasil Nyata di Lapangan
        </h2>
      </div>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/testi-1.webp"
            alt="Pak H. Tarkim — Brebes, Jateng"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H. Tarkim — Brebes, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Moler Langsung Berhenti</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Umur 22 hari kena hujan terus mulai muncul inul melintir. Langsung semprot BENSU 2 kali, moler berhenti total dan daun tegak kaku kembali!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/testi-2.webp"
            alt="Masプリ — Nganjuk, Jatim"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Masプリ — Nganjuk, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Umbi Sebesar Bola Pingpong</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Biasanya bibit 1 kuintal panennya cuma 1 ton basah. Pakai BENSU + SARATOGA tembus 1.4 ton, umbinya gede-gede merah menyala."
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-bawang-anti-moler-umbi-jumbo/testi-3.webp"
            alt="Pak Slamet — Demak, Jateng"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Slamet — Demak, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Tahan Susut Jemur</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Tengkulak rebutan karena umbinya padat keras, waktu dijemur kering susutnya sangat sedikit dan warnanya merah mengkilap."
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION -->
    <section id="checkout-form" class="scroll-mt-8 border-t border-slate-100 bg-white py-8">
      <div class="px-5 pb-5 text-center">
        <h2 class="mx-auto max-w-[360px] text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Paket Bawang BENSU Original</span>
        </h2>
        <p class="mx-auto mt-1.5 max-w-[360px] text-[13px] font-normal text-slate-600">
          Pilih kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}). Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={preferredVariant?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <StickyLandingCtaBar
    ctaText="Pesan Paket Bawang — Bisa COD"
    subText="Garansi Asli Segel Barcode • Bayar Saat Barang Sampai"
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
