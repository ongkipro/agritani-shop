---
/**
 * Native Landing Page #3 (NEW): Pelindung Patek Cabai, Anti-Busuk Pantat Tomat & Pembobot Buah 2X (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/pelindung-patek-busuk-pantat-pembobot-buah-saratoga.css';

export const prerender = false;

const SLUG = 'pelindung-patek-busuk-pantat-pembobot-buah-saratoga';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const trialVariant = product.variants.find((v) => /250\s*ml/i.test(v.label));
const oneLiterVariant = product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label));
const twoLiterVariant = product.variants.find((v) => /2\s*liter|\b2\s*l\b/i.test(v.label));
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/hero-problem.webp';
---

<BaseLayout
  title={`Benteng Kulit Baja Anti-Patek Cabai, Anti-Busuk Pantat Tomat & Pembobot 2X: SARATOGA - ${Astro.locals.tenant.name}`}
  description="Stop sakitnya panen ditolak bakul gara-gara cabai lonyot patek, tomat busuk pantat hitam, dan buah enteng kopong! Tebalkan kulit buah sekeras perisai baja & dongkrak bobot timbangan 2X lipat dengan SARATOGA."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Ultra-Clean, Brutal Overclaim, Fast Scan) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-[11px] font-bold tracking-wide text-white shadow-sm">
          STOP PANEN DITOLAK BAKUL GARA-GARA PATEK & BUAH KOPONG!
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[28px] font-bold leading-[1.14] tracking-tight text-slate-950">
          Bentengi Kulit Buah <span class="hl-brush-red">Kebal Patek & Busuk Pantat</span> + Pompa <span class="hl-brush">BOBOT TIMBANGAN 2X!</span>
        </h1>
        <p class="mx-auto mt-2.5 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Jangan cuma semprot fungisida luar! <strong class="text-slate-950 font-bold">SARATOGA Serum Jepang</strong> menebalkan dinding sel kulit cabai & tomat agar air hujan & jamur patek gagal tembus, sekaligus mengisi daging buah padat berbobot Grade A!
        </p>
      </div>

      <div class="mt-4">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan cabai lonyot patek dan tomat busuk pantat hitam vs panen cabai dan tomat mulus tebal mengkilap berbobot berat dengan Saratoga"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/90 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#4ADE80]">
              PERISAI KULIT BAJA: 0% Patek & Busuk Pantat • +6 Kg/Karung • 98% Lolos Grade A!
            </p>
          </div>
        </div>

        <!-- Clean 3-Chip Brutal Value Strip -->
        <div class="mx-4 mt-3.5 grid grid-cols-3 gap-2 text-center">
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">Kulit Baja</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Kebal Jamur Patek</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">0% Busuk</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Stop Busuk Pantat</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">+6 Kg/Sak</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Daging Padat 2X</p>
          </div>
        </div>

        <div class="mx-4 mt-3.5 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Tebalkan Kutikula Kulit Buah</strong> — spora jamur Patek (Antraknosa) & air hujan terpeleset jatuh</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Hentikan Busuk Pantat Tomat</strong> — suplai Boron-Kalium-Amino kilat cegah ujung buah menghitam</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Isi Daging Buah Padat Berbobot</strong> — 1 karung cabai/tomat lebih berat 5–6 kg di timbangan bakul</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>100% Tanpa Bau Amis</strong> — aman disemprot jelang panen tanpa memancing lalat buah</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[48px] w-full items-center justify-center rounded-xl bg-[#14532D] px-4 py-3 text-center text-[14px] font-bold text-white shadow-md transition-colors hover:bg-[#166534]"
          >
            BENTENGI BUAH & DONGKRAK BOBOT (MULAI {formatIdr(trialVariant?.price ?? 75000)}) →
          </a>
          <p class="mt-2 text-center text-[11px] font-semibold text-emerald-950">
            Tersedia Kemasan Coba 250ml ({formatIdr(trialVariant?.price ?? 75000)}) & Paket Laris 500ml ({formatIdr(preferredVariant?.price ?? 135000)}) — Bisa COD!
          </p>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (Luka Ditolak Bakul Saat Harga Tinggi) -->
    <section class="bg-red-50/40 px-5 py-7">
      <div class="text-center mb-4">
        <span class="inline-block rounded bg-red-100 px-2.5 py-0.5 text-[10px] font-bold text-red-800">
          SAKITNYA SUDAH SIAP PETIK MALAH DITOLAK PENEBAS!
        </span>
        <h2 class="mt-1 text-[24px] font-bold leading-tight tracking-tight text-slate-950">
          2 Kerugian Menyakitkan <span class="hl-brush-red">Saat Musim Panen Tiba</span>
        </h2>
      </div>

      <div class="space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/gejala-1.webp"
              alt="Buah cabai busuk lonyot patek antraknosa dan tomat busuk pantat hitam cekung habis hujan"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent p-3">
              <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
                LUKA 1 • CABAI LONYOT PATEK & TOMAT BUSUK PANTAT HITAM
              </span>
              <h3 class="mt-1 text-[14px] font-bold text-white leading-tight">
                Sudah Habis Fungisida Mahal, Begitu Hujan Tetap Lonyot & Dibuang ke Parit!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-600 leading-snug">
            Fungisida hanya di luar; jika dinding sel buah tipis & kurang nutrisi penguat kulit, jamur patek tetap tembus.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/gejala-2.webp"
              alt="Buah cabai dan tomat kopong enteng berair dan busuk tersengat lalat buah sehingga harga dihargai murah oleh bakul"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent p-3">
              <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
                LUKA 2 • BUAH KOPONG ENTENG & HARGA DIPOTONG 50% OLEH BAKUL
              </span>
              <h3 class="mt-1 text-[14px] font-bold text-white leading-tight">
                Karung Penuh Tapi Timbangan Enteng & Cepat Keriput Saat Dikirim!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-600 leading-snug">
            ZPT pemacu biasa bikin buah cepat besar tapi berongga air (kopong), gampang pecah, dan ringan saat ditimbang.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950">
        Transformasi Panen: <span class="hl-brush-red">Lonyot & Kopong</span> Jadi <span class="hl-brush">Grade A Padat</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-4 relative bg-slate-950">
        <img
          src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/overclaim-timeline.webp"
          alt="Tahapan penguatan kulit buah dan pengisian bobot daging buah dengan Saratoga"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Rawan Patek</span>
          <span class="text-amber-300">Hari 3: Kulit Menebal</span>
          <span class="text-emerald-400">Panen: Padat +6 Kg/Sak</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-red-200 bg-red-50/30 shadow-sm">
          <img
            src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/kondisi-rusak.webp"
            alt="Buah cabai dan tomat tanpa Saratoga lonyot patek dan kopong ringan"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="p-2.5 text-center">
            <h3 class="text-[12px] font-bold text-red-950">Ditolak Penebas</h3>
            <p class="mt-0.5 text-[11px] text-slate-600">Lonyot patek & karung enteng</p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-300 bg-emerald-50/50 shadow-sm">
          <img
            src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/kondisi-pulih.webp"
            alt="Buah cabai dan tomat pakai Saratoga kulit tebal mengkilap padat berbobot Grade A"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="p-2.5 text-center">
            <h3 class="text-[12px] font-bold text-emerald-950">Rebutan Bakul Grade A</h3>
            <p class="mt-0.5 text-[11px] text-emerald-900 font-semibold">Kulit baja & bobot naik 2X</p>
          </div>
        </div>
      </div>

      <!-- Competitor-Killer Head-to-Head Matrix -->
      <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-2 bg-slate-900 text-[12px] font-bold text-white">
          <div class="p-2.5 text-red-300 border-r border-slate-800">✗ Cuma Fungisida & ZPT Air</div>
          <div class="p-2.5 text-[#4ADE80]">✓ SARATOGA Penguat Kulit & Bobot</div>
        </div>
        <div class="divide-y divide-slate-200 text-[12px] leading-snug">
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Kulit buah tipis gampang patek</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Dinding sel tebal kalis air hujan</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Pantat tomat menghitam cekung</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">0% Busuk pantat & anti retak</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Buah besar berongga tapi enteng</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Daging padat +6 kg per karung</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Kalsium bubuk sumbat spuyer</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">100% Cair murni bebas bau amis</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-7">
      <div class="-mx-5 mb-4 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/saratoga-hero.webp"
          alt="Botol resmi SARATOGA Serum Jepang Penguat Kulit Buah dan Pendongkrak Bobot Panen"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Shieldtag Badge -->
      <div class="mb-5 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Segel Hologram Shieldtag"
          class="h-12 w-12 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original — Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight">
            Japanese L-Amino + Kalium-Fosfat-Boron Pengisi Bobot Buah (250ml, 500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950 mb-4">
        3 Reaksi Brutal <span class="hl-brush">Pengaman Panen Grade A</span>
      </h2>

      <!-- 3 Clean Visual Overclaim Cards -->
      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-950">
            <img
              src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/overclaim-1.webp"
              alt="Kulit buah cabai merah dan tomat tebal liat mengkilap kalis air hujan dan tahan jamur patek"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 1 • PERISAI KULIT BAJA ANTI-PATEK & ANTI-BUSUK PANTAT
              </span>
              <h3 class="mt-1 text-[15px] font-bold text-white leading-tight">
                Kulit Buah Tebal Liat Kalis Air Hujan — Jamur Patek Gagal Tembus!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-700 leading-snug">
            Memperkuat ikatan pektin dinding sel buah sehingga 0% busuk pantat hitam & tahan simpan jauh.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-950">
            <img
              src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/overclaim-2.webp"
              alt="Petani menimbang karung cabai dan peti tomat Grade A yang berat berbobot di timbangan"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 2 • DONGKRAK BOBOT TIMBANGAN +6 KG PER KARUNG
              </span>
              <h3 class="mt-1 text-[15px] font-bold text-white leading-tight">
                Daging Buah Tebal Berisi Penuh Biji — Penebas Langsung Bayar Kontan!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-700 leading-snug">
            Kalium dan Fosfat aktif memompa karbohidrat ke daging buah hingga padat keras bebas kopong.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-950">
            <img
              src="/images/landing/pelindung-patek-busuk-pantat-pembobot-buah-saratoga/overclaim-3.webp"
              alt="Pohon cabai dan tomat tetap memunculkan bunga susulan di pucuk atas sambil buah bawah dipetik"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 3 • PANEN MARATON & 100% BEBAS LALAT BUAH
              </span>
              <h3 class="mt-1 text-[15px] font-bold text-white leading-tight">
                Buah Bawah Dipetik Merah Mulus, Pucuk Atas Terus Keluar Bunga Baru!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-700 leading-snug">
            100% tanpa bau amis sehingga tidak memancing lalat buah penyuntik belatung saat buah matang.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950">
        Takaran Irit <span class="hl-brush">2 Tutup / Tangki 16L</span>
      </h2>

      <div class="-mx-5 my-3.5">
        <img
