---
/**
 * Native Landing Page: Penguat Batang Padi Anti Rebah & Pengisi Gabah Bernas: Kojien
 *
 * Clean, High-Contrast Direct-Response LP (Precision Visuals & Scannable Copy)
 * Master Product: kojien (ID: 99118)
 * Architecture Contract: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-combo-padi-baja-gabah-bernas.css';

export const prerender = false;

const SLUG = 'paket-combo-padi-baja-gabah-bernas';

const product =
  (await getStorefrontProduct(Astro.locals, 'kojien')) ??
  (await getStorefrontProduct(Astro.locals, '99118'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/paket-combo-padi-baja-gabah-bernas/hero-problem.webp';
---

<BaseLayout
  title={`Pupuk Bio-Silika Cair KOJIEN Penguat Batang Padi Anti-Rebah & Pengisi Gabah Bernas - ${Astro.locals.tenant.name}`}
  description="Perkuat batang padi sekeras baja tahan angin kencang dan hujan lebat (anti-rebah), cegah kresek & blas potong leher, serta isi gabah bernas sampai pangkal malai dengan formula bio-silika KOJIEN Original."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-5">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white">
          PERISAI PADI BATANG BAJA & GABAH BERNAS
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[24px] font-bold leading-[1.18] tracking-tight text-slate-950">
          Kuatkan Batang Padi Anti-Rebah & Cetak <span class="hl-brush">GABAH BERNAS PENUH</span> Sampai Pangkal Malai!
        </h1>
        <p class="mx-auto mt-2.5 max-w-[400px] text-[14px] font-normal leading-snug text-slate-700">
          Lindungi sawah dari ambruk terendam hujan angin, cegah kresek & blas potong leher, dan dongkrak bobot karung panen.
        </p>
      </div>

      <div class="mt-4">
        <div class="overflow-hidden bg-slate-950">
          <img
            src={heroImage}
            alt="Pupuk Bio-Silika Cair KOJIEN Penguat Batang Padi Anti-Rebah & Pengisi Gabah Bernas"
            class="aspect-[16/9] w-full object-cover"
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="grid grid-cols-2 border-t border-slate-800 bg-slate-950 text-xs font-bold">
            <div class="border-r border-slate-800 bg-red-950/80 px-2.5 py-2 text-red-200">
              SEBELUM: Padi Rebah & Gabah Hampa
            </div>
            <div class="bg-emerald-950/80 px-2.5 py-2 text-emerald-200">
              SESUDAH: Batang Tegak & Malai Bernas
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-4 text-xs font-semibold text-slate-700">
          <span>✓ Garansi 100% Asli</span>
          <span class="text-slate-300">•</span>
          <span>✓ Segel Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>✓ Bisa COD</span>
        </div>

        <!-- Scannable 4-Point Checklist + Primary CTA -->
        <div class="mx-5 mt-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Batang Padi Kaku Sekeras Baja:</strong> Lapisan Bio-Silika mempertebal pangkal batang agar tahan terpaan angin.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Daun Bendera Tegak 45 Derajat:</strong> Tangkap sinar matahari maksimal dan tahan bakteri kresek / blas.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Isi Penuh Bulir Sampai Pangkal:</strong> Tekan angka gabah hampa (beluk) di bawah 5% dengan bulir bernas padat.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Lonjakan Tonase +1.5 s/d 2 Ton/Ha:</strong> Gabah kuning bening berbobot berat dan rendemen beras giling tinggi.</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan KOJIEN Penguat Padi Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION -->
    <section class="bg-red-50/40 px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        2 Bencana Musim Panen <span class="hl-brush-red">Padi Ambruk & Gabah Hampa</span>
      </h2>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/paket-combo-padi-baja-gabah-bernas/gejala-1.webp"
              alt="Padi Rebah (Ambruk) Saat Hujan Angin"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 1
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Padi Rebah (Ambruk) Saat Hujan Angin</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Batang bawah yang lembek akibat kelebihan Urea langsung patah saat malai mulai berat, membuat gabah busuk terendam lumpur.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/paket-combo-padi-baja-gabah-bernas/gejala-2.webp"
              alt="Serangan Kresek, Potong Leher & Gabah Hampa"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 2
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Serangan Kresek, Potong Leher & Gabah Hampa</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Daun bendera mengering terbakar dan leher malai patah sehingga ribuan bulir padi putih kosong tak berisi.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        Bukti Perubahan: <span class="hl-brush-red">Rebah & Hampa</span> Jadi <span class="hl-brush">Batang Tegak & Malai Emas</span>
      </h2>

      <div class="-mx-5 mt-3.5 mb-4 overflow-hidden bg-slate-950">
        <img
          src="/images/landing/paket-combo-padi-baja-gabah-bernas/overclaim-timeline.webp"
          alt="Tahapan pemulihan dan panen"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 border-t border-slate-800 bg-slate-950 px-2 py-2 text-center text-xs font-bold">
          <span class="text-amber-300">25 HST: Anakan Rumpun Lebat</span>
          <span class="text-emerald-300">45 HST: Daun Bendera Tegak Kaku</span>
          <span class="text-emerald-400">85 HST: Malai Emas Bernas Penuh</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
          <img
            src="/images/landing/paket-combo-padi-baja-gabah-bernas/kondisi-rusak.webp"
            alt="Padi Ambruk & Beluk"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
            Tanpa KOJIEN
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-slate-900">Padi Ambruk & Beluk</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-slate-600">
              Batang patah terendam air, bulir separuh hampa, panen rugi.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40">
          <img
            src="/images/landing/paket-combo-padi-baja-gabah-bernas/kondisi-pulih.webp"
            alt="Tegak & Bernas Penuh"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-xs font-bold text-white">
            Pakai KOJIEN Original
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-emerald-950">Tegak & Bernas Penuh</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-emerald-900">
              Batang kokoh sampai panen, malai merunduk padat berisi.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SHOWCASE & 3 CORE PILLARS -->
    <section class="bg-emerald-950 px-5 py-7 text-white">
      <div class="text-center">
        <h2 class="mx-auto text-[20px] font-bold leading-[1.2] tracking-tight text-white">
          3 Keunggulan <span class="hl-brush">Formula Bio-Silika KOJIEN Padi</span>
        </h2>
      </div>

      <!-- Full-Width 16:9 Precision Product Bottle Card -->
      <div class="mt-4 overflow-hidden rounded-xl border border-emerald-700 bg-emerald-900/60 shadow-sm">
        <img
          src="/images/landing/paket-combo-padi-baja-gabah-bernas/kojien-hero.webp"
          alt="KOJIEN Bio-Silika & Nutrisi Sel Padi Asli (Segel Resmi Pabrik)"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3.5 text-center">
          <h3 class="text-[15px] font-bold text-white">KOJIEN Bio-Silika & Nutrisi Sel Padi Asli (Segel Resmi Pabrik)</h3>
          <p class="mt-0.5 text-xs font-normal text-emerald-200">
            Teknologi Nano-Silika Thailand • Batang Sekeras Baja Anti-Rebah & Gabah Bernas Penuh
          </p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Nano Bio-Silika Penguat Dinding Sel</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Melapisi epidermis batang dan daun bendera menjadi kaku, tegak, dan tahan rebah.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Perisai Imun Anti-Kresek & Blas</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Menghambat penetrasi jamur Pyricularia (potong leher) dan bakteri Xanthomonas.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Kalium-Molibdenum Pengisi Bulir</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Mempercepat pengisian susu gabah hingga ke bulir pangkal paling bawah.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. FARMER TESTIMONIALS -->
    <section class="bg-white px-5 py-7">
      <div class="text-center">
        <h2 class="mx-auto text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Hasil Nyata di Lapangan
        </h2>
      </div>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-padi-baja-gabah-bernas/testi-1.webp"
            alt="Pak H. Karno — Indramayu, Jabar"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H. Karno — Indramayu, Jabar</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Sawah Tetangga Ambruk, Punya Saya Tegak!</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Kemarin kena hujan angin deras 2 malam. Sawah kanan kiri rata ambruk semua, padi saya yang disemprot KOJIEN tetap berdiri tegak sampai dipanen combi!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-padi-baja-gabah-bernas/testi-2.webp"
            alt="Pak Mulyono — Sragen, Jateng"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Mulyono — Sragen, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Karung Lebih Berat</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Bulir pangkal yang biasanya kempes sekarang isi penuh semua. 1 hektar biasanya 6.2 ton GKP, musim ini tembus 7.8 ton!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/paket-combo-padi-baja-gabah-bernas/testi-3.webp"
            alt="Pak Anwar — Sidrap, Sulsel"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Anwar — Sidrap, Sulsel</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Bebas Kresek & Potong Leher</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Daun bendera hijau segar sampai gabah menguning emas. Berasnya waktu digiling utuh bening nggak gampang patah."
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. CHECKOUT FORM SECTION -->
    <section id="checkout-form" class="scroll-mt-8 border-t border-slate-100 bg-white py-8">
      <div class="px-5 pb-5 text-center">
        <h2 class="mx-auto max-w-[360px] text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Nutrisi Padi KOJIEN Original</span>
        </h2>
        <p class="mx-auto mt-1.5 max-w-[360px] text-[13px] font-normal text-slate-600">
          Pilih kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}). Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={preferredVariant?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <StickyLandingCtaBar
    ctaText="Pesan KOJIEN Padi — Bisa COD"
    subText="Garansi Asli Segel Barcode • Bayar Saat Barang Sampai"
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
