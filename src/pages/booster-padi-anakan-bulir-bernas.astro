---
/**
 * Native Landing Page: Booster Padi Formula Thailand — Anakan Produktif & Bulir Bernas (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/booster-padi-anakan-bulir-bernas.css';

export const prerender = false;

const SLUG = 'booster-padi-anakan-bulir-bernas';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const oneLiterVariant = product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label));
const twoLiterVariant = product.variants.find((v) => /2\s*liter|\b2\s*l\b/i.test(v.label));
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/booster-padi-anakan-bulir-bernas/hero-problem.webp';
---

<BaseLayout
  title={`Obat Padi Asem-Aseman (Merah Kerdil) & Booster 45+ Anakan Bernas: Bensu - ${Astro.locals.tenant.name}`}
  description="Stop tabur Urea saat padi asem-aseman! Sembuhkan padi asem-aseman (daun merah karat, akar hitam & kerdil 15-35 HST) dalam 4 hari, keluar akar putih 48 jam, meledak 45+ anakan produktif & bulir bernas padat sampai pangkal malai dengan Bensu Formula Thailand."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Ultra-Clean, Brutal Overclaim, Fast Scan) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-sm">
          STOP TABUR UREA SAAT PADI ASEM-ASEMAN!
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[27px] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Sembuhkan Padi Asem-Aseman (Merah Kerdil) <span class="hl-brush">HIJAU ROYO 4 HARI</span> & Meledak 45+ Anakan Bernas!
        </h1>
        <p class="mx-auto mt-2.5 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Semprot kabut <strong class="text-slate-950 font-bold">BENSU Formula Thailand</strong>: 2 jam terserap daun, 48 jam keluar akar putih gondrong & bulir bernas padat sampai pangkal malai!
        </p>
      </div>

      <div class="mt-4">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan padi asem-aseman daun merah karat kerdil akar hitam vs pulih hijau royo-royo 45+ anakan dan malai bernas dengan Bensu"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Jaminan 48 Jam Akar Putih Keluar • Hari Ke-4 Hijau Jegrik & 45+ Anakan!
            </p>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Formula Thailand</span>
          <span class="text-slate-300">•</span>
          <span>Segel Shieldtag Asli</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
        </div>

        <!-- 4 Brutal One-Line Checkmarks + Primary CTA -->
        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>2 Jam Terserap Daun</strong> — sembuhkan merah karat & kerdil tanpa tunggu akar pulih</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>48 Jam Akar Putih Gondrong</strong> — cuci tuntas racun lumpur asam & besi pirit</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>4 Hari Hijau Jegrik & 45+ Anakan</strong> — batang baja berlapis silika anti-rebah</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>100% Malai Bernas Sampai Pangkal</strong> — bebas gabuk, <strong>1 Liter cukup 1 Hektar</strong></span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[48px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Obat Asem-Aseman & Booster 45+ Anakan →
          </a>
          <p class="mt-2 text-center text-[11px] font-semibold text-emerald-950">
            Tersedia Paket Uji Coba 500ml ({formatIdr(preferredVariant?.price ?? 135000)}) untuk 16–20 tangki semprot!
          </p>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (Clean, Concise 1-Line Cards) -->
    <section class="bg-red-50/35 px-5 py-7">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Bahaya Fatal <span class="hl-brush-red">Padi Asem-Aseman</span>
      </h2>
      <p class="text-[13px] text-slate-600 mt-1.5 mb-4">
        Kenapa makin ditabur Urea justru makin merah terbakar dan gagal panen?
      </p>

      <div class="space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/gejala-1.webp"
              alt="Rumpun padi kerdil daun merah karat dan akar hitam busuk akibat asem-aseman di lumpur sawah"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Umur 15–35 HST: Daun Merah Karat & Kerdil
            </span>
          </div>
          <div class="p-3">
            <h3 class="text-[14px] font-bold text-slate-950">Akar Hitam Busuk — Dihantam Urea Langsung Gosong!</h3>
            <p class="text-[12px] text-slate-600 mt-0.5 leading-snug">
              Lumpur asam & besi pirit mengunci akar jadi hitam; kalau ditabur Urea rumpun langsung mati suri.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/gejala-2.webp"
              alt="Petani berdiri sedih di hamparan sawah padi yang merah menguning kerdil dan anakan macet akibat salah tabur Urea saat asem-aseman"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Salah Hantam Urea: Anakan Macet & Malai Kopong
            </span>
          </div>
          <div class="p-3">
            <h3 class="text-[14px] font-bold text-slate-950">Anakan Mentok 8 Batang & Pangkal Malai Hampa</h3>
            <p class="text-[12px] text-slate-600 mt-0.5 leading-snug">
              Sawah makin merah terbakar, anakan macet kerdil, dan susu gabah gagal mengisi pangkal malai.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & ULTRA-CLEAN COMPARISON MATRIX -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti 4 Hari: <span class="hl-brush-red">Merah Kerdil</span> Jadi <span class="hl-brush">45+ Anakan</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-3.5 mb-4 relative bg-slate-950">
        <img
          src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-timeline.webp"
          alt="Tahapan pemulihan padi asem-aseman dari merah kerdil, 48 jam akar putih gondrong, hingga 45+ anakan dan malai bernas dengan Bensu"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Merah Kerdil</span>
          <span class="text-amber-300">48 Jam: Akar Putih</span>
          <span class="text-emerald-400">Hari 4: 45+ Anakan</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/booster-padi-anakan-bulir-bernas/kondisi-rusak.webp"
            alt="Sawah terkena asem-aseman daun merah karat kerdil dan bulir malai banyak yang hampa"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Kena Asem-Aseman
          </div>
          <div class="flex flex-1 flex-col justify-center p-2.5">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Merah Karat & Kerdil</h3>
            <p class="mt-0.5 text-[11px] leading-snug text-slate-500">
              Akar hitam busuk, anakan macet 8 batang.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/booster-padi-anakan-bulir-bernas/kondisi-pulih.webp"
            alt="Sawah pulih 4 hari pakai Bensu hijau royo-royo 45+ anakan dan malai merunduk padat bernas"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            4 Hari Pakai BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-2.5">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Hijau Royo & 45+ Anakan</h3>
            <p class="mt-0.5 text-[11px] leading-snug text-slate-600">
              Akar putih gondrong, malai bernas padat.
            </p>
          </div>
        </div>
      </div>

      <!-- Clean 1-Line Competitor-Killer Matrix (Zero Wall of Text) -->
      <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-2 bg-slate-900 text-[12px] font-bold text-white">
          <div class="p-2.5 text-red-300 border-r border-slate-800">✗ Tabur Urea & Obat Biasa</div>
          <div class="p-2.5 text-[#4ADE80]">✓ BENSU Formula Thailand</div>
        </div>
        <div class="divide-y divide-slate-200 text-[12px] leading-snug">
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Akar hitam makin gosong</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">2 Jam terserap lewat daun</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Mengendap di lumpur asam</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">48 Jam akar putih gondrong</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Anakan mentok 8–10 batang</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Meledak 45+ anakan produktif</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Pangkal malai banyak kopong</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Bernas padat sampai pangkal</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Boros pupuk berkarung-karung</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">1 Liter cukup 1 Hektar sawah</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS (Clean & Visual-First) -->
    <section class="bg-slate-50/70 px-5 py-7">
      <div class="-mx-5 mb-4 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/booster-padi-anakan-bulir-bernas/bensu-hero.webp"
          alt="Botol resmi Bensu Pupuk Cair Organik Formula Thailand penyembuh padi asem-aseman dan booster 45+ anakan"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Shieldtag Badge -->
      <div class="mb-5 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi BENSU Segel Hologram Shieldtag Anti-Pemalsuan"
          class="h-12 w-12 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">BENSU Original — Logo Timbul & Segel Shieldtag</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Formula Dingin Thailand: L-Amino + Humat Pencuci Asam + Bio-Silika (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950 mb-4">
        3 Reaksi Brutal <span class="hl-brush">BENSU Thailand</span>
      </h2>

      <!-- 3 Big Visual Overclaim Cards (1-Line Punchy Copy) -->
      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-1.webp"
              alt="Rumpun padi sembuh dari asem-aseman dengan akar serabut putih gondrong dan 45+ anakan produktif"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 1 • 48 JAM AKAR PUTIH GONDRONG
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Sembuhkan Asem-Aseman & Ledakkan 45+ Anakan!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2.5 text-[12px] text-slate-700 leading-snug">
            Cuci bersih racun lumpur asam & besi pirit, paksa akar putih keluar dalam 48 jam.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-2.webp"
              alt="Hamparan sawah kembali hijau royo-royo dalam 4 hari dengan daun bendera padi tegak jegrik"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 2 • 4 HARI HIJAU ROYO & DAUN JEGRIK
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daun Merah Karat Hilang & Batang Baja Anti-Rebah!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2.5 text-[12px] text-slate-700 leading-snug">
            Daun bendera berdiri tegak 90° berlapis Bio-Silika kebal cuaca ekstrem & angin.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-3.webp"
              alt="Malai padi merunduk berat dengan bulir kuning keemasan bernas padat sampai pangkal"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 3 • 100% BERNAS SAMPAI PANGKAL MALAI
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Gabah Padat Berbobot & Timbangan Panen Meledak!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2.5 text-[12px] text-slate-700 leading-snug">
            Pompa susu gabah penuh dari ujung sampai leher malai bebas gabuk hampa.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-5 relative">
        <img
          src="/images/landing/booster-padi-anakan-bulir-bernas/macro-proof.webp"
          alt="Detail makro malai padi kuning bernas berisi penuh dari ujung sampai pangkal leher malai"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Jaminan Panen: Bulir kuning keemasan padat berisi sampai pangkal malai!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Kotak Singkat) -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span>
      </h2>

      <div class="-mx-5 my-3.5">
        <img
          src="/images/landing/booster-padi-anakan-bulir-bernas/aplikasi-kebun.webp"
          alt="Petani menyemprotkan kabut nutrisi dingin Bensu Formula Thailand di sawah padi pagi hari"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
