---
/**
 * Native Landing Page: Booster Padi Formula Thailand — Anakan Produktif & Bulir Bernas (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/booster-padi-anakan-bulir-bernas.css';

export const prerender = false;

const SLUG = 'booster-padi-anakan-bulir-bernas';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/booster-padi-anakan-bulir-bernas/hero-problem.webp';
---

<BaseLayout
  title={`Booster Padi Formula Thailand 45+ Anakan & Bulir Bernas: Bensu - ${Astro.locals.tenant.name}`}
  description="Rahasia nutrisi Formula Thailand untuk bikin sawah hijau royo-royo, meledak 45+ anakan produktif, daun bendera tegak jegrik, dan bulir padi bernas padat sampai ujung malai dengan Bensu Original."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Over-Claim, Competitor-Killer, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">RAHASIA FORMULA NUTRISI THAILAND PENCETAK PANEN REKOR!</span>
          Bikin Sawah Hijau Royo-Royo, Meledak <span class="hl-brush">45+ ANAKAN PRODUKTIF</span> & Bulir Padi Bernas Padat Sampai Ujung Malai!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Bebaskan padi dari stres cuaca panas & tanah masam dengan <strong class="text-slate-950 font-bold">BENSU Original (Botol Logo Timbul & Shieldtag)</strong>: akar serabut putih gondrong dalam 48 jam, daun bendera tegak jegrik, dan gabah bernas berbobot tanpa hampa!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan rumpun padi kurus kuning sedikit anakan vs meledak 45+ anakan hijau royo-royo dan malai bernas dengan Bensu"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Formula Thailand: Rumpun mekar 45+ anakan, daun tegak jegrik & malai merunduk penuh gabah!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Formula Nutrisi Thailand</span>
          <span class="text-slate-300">•</span>
          <span>Botol Logo Timbul & Shieldtag</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
        </div>

        <!-- 4 Point Over-Claim Checklist + Above-the-Fold CTA -->
        <div class="mx-5 mt-5 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Ledakkan 45+ Anakan Produktif Serempak</strong> dengan memicu akar serabut putih gondrong bebas asem-aseman</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Isi Padat Bulir Sampai Pangkal & Ujung Malai</strong> sehingga gabah bernas berbobot dan minim gabah hampa</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Imbangi Cuaca Panas & Perkuat Batang Silika</strong> agar daun bendera hijau tegak jegrik dan tahan rebah angin</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Kemasan Otentik Logo Timbul & Shieldtag</strong> — hemat pupuk kimia dan dongkrak hasil timbangan panen per hektar</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Paket Booster Padi Formula Thailand →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Penyebab Utama <span class="hl-brush-red">Tonase Panen Padi Anjlok</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Mengapa sudah ditebar Urea dan NPK berkarung-karung tapi anakan tetap kurus dan gabah banyak yang kopong?
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/gejala-1.webp"
              alt="Rumpun padi kurus sedikit anakan dan daun menguning merah akibat cuaca panas dan asam lumpur"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Anakan Padi Sedikit & Daun Menguning Kalah Cuaca Panas/Asam Lumpur
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Anakan Padi Sedikit & Daun Menguning Kalah Cuaca Panas/Asam Lumpur</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Lumpur sawah yang masam mengunci akar menjadi hitam kaku (asem-aseman) ditambah terik cuaca panas membuat rumpun macet hanya 10–12 batang dan daun menguning.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/gejala-2.webp"
              alt="Malai padi banyak yang kopong hampa di bagian pangkal dan gabah ringan saat ditimbang"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Pengisian Malai Tidak Merata — Pangkal Malai Kopong Hampa & Gabah Ringan
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Pengisian Malai Tidak Merata — Pangkal Malai Kopong Hampa & Gabah Ringan</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Saat fase bunting dan pengisian bulir, tanaman kehabisan energi asam amino dan Kalium-Silika sehingga susu gabah gagal sampai ke pangkal malai dan banyak terbuang di blower.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Bukti Sawah: <span class="hl-brush-red">Kurus Hampa</span> Jadi <span class="hl-brush">Rimbun Bernas</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-timeline.webp"
          alt="Tahapan pertumbuhan padi dengan Bensu dari akar putih, anakan 45+ batang, hingga malai bernas menguning"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">48 Jam: Akar Putih</span>
          <span class="text-amber-300">Vegetatif: 45+ Anakan</span>
          <span class="text-emerald-400">Generatif: Malai Bernas</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/booster-padi-anakan-bulir-bernas/kondisi-rusak.webp"
            alt="Sawah tanpa Bensu rumpun kurus menguning dan bulir malai banyak yang hampa"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Kurus & Banyak Hampa</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Anakan sedikit, daun lemas kalah panas, karung gabah ringan.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/booster-padi-anakan-bulir-bernas/kondisi-pulih.webp"
            alt="Sawah pakai Bensu hijau royo-royo 45+ anakan dan malai merunduk padat bernas"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">45+ Anakan & Bernas</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Daun bendera tegak hijau, bulir terisi penuh sampai ujung malai.
            </p>
          </div>
        </div>
      </div>

      <!-- Competitor-Killer Head-to-Head Matrix -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-50/60 shadow-sm">
        <div class="bg-slate-900 px-3.5 py-2.5 text-center">
          <h3 class="text-[13px] font-bold text-white">
            Mengapa Urea/NPK Saja & ZPT Murahan Gagal vs Keunggulan Mutlak BENSU?
          </h3>
        </div>
        <div class="divide-y divide-slate-200 text-[11px] leading-snug">
          <div class="grid grid-cols-2 bg-slate-100 font-bold text-slate-900">
            <div class="p-2.5 text-red-700 border-r border-slate-200">✗ Hanya Mengandalkan Urea/NPK & ZPT Murahan</div>
            <div class="p-2.5 text-emerald-800 bg-emerald-50/60">✓ BENSU Formula Thailand (Humat-Fulvat + L-Amino + Bio-Silika)</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Terkunci Lumpur Masam:</strong> Pupuk tabur mengendap di tanah asem-aseman sehingga akar tetap hitam dan anakan macet.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Buka Kunci Akar 48 Jam:</strong> Humat-Fulvat menetralisir keasaman lumpur dan memacu akar putih baru hingga anakan meledak 45+.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Daun Lemas Rawan Jamur:</strong> Kebanyakan Urea bikin daun lembek berair, mudah terserang kresek/blas, dan rebah kena angin.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Daun Tegak Jegrik Berlapis Silika:</strong> Bio-Silika memperkokoh batang bawah dan menegakkan daun bendera untuk fotosintesis maksimal.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Malai Panjang Tapi Kopong:</strong> ZPT giberelin murahan hanya memanjangkan malai tanpa sanggup mengisi susu gabah.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Bernas Padat Sampai Ujung:</strong> L-Amino & Kalium organik memompa pati penuh dari bulir ujung hingga pangkal malai.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Rawan Barang Tiruan Encer:</strong> Botol polos tanpa segel mudah dipalsukan dengan air pewarna.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Botol Logo Timbul & Shieldtag:</strong> Jaminan 100% BENSU Original dengan Emboss Logo Timbul & Hologram Shieldtag.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/booster-padi-anakan-bulir-bernas/bensu-hero.webp"
          alt="Botol resmi Bensu Pupuk Cair Organik Formula Thailand di hamparan sawah padi menguning"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Shieldtag Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi BENSU Segel Hologram Shieldtag Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">BENSU Original — Botol Logo Timbul & Hologram Shieldtag</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Formula Nutrisi Thailand Padi, Jagung & Hortikultura + Botol Anti-Pecah Berhologram Resmi (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Keunggulan <span class="hl-brush">BENSU Formula Thailand</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Mengawal padi dari fase pindah tanam, beranak aktif, hingga pengisian bulir bernas:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-1.webp"
              alt="Rumpun padi mekar padat dengan 45+ anakan produktif dan akar serabut putih panjang"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • LEDAKKAN 45+ ANAKAN PRODUKTIF
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Akar Putih Gondrong 48 Jam & Rumpun Mekar Serempak!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Membebaskan akar dari cekaman lumpur asam (asem-aseman) dan memacu tunas anakan baru yang sama tinggi dan semuanya membawa malai produktif.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-2.webp"
              alt="Hamparan sawah hijau royo-royo dengan daun bendera padi tegak jegrik tahan cuaca panas"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • DAUN BENDERA TEGAK JEGRIK
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Sawah Hijau Royo-Royo & Imbangi Terik Cuaca Panas!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            L-Amino dan Bio-Silika menjaga daun bendera tetap hijau segar sampai masa panen, memperkeras batang bawah agar anti-rebah, dan menangkal stres cuaca panas.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-padi-anakan-bulir-bernas/overclaim-3.webp"
              alt="Malai padi merunduk berat dengan bulir kuning keemasan bernas padat sampai pangkal"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • BULIR BERNAS SAMPAI UJUNG MALAI
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Gabah Padat Berbobot, Minim Hampa & Rendemen Beras Tinggi!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mempercepat pengisian susu gabah secara merata dari ujung hingga leher malai sehingga bulir bernas kuning keemasan dan timbangan karung jauh lebih berat.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
