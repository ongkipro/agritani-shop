---
/**
 * Native Landing Page: Serum Pelebat Buah Asam Amino Jepang & Pengunci Bunga (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/serum-pelebat-buah-asam-amino.css';

export const prerender = false;

const SLUG = 'serum-pelebat-buah-asam-amino';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const trialVariant = product.variants.find((v) => /250\s*ml/i.test(v.label));
const oneLiterVariant = product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label));
const twoLiterVariant = product.variants.find((v) => /2\s*liter|\b2\s*l\b/i.test(v.label));
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/serum-pelebat-buah-asam-amino/hero-problem.webp';
---

<BaseLayout
  title={`Serum Pelebat Buah Asam Amino Jepang & Pengunci Bunga Anti-Rontok | ${Astro.locals.tenant.name}`}
  description="Paksa tanaman malas berbuah meledak dompolan buah lebat dan kunci 98% bunga anti-rontok dalam 48 jam. Serum Asam Amino Jepang SARATOGA 100% tanpa bau amis."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-sm">
          BUNGA & PENTIL CABAI / BUAH SERING RONTOK SAAT HUJAN ANGIN?
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[27px] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Kunci 98% Tangkai Bunga Anti-Rontok 48 Jam & Paksa Meledak <span class="hl-brush">DOMPOLAN BUAH LEBAT</span> — Tanpa Bau Amis!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Buktikan kedahsyatan <strong class="text-slate-950 font-bold">SARATOGA</strong> (Japanese L-Amino + Kalium + Fosfat + Boron + GA3): mengunci cincin tangkai bunga cabai, tomat, durian, mangga & alpukat dalam 48 jam tanpa bau amis pengundang lalat buah!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi bukti hasil aplikasi serum asam amino Jepang SARATOGA pelebat buah dan pengunci bunga anti rontok"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Bukti Hasil SARATOGA: 98% bunga mengunci jadi pentil buah bernas & dompolan lebat 2x lipat!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Japanese L-Amino + K-P-Boron + GA3</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>100% Tanpa Bau Amis</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Las kuat cincin tangkai bunga dalam 48 jam & cegah kerontokan bunga saat hujan angin</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Pacu pembungaan serempak pada cabai, tomat, jeruk, mangga, durian & alpukat yang malas berbuah</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Formula Asam Amino Jepang 100% tanpa bau amis — bebas serbuan lalat buah penyengat cabai</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Pulihkan cabai keriting kembali sehat produktif & pompa bobot buah padat mengkilap Grade A</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Serum Pelebat Buah SARATOGA — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Gejala Mematikan <span class="hl-brush-red">Perontok Bunga & Perusak Buah</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Mengapa bunga yang sudah mekar lebat tiba-tiba gugur habis dan pentil buah busuk tersengat lalat:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/serum-pelebat-buah-asam-amino/gejala-1.webp"
              alt="Bunga dan pentil buah gugur berserakan di atas tanah dan mulsa saat hujan angin cuaca ekstrem"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Gugur Bunga & Pentil Saat Cuaca Ekstrem
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Bunga & Pentil Buah Gugur Berserakan Saat Hujan Angin / Cuaca Ekstrem</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Perubahan suhu panas terik ke hujan malam memicu lonjakan hormon etilen yang membuat tangkai bunga menguning pucat dan patah rontok sebelum sempat jadi buah.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/serum-pelebat-buah-asam-amino/gejala-2.webp"
              alt="Buah cabai dan mangga busuk berulat akibat lalat buah yang terpancing bau amis pupuk asam amino ikan"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Bau Amis Mengundang Lalat Buah
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Salah Pakai Asam Amino Ikan Bau Bangkai yang Mengundang Lalat Buah Menyengat Cabai/Buah</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Pupuk asam amino ikan biasa meninggalkan bau amis busuk di daun dan pentil buah yang justru menjadi magnet pemanggil ribuan lalat buah penyuntik belatung.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Rontok & Keriting</span> Jadi <span class="hl-brush">Dompolan Lebat</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/serum-pelebat-buah-asam-amino/overclaim-timeline.webp"
          alt="Tahapan kerja serum asam amino Jepang SARATOGA dari penguncian tangkai bunga 48 jam hingga dompolan buah penuh"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Jam 0: Rontok Parah</span>
          <span class="text-amber-300">48 Jam: Tangkai Kekar</span>
          <span class="text-emerald-400">Panen: Dompolan Penuh</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/serum-pelebat-buah-asam-amino/kondisi-rusak.webp"
            alt="Kondisi tanaman cabai keriting dan bunga rontok di atas mulsa tanpa SARATOGA"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Bunga Gugur & Ompong</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Tangkai menguning patah di mulsa, ruas cabang kosong tanpa buah.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/serum-pelebat-buah-asam-amino/kondisi-pulih.webp"
            alt="Kondisi tanaman cabai dan buah lebat setiap ketukan cabang mengikat pentil bernas dengan SARATOGA"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Meledak Dompolan Lebat</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              98% bunga mengikat jadi pentil buah padat mulus bebas lalat buah.
            </p>
          </div>
        </div>
      </div>

      <!-- HEAD-TO-HEAD COMPETITOR-KILLER MATRIX (Clean, Fast Scan) -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="bg-slate-950 px-4 py-2.5 text-center">
          <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            PERBANDINGAN TELAK: JANGAN UNDANG LALAT BUAH!
          </span>
        </div>

        <div class="grid grid-cols-2 bg-slate-900 text-[12px] font-bold text-white border-t border-slate-800">
          <div class="border-r border-slate-800 p-2.5 text-red-300">
            ✗ Asam Amino Ikan & Bubuk Biasa
          </div>
          <div class="p-2.5 text-[#4ADE80]">
            ✓ SARATOGA Asam Amino Jepang
          </div>
        </div>

        <div class="divide-y divide-slate-200 text-[12px] leading-snug">
          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              Bau amis panggil lalat buah penyengat cabai
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              100% Tanpa Bau Amis — bebas lalat buah
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              Lambat diserap saat cuaca mendung/hujan
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              Tembus stomata 2 jam & kunci tangkai 48 jam
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              Cabai keriting macet keluar bunga baru
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              Pulihkan pucuk keriting & pecah dompolan bunga
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              Endapan bubuk menyumbat spuyer tangki
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              Hemat 2 tutup/tangki (500ml = 16–20 tangki)
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Image -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/serum-pelebat-buah-asam-amino/saratoga-hero.webp"
          alt="Botol resmi SARATOGA Serum Asam Amino Jepang Pelebat Buah di kebun berbuah lebat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram + Shieldtag Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Original Serum Asam Amino Jepang Segel Hologram"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <span class="inline-block rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">
            GARANSI 100% ORIGINAL • FORMULA JEPANG RESMI
          </span>
          <p class="mt-1 text-[12px] font-bold text-emerald-950">SARATOGA Original — Serum Asam Amino Jepang Segel Hologram</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Waspada cairan asam amino palsu berbau amis di marketplace! SARATOGA resmi 100% odorless dilengkapi segel hologram & Shieldtag (250ml, 500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Serum Asam Amino SARATOGA</span> Pelebat Buah
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Kombinasi presisi L-Amino Jepang, Fosfat-Kalium tinggi, Boron, dan GA3 aktif:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/serum-pelebat-buah-asam-amino/overclaim-1.webp"
              alt="Cincin tangkai bunga cabai dan buah mengunci tebal hijau kekar anti rontok dalam 48 jam"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • KUNCI TANGKAI BUNGA 48 JAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Stop Kerontokan Bunga & Pentil Meski Hujan Angin!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Memblokir hormon etilen perontok dan mempertebal cincin pangkal tangkai bunga sehingga 98% bunga mekar berhasil mengikat jadi buah muda.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/serum-pelebat-buah-asam-amino/overclaim-2.webp"
              alt="Dompolan buah cabai, tomat, dan mangga muncul lebat di setiap ruas cabang berkat SARATOGA"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • MELEDAK DOMPOLAN SETANDAN
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Paksa Tanaman Malas Berbuah Penuh di Setiap Cabang!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Merangsang pembungaan serempak di luar musim dan melipatgandakan jumlah buah jadi per tandan tanpa bau amis pengundang lalat buah.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/serum-pelebat-buah-asam-amino/overclaim-3.webp"
              alt="Buah cabai dan tomat padat bernas mengkilap berbobot berat hasil panen SARATOGA"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • PENGISIAN BUAH PADAT BERBOBOT
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daging Buah Tebal Bernas & Bobot Timbangan Naik 2X!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kalium dan Fosfat organik memompa pengisian buah secara maksimal hingga kulit mulus mengkilap tahan pecah dan tahan simpan.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Aplikasi <span class="hl-brush">Super Hemat</span> di Kebun
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/serum-pelebat-buah-asam-amino/aplikasi-kebun.webp"
          alt="Petani menyemprotkan serum asam amino SARATOGA pada tanaman cabai dan buah yang sedang berbunga"
