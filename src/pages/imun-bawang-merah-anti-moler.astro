---
/**
 * Native Landing Page: Imun Bawang Merah Anti-Moler & Pembesar Umbi (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/imun-bawang-merah-anti-moler.css';

export const prerender = false;

const SLUG = 'imun-bawang-merah-anti-moler';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const oneLiterVariant = product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label));
const twoLiterVariant = product.variants.find((v) => /2\s*liter|\b2\s*l\b/i.test(v.label));
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/imun-bawang-merah-anti-moler/hero-problem.webp';
---

<BaseLayout
  title={`Imun Bawang Merah Anti-Moler Sejak 10 HST & Pembesar Umbi Jumbo | ${Astro.locals.tenant.name}`}
  description="Bentengi imun bawang merah sejak 10 HST dari serangan moler Fusarium dan pucuk kuning. Pipa daun berdiri kaku seperti jarum, umbi kecil membesar padat merah merona."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-sm">
          BENTENGI IMUN BAWANG MERAH SEJAK 10 HST DARI SERANGAN MOLER!
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[27px] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Kunci Imun Bawang Merah Tahan Hujan Malam: Dijamin <span class="hl-brush">BEBAS LAYU MOLER & UMBI JUMBO</span> Merah Merona!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Jangan tunggu moler menjalar sebedengan! Semprot kabut <strong class="text-slate-950 font-bold">BENSU Original</strong> (Botol Logo Timbul & Shieldtag) sejak 10 HST: pipa daun berdiri kaku seperti jarum, luka akar Fusarium mengering dalam 24 jam, dan umbi kecil membesar padat berbobot!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi tanaman bawang merah tahan hujan malam daun berdiri kaku seperti jarum dan umbi merah jumbo dengan BENSU"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Imun Bawang Terkunci Sejak 10 HST: 95% bebas moler, daun kaku jegrik & umbi padat 12–14 ton/Ha!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Activator Imun Bawang + Bio-Silika</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Botol Logo Timbul & Shieldtag</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Bangkitkan imun bawang merah sejak 10 HST & keringkan luka jamur Fusarium dalam 24 jam</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tegakkan pipa daun berdiri kaku seperti jarum tahan guyuran hujan malam tanpa efek kerdil</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Ubah umbi bawang kerdil kecil-kecil jadi pecah 14–16 siung merah tembaga super jumbo</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Kunci bobot umbi padat keras tahan simpan di gudang para-para (susut askip di bawah 6%)</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Paket Imun Bawang Merah BENSU — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Gejala Mematikan <span class="hl-brush-red">Bawang Rawan Moler & Umbi Kecil</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Kenapa tanaman bawang merah umur 10–35 HST mendadak melintir rebah dan umbinya gagal membesar:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/imun-bawang-merah-anti-moler/gejala-1.webp"
              alt="Daun bawang merah melintir rebah moler inul dan pucuk kuning habis diguyur hujan malam"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Moler Inul & Pucuk Kuning Pasca Hujan Malam
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Daun Bawang Melintir Rebah (Moler/Inul) & Pucuk Kuning Habis Diguyur Hujan Malam</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Air hujan asam yang menggenang di bedengan memicu spora jamur Fusarium menyerang leher umbi yang belum punya perisai imun, membuat daun meliuk nginul dan rebah sebedengan.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/imun-bawang-merah-anti-moler/gejala-2.webp"
              alt="Umbi bawang merah kerdil kecil-kecil akibat salah oplos fungisida dan ZPT panas"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Umbi Kerdil Akibat Obat & ZPT Panas
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Umbi Bawang Kerdil Kecil-Kecil Akibat Salah Oplos Fungisida/ZPT Panas</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Panik menyemprot oplosan 3–4 fungisida kimia panas dan ZPT penekan tumbuh justru membakar pucuk daun dan mengunci akar, sehingga siung bawang macet kerdil.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Rawan Moler</span> Jadi <span class="hl-brush">Daun Jarum & Umbi Besar</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/imun-bawang-merah-anti-moler/overclaim-timeline.webp"
          alt="Tahapan penguatan imun bawang merah sejak 10 HST hingga daun jegrik kaku dan umbi jumbo dengan Bensu"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">10 HST: Kunci Imun</span>
          <span class="text-amber-300">24 Jam: Luka Kering</span>
          <span class="text-emerald-400">Panen: Umbi Jumbo</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/imun-bawang-merah-anti-moler/kondisi-rusak.webp"
            alt="Kondisi bawang merah terserang moler inul daun melintir dan umbi kecil kerdil"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Moler & Umbi Kecil</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Daun melintir rebah pasca hujan malam, siung sedikit dan kerdil.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/imun-bawang-merah-anti-moler/kondisi-pulih.webp"
            alt="Kondisi bawang merah disemprot BENSU sejak 10 HST daun berdiri kaku seperti jarum dan umbi besar"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Daun Kaku & Umbi Besar</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Pipa daun tegak lurus tahan hujan, umbi kecil membesar padat merah.
            </p>
          </div>
        </div>
      </div>

      <!-- HEAD-TO-HEAD COMPETITOR-KILLER MATRIX (Clean 1-Line Scan) -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-2 bg-slate-900 text-[12px] font-bold text-white">
          <div class="border-r border-slate-800 p-2.5 text-red-300">
            ✗ Oplosan Fungisida & ZPT Panas
          </div>
          <div class="p-2.5 text-[#4ADE80]">
            ✓ BENSU Imun Bawang + Bio-Silika
          </div>
        </div>

        <div class="divide-y divide-slate-200 text-[12px] leading-snug">
          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              Pucuk gosong kuning & stres umur 15 HST
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              Formula dingin aman sejak 10 HST
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              Leher umbi lembek menjalar saat hujan
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              Keringkan luka moler 24 jam & daun kaku
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              ZPT kimia mengunci akar & umbi kerdil
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              Pecah 14–16 siung umbi jumbo merah merona
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600">
              Mudah luntur hujan & boros biaya obat
            </div>
            <div class="bg-emerald-50/40 p-2.5 font-bold text-emerald-950">
              Meresap cepat (500ml cukup 16–20 tangki)
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Image -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/imun-bawang-merah-anti-moler/bensu-hero.webp"
          alt="Botol BENSU Original Logo Timbul di Lahan Bawang Merah Bebas Moler"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram + Shieldtag Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi BENSU Original Botol Logo Timbul dan Hologram Shieldtag"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <span class="inline-block rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">
            GARANSI 100% ORIGINAL • BOTOL LOGO TIMBUL
          </span>
          <p class="mt-1 text-[12px] font-bold text-emerald-950">BENSU Original — Botol Logo Timbul & Hologram Shieldtag</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Pastikan Anda menerima botol resmi berlogo timbul dengan segel hologram & kode verifikasi Shieldtag anti-palsu (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Activator Imun BENSU</span> Sejak 10 HST
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Mengawal tanaman bawang merah dari fase vegetatif 10 HST hingga panen umbi super:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/imun-bawang-merah-anti-moler/overclaim-1.webp"
              alt="Pipa daun bawang merah berdiri kaku jegrik seperti jarum tahan hujan malam"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • BENTENG IMUN 10 HST ANTI-MOLER
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Pipa Daun Berdiri Kaku Seperti Jarum & Luka Kering 24 Jam!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mempertebal lapisan lilin dan dinding sel pipa daun sejak umur 10 HST sehingga air hujan asam langsung menggelinding jatuh dan jamur Fusarium gagal menginfeksi leher umbi.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/imun-bawang-merah-anti-moler/overclaim-2.webp"
              alt="Umbi bawang merah kecil membesar padat merah merona 14 sampai 16 siung"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • PEMBESAR UMBI BAWANG KERDIL
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Ubah Umbi Kecil Jadi Besar Padat 14–16 Siung Serempak!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mengalirkan nutrisi seluler langsung ke cakram perakaran untuk memecah anakan siung lebih banyak dan mendongkrak pengisian umbi bulat penuh.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/imun-bawang-merah-anti-moler/overclaim-3.webp"
              alt="Hasil panen bawang merah merah menyala padat berbobot tahan simpan askip"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • WARNA MERAH MERONA & BOBOT BERAT
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Kulit Merah Tembaga Mengkilap, Susut Simpan Di Bawah 6%!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Meningkatkan kepadatan daging siung bawang sehingga timbangan karung jauh lebih berat dan tidak gampang kempes saat disimpan di gudang.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/imun-bawang-merah-anti-moler/macro-proof.webp"
          alt="Foto makro umbi bawang merah besar padat merah merona hasil aplikasi BENSU"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Detail Umbi BENSU: Siung besar seragam, kulit merah merona menyala & leher batang kering sehat!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
