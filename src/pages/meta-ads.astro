---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

const tenant = Astro.locals.tenant;
const publicSiteUrl = (tenant.siteUrl && tenant.siteUrl !== 'https://example.com'
  ? tenant.siteUrl
  : 'https://agritani.shop'
).replace(/\/$/, '');
const storeName =
  tenant.name && tenant.name !== 'AdsBookCMS Store' ? tenant.name : 'Agritani Store';

const siteDomain = (() => {
  try {
    return new URL(publicSiteUrl).hostname;
  } catch {
    return 'agritani.shop';
  }
})();

const rawDoc = Astro.url.searchParams.get('doc');
const activeDoc =
  rawDoc === 'privacy' || rawDoc === 'terms' || rawDoc === 'deletion'
    ? rawDoc
    : null;

const seoByDoc = {
  default: {
    title: `Portal Administrasi Meta Ads & Conversions API - ${storeName}`,
    description: `Halaman administrasi resmi integrasi Meta Ads, Conversions API, login operator, Kebijakan Privasi, dan Ketentuan Layanan ${storeName}.`,
    canonical: `${publicSiteUrl}/meta-ads`,
  },
  privacy: {
    title: `Privacy Policy & Kebijakan Privasi Data Pengguna - ${storeName}`,
    description: `Kebijakan Privasi resmi ${storeName} untuk pemrosesan data pesanan pelanggan, atribusi Meta Pixel, Conversions API, dan Meta Marketing API.`,
    canonical: `${publicSiteUrl}/meta-ads?doc=privacy`,
  },
  terms: {
    title: `Terms of Service & Syarat Ketentuan Layanan - ${storeName}`,
    description: `Syarat dan Ketentuan layanan ${storeName} mencakup penggunaan storefront sarana pertanian, operasional Meta Ads, dan kepatuhan data pengguna.`,
    canonical: `${publicSiteUrl}/meta-ads?doc=terms`,
  },
  deletion: {
    title: `User Data Deletion & Instruksi Hapus Data - ${storeName}`,
    description: `Instruksi resmi pencabutan akses aplikasi Meta dan prosedur permintaan penghapusan data pengguna pada sistem server ${storeName}.`,
    canonical: `${publicSiteUrl}/meta-ads?doc=deletion`,
  },
} as const;

const currentSeo = activeDoc ? seoByDoc[activeDoc] : seoByDoc.default;

const basicUrls = [
  { label: 'App Domains', value: siteDomain },
  { label: 'Website (Site URL)', value: `${publicSiteUrl}/meta-ads` },
  { label: 'Privacy Policy URL', value: `${publicSiteUrl}/meta-ads?doc=privacy#privacy-policy` },
  { label: 'Terms of Service URL', value: `${publicSiteUrl}/meta-ads?doc=terms#terms-of-service` },
  { label: 'User Data Deletion URL', value: `${publicSiteUrl}/meta-ads?doc=deletion#data-deletion` },
] as const;
---

<BaseLayout
  title={currentSeo.title}
  description={currentSeo.description}
  canonical={currentSeo.canonical}
  hideHeader={true}
  hideFooter={true}
  noindex={true}
>
  <div class="divide-y divide-[#E5E5E5] bg-white text-[#111111]">
    <!-- 1. Header Administrasi (Single LP) -->
    <section class="px-5 py-6">
      <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold text-[#555555] tabular-nums">
        <span class="border border-[#111111] bg-[#111111] px-2 py-0.5 text-white">{storeName}</span>
        <span class="border border-[#E5E5E5] bg-[#FAFAFA] px-2 py-0.5 text-[#111111]">App ID: 1659770785737622</span>
        <span class="border border-[#E5E5E5] bg-[#FAFAFA] px-2 py-0.5 text-[#111111]">Business ID: 1167683925394352</span>
        <span class="border border-[#E5E5E5] bg-[#FAFAFA] px-2 py-0.5 text-[#111111]">Pixel ID: 1640621550357874</span>
      </div>

      <h1 class="mt-3 text-xl font-bold tracking-tight text-[#111111]">
        Portal Administrasi Meta Ads &amp; Kepatuhan Layanan
      </h1>
      <p class="mt-2 text-xs leading-relaxed text-[#555555]">
        Satu halaman terpadu untuk login operator, konfigurasi URL Meta Developer App (<span class="tabular-nums">1659770785737622</span>), Privacy Policy, Terms of Service, dan User Data Deletion.
      </p>

      <nav aria-label="Navigasi bagian halaman" class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
        <a href="#operator-login" class="border border-[#111111] bg-[#111111] px-3 py-1.5 text-white">
          Login
        </a>
        <a href="#meta-basic-settings" class="border border-[#E5E5E5] bg-[#FAFAFA] px-3 py-1.5 text-[#111111]">
          URL Meta
        </a>
        <a href="#privacy-policy" class="border border-[#E5E5E5] bg-[#FAFAFA] px-3 py-1.5 text-[#111111]">
          Privacy Policy
        </a>
        <a href="#terms-of-service" class="border border-[#E5E5E5] bg-[#FAFAFA] px-3 py-1.5 text-[#111111]">
          Terms of Service
        </a>
        <a href="#data-deletion" class="border border-[#E5E5E5] bg-[#FAFAFA] px-3 py-1.5 text-[#111111]">
          Data Deletion
        </a>
      </nav>
    </section>

    <!-- 2. Login Operator -->
    <section id="operator-login" class="bg-[#FAFAFA] px-5 py-6">
      <h2 class="text-sm font-bold text-[#111111]">Login Operator</h2>
      <p class="mt-1 text-xs text-[#555555]">
        Masuk menggunakan akun operator untuk mengakses manajemen Meta Pixel (<span class="tabular-nums">1640621550357874</span>), Conversions API, dan katalog sarana pertanian.
      </p>

      <form action="/hello" method="POST" class="mt-4 space-y-3 border border-[#E5E5E5] bg-white p-4">
        <div>
          <label for="lp-username" class="block text-xs font-bold text-[#111111]">Username</label>
          <input
            id="lp-username"
            type="text"
            name="username"
            required
            autocomplete="username"
            spellcheck="false"
            class="mt-1 min-h-10 w-full border border-[#111111] bg-white px-3 py-2 text-xs text-[#111111]"
            placeholder="Username operator"
          />
        </div>
        <div>
          <label for="lp-password" class="block text-xs font-bold text-[#111111]">Password</label>
          <input
            id="lp-password"
            type="password"
            name="password"
            required
            autocomplete="current-password"
            class="mt-1 min-h-10 w-full border border-[#111111] bg-white px-3 py-2 text-xs text-[#111111]"
            placeholder="Password operator"
          />
        </div>
        <button
          type="submit"
          class="inline-flex min-h-10 w-full items-center justify-center border border-[#111111] bg-[#111111] px-4 py-2 text-xs font-bold text-white"
        >
          Masuk Dashboard
        </button>
      </form>
    </section>

    <!-- 3. URL Administrasi Meta Basic Settings -->
    <section id="meta-basic-settings" class="px-5 py-6">
      <h2 class="text-sm font-bold text-[#111111]">URL untuk Meta App Basic Settings</h2>
      <p class="mt-1 text-xs text-[#555555]">
        Salin ke menu <strong class="font-semibold text-[#111111]">Settings → Basic</strong> pada Meta Developer App <span class="tabular-nums">1659770785737622</span>:
      </p>

      <div class="mt-3 divide-y divide-[#E5E5E5] border border-[#E5E5E5]">
        {basicUrls.map((item) => (
          <div class="p-3">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-[#111111]">{item.label}</span>
              <button
                type="button"
                data-copy={item.value}
                class="copy-url-btn shrink-0 border border-[#111111] bg-white px-2 py-0.5 text-[11px] font-semibold text-[#111111]"
              >
                Salin
              </button>
            </div>
            <p class="mt-1 break-all text-xs text-[#555555] tabular-nums">{item.value}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Privacy Policy -->
    <section id="privacy-policy" class="px-5 py-6">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-bold text-[#111111]">1. Privacy Policy (Kebijakan Privasi)</h2>
        <a href="/kebijakan-privasi" class="shrink-0 text-[11px] font-semibold text-[#2C6ECB] underline">
          Halaman Penuh
        </a>
      </div>
      <div class="mt-2.5 space-y-2.5 text-xs leading-relaxed text-[#555555]">
        <p>
          <strong class="font-semibold text-[#111111]">Data yang Dikumpulkan:</strong> Sistem {storeName} memproses nama penerima, nomor telepon/WhatsApp, alamat pengiriman lengkap (kecamatan/kabupaten/provinsi), rincian transaksi pesanan produk pertanian, serta identifier atribusi teknis (<code class="text-[#111111]">_fbp</code>, <code class="text-[#111111]">_fbc</code>, alamat IP, User-Agent, dan <code class="text-[#111111]">event_id</code>).
        </p>
        <p>
          <strong class="font-semibold text-[#111111]">Tujuan Pemrosesan &amp; Meta Platform:</strong> Data digunakan semata-mata untuk memproses pesanan pelanggan, verifikasi pembayaran/pengiriman ekspedisi COD maupun non-tunai, serta pengukuran konversi iklan melalui Meta Pixel (<span class="tabular-nums">1640621550357874</span>), Conversions API, dan Meta Marketing API (App ID <span class="tabular-nums">1659770785737622</span>). Parameter pencocokan pelanggan di-hash satu arah dengan algoritma SHA-256 sebelum dikirim ke server Meta.
        </p>
        <p>
          <strong class="font-semibold text-[#111111]">Perlindungan &amp; Penyimpanan:</strong> Data disimpan secara terenkripsi dengan akses terbatas hanya bagi operator resmi dan tidak diperjualbelikan kepada pihak ketiga di luar mitra logistik pengiriman pesanan.
        </p>
      </div>
    </section>

    <!-- 5. Terms of Service -->
    <section id="terms-of-service" class="px-5 py-6">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-bold text-[#111111]">2. Terms of Service (Syarat &amp; Ketentuan Layanan)</h2>
        <a href="/syarat-ketentuan" class="shrink-0 text-[11px] font-semibold text-[#2C6ECB] underline">
          Halaman Penuh
        </a>
      </div>
      <div class="mt-2.5 space-y-2.5 text-xs leading-relaxed text-[#555555]">
        <p>
          <strong class="font-semibold text-[#111111]">Ketentuan Layanan &amp; Transaksi:</strong> Dengan mengakses layanan dan melakukan pemesanan produk nutrisi/pupuk pertanian di {storeName}, pengguna menyatakan bahwa informasi kontak serta alamat pengiriman yang diberikan adalah benar dan menyetujui prosedur verifikasi pesanan (Bayar di Tempat / COD maupun pembayaran non-tunai).
        </p>
        <p>
          <strong class="font-semibold text-[#111111]">Otorisasi Operator &amp; Meta API:</strong> Akses ke panel operator dan integrasi Meta Marketing API (App ID <span class="tabular-nums">1659770785737622</span>) pada halaman ini hanya diperuntukkan bagi pengelola resmi Business Portfolio <span class="tabular-nums">1167683925394352</span> &amp; <span class="tabular-nums">743858491551103</span> sesuai ketentuan Meta Platform Terms dan hukum Republik Indonesia.
        </p>
      </div>
    </section>

    <!-- 6. User Data Deletion -->
    <section id="data-deletion" class="px-5 py-6">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-bold text-[#111111]">3. User Data Deletion (Prosedur Hapus Data)</h2>
        <a href="/kontak" class="shrink-0 text-[11px] font-semibold text-[#2C6ECB] underline">
          Hubungi CS
        </a>
      </div>
      <div class="mt-2.5 space-y-2.5 text-xs leading-relaxed text-[#555555]">
        <p>
          <strong class="font-semibold text-[#111111]">Pencabutan Akses dari Facebook:</strong> Buka akun Facebook Anda → <strong class="font-semibold text-[#111111]">Settings &amp; Privacy → Settings → Apps and Websites</strong> → pilih aplikasi <strong class="font-semibold text-[#111111]">{storeName} / MCP-1 (App ID: 1659770785737622)</strong> → klik <strong class="font-semibold text-[#111111]">Remove</strong>.
        </p>
        <p>
          <strong class="font-semibold text-[#111111]">Permintaan Hapus Data Server:</strong> Masukkan nomor telepon/WhatsApp atau ID pesanan di bawah ini untuk membuat tiket penghapusan data permanen dari basis data kami:
        </p>
      </div>

      <form id="delForm" class="mt-3 flex gap-2">
        <label for="delInput" class="sr-only">Nomor WA, Email, atau ID Pesanan</label>
        <input
          id="delInput"
          type="text"
          required
          placeholder="Nomor WA / Email / ID Pesanan"
          class="min-h-9 flex-1 border border-[#111111] bg-white px-3 py-1.5 text-xs text-[#111111]"
        />
        <button
          type="submit"
          class="shrink-0 border border-[#111111] bg-[#111111] px-3 py-1.5 text-xs font-bold text-white"
        >
          Kirim Permintaan
        </button>
      </form>
      <p id="delResult" class="mt-2 hidden border border-[#E5E5E5] bg-[#FAFAFA] p-2.5 text-xs text-[#111111]" role="status"></p>
    </section>

    <!-- Footer Ringkas -->
    <footer class="bg-[#FAFAFA] px-5 py-4 text-center text-[11px] text-[#767676] tabular-nums">
      © {new Date().getFullYear()} {storeName} · App ID 1659770785737622 · Business ID 1167683925394352 · Pixel ID 1640621550357874
    </footer>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.copy-url-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const val = btn.getAttribute('data-copy') || '';
        if (!val) return;
        try {
          await navigator.clipboard.writeText(val);
          const prev = btn.textContent;
          btn.textContent = 'Tersalin';
          setTimeout(() => {
            btn.textContent = prev || 'Salin';
          }, 1500);
        } catch {}
      });
    });

    const delForm = document.getElementById('delForm') as HTMLFormElement | null;
    const delInput = document.getElementById('delInput') as HTMLInputElement | null;
    const delResult = document.getElementById('delResult');
    delForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = (delInput?.value || '').trim();
      if (!val || !delResult) return;
      delResult.textContent = `Permintaan penghapusan data untuk "${val}" (Tiket #DEL-1659770785737622) telah diterima dan diproses.`;
      delResult.classList.remove('hidden');
    });
  </script>
</BaseLayout>
