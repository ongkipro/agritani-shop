---
/**
 * Native Landing Page: Booster Anggrek, Aglonema & Monstera (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/booster-anggrek-aglonema-monstera.css';

export const prerender = false;

const SLUG = 'booster-anggrek-aglonema-monstera';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/booster-anggrek-aglonema-monstera/hero-problem.webp';
---

<BaseLayout
  title={`Booster Serum Anggrek, Aglonema & Monstera: Solusi Cepat Berbunga & Daun Rimbun Tebal | ${Astro.locals.tenant.name}`}
  description="Solusi tanaman hias mogok berbunga, daun pucat loyo, dan monstera kerdil sulit robek. Formula serum asam amino murni teknologi Jepang tanpa bau amis."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">JANGAN DIBUANG DULU!</span>
          Tanaman Hias Mandek Dijamin <span class="hl-brush">PECAH TUNAS & MEKAR</span> Rimbun Mewah
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup semprot kabut & kocor akar dengan <strong class="text-slate-950 font-bold">SARATOGA</strong>, spike anggrek mekar serempak hingga 3 bulan, daun aglonema merah merona tebal, dan monstera melesat cepat robek raksasa tanpa bikin daun gosong!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan tanaman hias kusam mandek vs anggrek berbunga lebat dan aglonema monstera segar mewah sehabis aplikasi SARATOGA"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Hasil Nyata: Anggrek pecah spike bunga lebat, aglonema merah tebal mengilap, monstera robek raksasa!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Formula Bersih Tanpa Amis</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Aman Indoor & Teras</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Bangunkan mata tunas & picu 2–3 spike anggrek mekar serempak</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tebalkan daun aglonema merah menyala & pacu anakan caling</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Percepat bukaan daun baru monstera berfenestrasi lebar simetris</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Serum jernih bebas bau amis, aman disemprot di ruang tamu & balkon</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Paket Booster Tanaman Hias — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Penyebab Tanaman Hias <span class="hl-brush-red">Mandek Berbunga & Daun Loyo</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Kenapa koleksi anggrek, aglonema, dan monstera mogok tumbuh meski rutin disiram:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-anggrek-aglonema-monstera/gejala-1.webp"
              alt="Akar tanaman hias terbakar kerak garam pupuk kimia dan anggrek mogok berbunga"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Akar Terkunci & Mogok Spike
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Endapan Pupuk Kimia Membakar Akar & Mengunci Bunga</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Pupuk butiran kimia meninggalkan kerak garam asam di pot yang menghitamkan ujung akar, sementara kurangnya L-Prolin & Boron membuat anggrek malas mengeluarkan tangkai bunga.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-anggrek-aglonema-monstera/gejala-2.webp"
              alt="Warna merah daun aglonema memudar pucat dan daun monstera kerdil gagal robek"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Warna Pudar & Daun Kerdil Polos
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Aglonema Pucat Loyo & Monstera Gagal Membelah</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Tanpa nutrisi mikro kelat dan asam amino siap serap, pigmen merah aglonema berubah hijau kusam dan daun baru monstera tumbuh kerdil polos tanpa robekan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON (Full Visual Overclaim) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Tanaman Mogok</span> Jadi <span class="hl-brush">Rimbun Berbunga</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/booster-anggrek-aglonema-monstera/overclaim-timeline.webp"
          alt="Tahapan pemulihan tanaman hias dari mandek kusam hingga pecah spike bunga dan daun raksasa dengan Saratoga"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Mandek Kusam</span>
          <span class="text-amber-300">Hari 7: Daun Mengilap</span>
          <span class="text-emerald-400">Hari 14: Pecah Spike</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/booster-anggrek-aglonema-monstera/kondisi-rusak.webp"
            alt="Kondisi tanaman hias kusam daun menguning layu dan anggrek mogok berbunga"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Daun Loyo & Mogok Bunga</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Anggrek gundul tanpa spike, aglonema kuning pucat, monstera kerdil polos.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/booster-anggrek-aglonema-monstera/kondisi-pulih.webp"
            alt="Hasil pemulihan tanaman hias anggrek berbunga mekar lebat dan aglonema monstera segar rimbun"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Bunga Lebat & Daun Raksasa</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Spike mekar tahan 3 bulan, aglonema merah tebal, monstera robek raksasa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Image -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/booster-anggrek-aglonema-monstera/saratoga-hero.webp"
          alt="Botol Serum Tanaman Premium SARATOGA Asli Dikelilingi Tanaman Hias Segar"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Segel Hologram"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original, Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            L-Prolin + Boron-Etanolamin + Kalsium Bioaktif Tanpa Bau Amis (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Serum SARATOGA</span> pada Koleksi Tanaman Hias
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Formula jernih teknologi Jepang yang nyaman disemprotkan di teras, balkon, maupun ruang tamu:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-anggrek-aglonema-monstera/overclaim-1.webp"
              alt="Spike bunga anggrek bulan mekar serempak dan tahan lama setelah disemprot Saratoga"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • PEMICU SPIKE ANGGREK
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Picu Tangkai Spike Mekar Serempak & Tahan 90 Hari!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Membangunkan mata tunas tidur agar anggrek segera mengeluarkan tangkai bunga baru dan memperbanyak knop tanpa rontok dini.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-anggrek-aglonema-monstera/overclaim-2.webp"
              alt="Daun aglonema Suksom merah menyala tebal mengilap dan pecah anakan caling"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
