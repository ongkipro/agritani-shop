          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Hasil 14 Hari: Spike baru anggrek muncul tegap, caling aglonema pecah, dan daun baru monstera membuka lebar!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Baris Praktis) -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Cara Pakai <span class="hl-brush">Super Praktis</span> di Rumah
      </h2>

      <div class="-mx-5 my-4">
        <img
          src="/images/landing/booster-anggrek-aglonema-monstera/aplikasi-kebun.webp"
          alt="Penghobi tanaman menyemprotkan kabut serum SARATOGA ke koleksi tanaman hias di teras rumah"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
