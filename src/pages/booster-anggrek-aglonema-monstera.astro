          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-anggrek-aglonema-monstera/overclaim-3.webp"
              alt="Daun baru monstera deliciosa membuka lebar dengan belahan fenestrasi simetris"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • BOOSTER DAUN MONSTERA
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Pacu Daun Baru 2x Lipat Lebih Lebar & Robek Simetris!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mempercepat pembelahan sel daun baru agar membuka raksasa dengan belahan dan lubang khas Monstera yang rapi dan kokoh.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/booster-anggrek-aglonema-monstera/macro-proof.webp"
