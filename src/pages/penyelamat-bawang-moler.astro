---
/**
 * Native Landing Page: Penyelamat Bawang Merah Moler Inul & Umbi Jumbo (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/penyelamat-bawang-moler.css';

export const prerender = false;

const SLUG = 'penyelamat-bawang-moler';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/penyelamat-bawang-moler/hero-problem.webp';
---

<BaseLayout
  title={`Penyelamat Bawang Merah Moler Inul: Daun Jegrik & Umbi Jumbo | ${Astro.locals.tenant.name}`}
  description="Hentikan penyakit moler inul jamur Fusarium dan pucuk kuning pada bawang merah dalam 24 jam. Daun berdiri kaku jegrik menghadap langit, umbi merah merona super jumbo tahan susut simpan."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Clean, Punchy, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">BAHAYA MOLER INUL & PUCUK KUNING HABIS HUJAN MALAM!</span>
          Hentikan Layu Putar dalam 24 Jam, Tegakkan Daun Kaku Seperti Jarum & Cetak <span class="hl-brush">UMBI JUMBO MERAH MERONA</span> Tanpa Efek Kerdil!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup semprot kabut <strong class="text-slate-950 font-bold">BENSU</strong> sejak 10 HST, luka jamur Fusarium di leher umbi langsung mengering, daun pipa berdiri tegap jegrik berlapis lilin anti-air hujan, pecah 14–16 siung padat tahan simpan askip!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Dokumentasi tanaman bawang merah subur daun kaku jegrik menghadap langit dan umbi merah besar sehabis semprot BENSU"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              95% Bebas Moler: Daun kaku jegrik dalam 24 jam, umbi padat merah menyala rekor 12–14 ton/Ha!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Bio-Silika + Humat Anti-Fusarium</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
          <span class="text-slate-300">•</span>
          <span>Segel Hologram & Shieldtag Resmi</span>
        </div>

        <div class="mx-5 mt-4 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[12px] font-semibold text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Keringkan luka jamur Fusarium di leher umbi & stop layu putar (nginul) dalam 24 jam</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tegakkan helai daun pipa kaku jegrik berlapis lilin tanpa efek kerdil paclobutrazol</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Pecah anakan 14–16 siung serempak & pompa umbi merah tembaga super jumbo</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
              <span>Tekan susut timbangan simpan di gudang para-para (askip) di bawah 6%</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-[#14532D] px-4 py-2.5 text-center text-[13px] font-bold text-white shadow-sm transition-transform active:scale-[0.99]"
          >
            <span>Pesan Paket Penyelamat Bawang BENSU — Bisa COD</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Bahaya Mematikan <span class="hl-brush-red">Moler Inul Saat Tanah Becek</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Kenapa daun bawang merah tiba-tiba melintir rebah, pucuk menguning terbakar, dan leher umbi membusuk sehabis hujan malam:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-bawang-moler/gejala-1.webp"
              alt="Daun bawang merah melintir nginul dan menguning rebah di lahan basah"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Daun Terpelintir Inul & Rebah
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Serangan Jamur Fusarium oxysporum di Leher Umbi</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Tanah becek jenuh air asam memicu spora jamur merusak pembuluh leher batang sehingga daun meliuk-liuk abnormal (nginul), ujung menguning, dan rebah dalam semalam.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-bawang-moler/gejala-2.webp"
              alt="Umbi bawang merah kerdil lembek berair dan cepat busuk di gudang simpan"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Umbi Lembek & Busuk Gudang
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Umbi Gagal Membesar & Kempes Saat Disimpan</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Saat daun rebah dan pucuk mengering di usia 20–35 HST, kiriman karbohidrat ke siung berhenti total. Umbi jadi kerdil berair dan busuk kempes di gudang para-para.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Nyata: <span class="hl-brush-red">Daun Nginul</span> Jadi <span class="hl-brush">Jegrik Kaku</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/penyelamat-bawang-moler/overclaim-timeline.webp"
          alt="Tahapan pemulihan bawang merah dari gejala moler hingga daun jegrik dan umbi jumbo dengan Bensu"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Mulai Nginul</span>
          <span class="text-amber-300">24 Jam: Luka Kering</span>
          <span class="text-emerald-400">Hari 4: Jegrik & Jumbo</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/penyelamat-bawang-moler/kondisi-rusak.webp"
            alt="Kondisi daun bawang merah melintir inul leher membusuk rebah di tanah"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Kena Moler
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Daun Nginul Melintir</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Leher batang lembek berair, tanaman rebah di tanah & umbi kerdil.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/penyelamat-bawang-moler/kondisi-pulih.webp"
            alt="Kondisi daun bawang merah kaku jegrik menghadap langit bebas moler"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai BENSU
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">Daun Jegrik Kaku</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Daun tegak lurus seperti jarum, siung pecah 14–16 umbi merah padat.
            </p>
          </div>
        </div>
      </div>

      <!-- HEAD-TO-HEAD COMPETITOR-KILLER MATRIX -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-50/80 shadow-sm">
        <div class="bg-slate-950 px-4 py-3 text-center">
          <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            FAKTA LAPANGAN: JANGAN SALAH SEMPROT!
          </span>
          <h3 class="mt-1 text-[15px] font-bold leading-snug text-white">
            Mengapa Oplosan Obat Biasa Gagal Total vs Keunggulan Mutlak BENSU?
          </h3>
        </div>

        <div class="divide-y divide-slate-200 text-[12px]">
          <div class="grid grid-cols-2 bg-slate-100 font-bold text-slate-900">
            <div class="border-r border-slate-200 p-2.5 text-red-700">
              ✗ Oplos 3–4 Fungisida Kimia Panas & ZPT Biasa
            </div>
            <div class="p-2.5 text-emerald-900">
              ✓ BENSU Bio-Silika + Humat Anti-Fusarium
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Pucuk Kuning Terbakar:</strong>
              Dosis kimia panas membuat ujung daun bawang gosong kering dan fotosintesis macet di umur 20 HST.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Formula Dingin L-Amino 16,5%:</strong>
              Menghentikan mati pucuk kuning dalam 48 jam dan menyalakan klorofil hijau kebiruan.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Daun Lembek Mudah Moler:</strong>
              ZPT daun biasa memicu sel daun berair tipis sehingga makin gampang lonyot moler saat hujan malam.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Tegak Kaku Tanpa Efek Kerdil:</strong>
              Bio-Silika menegakkan pipa daun kaku seperti jarum & mengeringkan luka leher umbi dalam 24 jam.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Luntur Terbilas Hujan:</strong>
              Tidak punya perekat alami; baru disemprot pagi, siang turun hujan langsung luntur sia-sia.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Penembus Yucca Saponin:</strong>
              Menempel instan di daun bawang yang licin berlilin dan tahan guyuran hujan deras.
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="border-r border-slate-200 p-2.5 text-slate-600 leading-snug">
              <strong class="block text-slate-900">Umbi Kecil & Susut >25%:</strong>
              Penekan tumbuh kimia (paclobutrazol) mengunci akar sehingga siung sedikit dan kempes di gudang.
            </div>
            <div class="bg-emerald-50/40 p-2.5 text-slate-800 leading-snug">
              <strong class="block text-emerald-950">Pecah 14–16 Siung Jumbo:</strong>
              Memompa pati penuh ke umbi, warna merah tembaga menyala & susut askip di bawah 6%!
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Image -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/penyelamat-bawang-moler/bensu-hero.webp"
          alt="Botol Pupuk Organik Cair BENSU di Hamparan Tanaman Bawang Merah Subur"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram + Shieldtag Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi BENSU Segel Hologram dan Shieldtag Anti-Palsu"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <span class="inline-block rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">
            GARANSI 100% ORIGINAL • SHIELDTAG RESMI
          </span>
          <p class="mt-1 text-[12px] font-bold text-emerald-950">BENSU Asli Segel Hologram & Kode Verifikasi Shieldtag</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Waspada pupuk cair palsu/oplosan Rp 30rb–50rb berisi air warna di marketplace! BENSU resmi dilengkapi segel hologram & Shieldtag terverifikasi (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Nutrisi Seluler BENSU</span> Penegak Daun Bawang
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Memperkuat jaringan leher umbi dan helai daun bawang merah di lahan basah maupun gadu:
      </p>

      <!-- 3 Big Visual Overclaim Cards -->
      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-bawang-moler/overclaim-1.webp"
              alt="Daun bawang merah berdiri kaku jegrik menghadap langit bebas moler inul"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • 95% BEBAS MOLER FUSARIUM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Daun Kaku Jegrik Menghadap Langit Seperti Jarum!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Membentengi leher umbi dari penetrasi jamur tular tanah dalam 24 jam dan menegakkan daun pipa kokoh meski bedengan jenuh air hujan malam.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-bawang-moler/overclaim-2.webp"
              alt="Umbi bawang merah padat merah tembaga super jumbo merata"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • UMBI MERAH MENYALA JUMBO
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Pecah 14–16 Siung Serentak & Padat Berbobot!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Mempercepat aliran sari makanan dari daun ke cakram umbi sehingga siung membelah banyak, bulat seragam dengan warna merah tembaga menyala.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-bawang-moler/overclaim-3.webp"
              alt="Ikatan panen bawang merah kering askip padat tahan simpan di gudang"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • SUSUT SIMPAN DI BAWAH 6%
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Umbi Kering Padat Beraroma Tajam Diserbu Bakul!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kadar air umbi terkontrol padat sehingga tidak mudah kempes atau busuk saat digantung di gudang para-para (askip).
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
