---
/**
 * Native Landing Page: Penyelamat Bunga Rontok, Anti-Lalat Buah & Pelebat Buah 2X Bobot (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/penyelamat-bunga-rontok-pelebat-buah-saratoga.css';

export const prerender = false;

const SLUG = 'penyelamat-bunga-rontok-pelebat-buah-saratoga';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const trialVariant = product.variants.find((v) => /250\s*ml/i.test(v.label));
const oneLiterVariant = product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label));
const twoLiterVariant = product.variants.find((v) => /2\s*liter|\b2\s*l\b/i.test(v.label));
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/hero-problem.webp';
---

<BaseLayout
  title={`Penyelamat Bunga Rontok 48 Jam & Pelebat Buah 2X Bobot Tanpa Bau Amis: SARATOGA - ${Astro.locals.tenant.name}`}
  description="Stop biarkan modal puluhan juta rontok di atas mulsa! Kunci 98% tangkai bunga anti-rontok dalam 48 jam, paksa dompolan buah cabai, tomat & buah tahunan meledak 2X bobot tanpa bau amis pengundang lalat buah dengan SARATOGA Serum Jepang."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Ultra-Clean, Brutal Overclaim, Fast Scan) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-[11px] font-bold tracking-wide text-white shadow-sm">
          DARURAT MODAL KEBUN RONTOK DI ATAS MULSA!
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[28px] font-bold leading-[1.14] tracking-tight text-slate-950">
          Kunci 98% Bunga <span class="hl-brush-red">Anti-Rontok 48 Jam</span> & Ledakkan <span class="hl-brush">BUAH LEBAT 2X BOBOT!</span>
        </h1>
        <p class="mx-auto mt-2.5 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          1 Tutup <strong class="text-slate-950 font-bold">SARATOGA Serum Jepang</strong> (L-Amino + K-P-Boron + GA3): las cincin tangkai bunga kebal hujan malam, 100% tanpa bau amis (0% lalat buah) & cair murni anti mampet spuyer!
        </p>
      </div>

      <div class="mt-4">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan bunga cabai dan buah gugur di atas mulsa vs tangkai bunga terkunci kokoh dan dompolan buah lebat mengkilap dengan Saratoga"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/90 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#4ADE80]">
              48 JAM TANGKAI KEKAR: 98% Bunga Jadi Pentil • 0% Bau Amis • Bobot Naik 2X!
            </p>
          </div>
        </div>

        <!-- Clean 3-Chip Brutal Value Strip -->
        <div class="mx-4 mt-3.5 grid grid-cols-3 gap-2 text-center">
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">48 Jam</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Las Tangkai Bunga</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">0% Amis</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Bebas Lalat Buah</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">3-in-1 Cair</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Anti Mampet Spuyer</p>
          </div>
        </div>

        <div class="mx-4 mt-3.5 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Kunci 98% Bunga & Pentil</strong> — hentikan gugur bunga saat hujan angin & stres cuaca</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>100% Tanpa Bau Amis</strong> — tidak memancing lalat buah penyuntik ulat & busuk patek</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>100% Cair Larut Instan</strong> — ganti ribet oplos MKP + Kalsium + Boron penyumbat spuyer</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Pompa Daging Buah Padat 2X</strong> — kulit tebal mengkilap lolos timbangan Grade A</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[48px] w-full items-center justify-center rounded-xl bg-[#14532D] px-4 py-3 text-center text-[14px] font-bold text-white shadow-md transition-colors hover:bg-[#166534]"
          >
            SELAMATKAN BUNGA & BUAH SEKARANG (MULAI {formatIdr(trialVariant?.price ?? 75000)}) →
          </a>
          <p class="mt-2 text-center text-[11px] font-semibold text-emerald-950">
            Tersedia Kemasan Coba 250ml ({formatIdr(trialVariant?.price ?? 75000)}) & Paket Laris 500ml ({formatIdr(preferredVariant?.price ?? 135000)}) — Bisa COD!
          </p>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (Luka Kerugian Kebun - Minimal Text, Brutal Visuals) -->
    <section class="bg-red-50/40 px-5 py-7">
      <div class="text-center mb-4">
        <span class="inline-block rounded bg-red-100 px-2.5 py-0.5 text-[10px] font-bold text-red-800">
          KENAPA MODAL KEBUN JUTAAN RUPIAH BISA LUDES?
        </span>
        <h2 class="mt-1 text-[24px] font-bold leading-tight tracking-tight text-slate-950">
          2 Bencana <span class="hl-brush-red">Perampok Hasil Panen Petani</span>
        </h2>
      </div>

      <div class="space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/gejala-1.webp"
              alt="Ribuan bunga dan pentil buah cabai menguning patah rontok berserakan di atas plastik mulsa habis hujan malam"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent p-3">
              <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
                KERUGIAN 1 • BUNGA & PENTIL GUGUR DI ATAS MULSA
              </span>
              <h3 class="mt-1 text-[14px] font-bold text-white leading-tight">
                3 Bulan Rawat Habis Puluhan Juta, Rontok Berserakan Semalam Habis Hujan!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-600 leading-snug">
            Cuaca ekstrem memicu hormon etilen perontok tangkai; tiap 1 bunga gugur = uang panen hilang di tanah.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/gejala-2.webp"
              alt="Buah cabai dan mangga busuk berulat disengat lalat buah akibat bau amis pupuk asam amino ikan dan spuyer mampet endapan bubuk"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent p-3">
              <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
                KERUGIAN 2 • ASAM AMINO AMIS UNDANG LALAT BUAH & BUBUK MAMPET
              </span>
              <h3 class="mt-1 text-[14px] font-bold text-white leading-tight">
                Niat Lebatkan Buah Pakai Pupuk Ikan Murah, Malah Panggil Lalat Buah & Busuk Berulat!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-600 leading-snug">
            Bau amis memancing ribuan lalat buah menyuntik telur, sementara oplosan bubuk kapur menyumbat spuyer tangki.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950">
        Bukti 48 Jam: <span class="hl-brush-red">Rontok Parah</span> Jadi <span class="hl-brush">Dompolan Penuh</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-4 relative bg-slate-950">
        <img
          src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/overclaim-timeline.webp"
          alt="Tahapan penyelamatan bunga cabai dan buah dari rontok kuning menjadi tangkai hijau kekar 48 jam dan dompolan buah merah padat dengan Saratoga"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Jam 0: Rontok Mulsa</span>
          <span class="text-amber-300">48 Jam: Cincin Terkunci</span>
          <span class="text-emerald-400">Panen: Berat 2X Lipat</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-red-200 bg-red-50/30 shadow-sm">
          <img
            src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/kondisi-rusak.webp"
            alt="Tanaman cabai tanpa Saratoga bunga rontok berserakan dan buah busuk tersengat lalat buah"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="p-2.5 text-center">
            <h3 class="text-[12px] font-bold text-red-950">Gugur & Busuk Ulat</h3>
            <p class="mt-0.5 text-[11px] text-slate-600">Ruas ompong & panen anjlok</p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-300 bg-emerald-50/50 shadow-sm">
          <img
            src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/kondisi-pulih.webp"
            alt="Tanaman cabai dan buah pakai Saratoga setiap ketiak cabang mengikat dompolan buah padat mengkilap"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai SARATOGA
          </div>
          <div class="p-2.5 text-center">
            <h3 class="text-[12px] font-bold text-emerald-950">98% Jadi Buah Grade A</h3>
            <p class="mt-0.5 text-[11px] text-emerald-900 font-semibold">Padat berbobot & 0% lalat buah</p>
          </div>
        </div>
      </div>

      <!-- Competitor-Killer Head-to-Head Matrix (Clean 1-Line Scan) -->
      <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-2 bg-slate-900 text-[12px] font-bold text-white">
          <div class="p-2.5 text-red-300 border-r border-slate-800">✗ Pupuk Ikan Amis & Oplos Bubuk</div>
          <div class="p-2.5 text-[#4ADE80]">✓ SARATOGA 3-in-1 Serum Jepang</div>
        </div>
        <div class="divide-y divide-slate-200 text-[12px] leading-snug">
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Bau amis panggil lalat buah</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">100% Tanpa Bau Amis (0% Ulat)</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Tangkai bunga tetap rontok hujan</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Las cincin tangkai dalam 48 jam</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Endapan kapur sumbat spuyer</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">100% Cair murni tembus 2 jam</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Buah kopong ringan & kulit tipis</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Daging buah padat berat 2X lipat</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS (Clean Overlay Cards) -->
    <section class="bg-slate-50/70 px-5 py-7">
      <div class="-mx-5 mb-4 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/saratoga-hero.webp"
          alt="Botol resmi SARATOGA Serum Asam Amino Jepang Pelebat Buah dan Pengunci Bunga Original"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Shieldtag Badge -->
      <div class="mb-5 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Segel Hologram Shieldtag Anti-Pemalsuan"
          class="h-12 w-12 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original — Segel Hologram Resmi</p>
          <p class="text-[11px] text-slate-600 leading-tight">
            Japanese Odorless L-Amino + K-P-Boron + GA3 Aktif (250ml, 500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950 mb-4">
        3 Reaksi Brutal <span class="hl-brush">SARATOGA di Kebun</span>
      </h2>

      <!-- 3 Clean Visual Overclaim Cards -->
      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-950">
            <img
              src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/overclaim-1.webp"
              alt="Cincin tangkai bunga cabai dan buah menebal hijau kekar mengikat pentil buah anti rontok dalam 48 jam"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 1 • LAS TANGKAI BUNGA ANTI-RONTOK 48 JAM
              </span>
              <h3 class="mt-1 text-[15px] font-bold text-white leading-tight">
                98% Bunga Mengunci Jadi Pentil Buah Kebal Guyuran Hujan Malam!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-700 leading-snug">
            Boron + GA3 + L-Prolin mempertebal cincin tangkai bunga sekuat kawat anti gugur.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-950">
            <img
              src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/overclaim-2.webp"
              alt="Dompolan buah cabai merah besar, tomat, dan mangga mulus mengkilap bebas sengatan lalat buah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 2 • 100% TANPA BAU AMIS = 0% LALAT BUAH
              </span>
              <h3 class="mt-1 text-[15px] font-bold text-white leading-tight">
                Kulit Buah Tebal Mengkilap Mulus Tanpa Busuk Berulat & Patek!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-700 leading-snug">
            Asam amino Jepang murni tidak berbau bangkai sehingga lalat buah tidak datang menyengat.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-950">
            <img
              src="/images/landing/penyelamat-bunga-rontok-pelebat-buah-saratoga/overclaim-3.webp"
              alt="Daging buah cabai dan tomat super tebal padat berbobot berat di atas timbangan panen"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                REAKSI 3 • POMPA DAGING BUAH PADAT BERBOBOT 2X
              </span>
              <h3 class="mt-1 text-[15px] font-bold text-white leading-tight">
                1 Karung Lebih Berat +6 Kg & Rebutan Bakul Harga Tertinggi!
              </h3>
            </div>
          </div>
          <p class="px-3 py-2 text-[12px] text-slate-700 leading-snug">
            Kalium + Fosfat ionik memompa pati gula ke dalam buah hingga padat berisi tanpa kopong.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Kotak Singkat) -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950">
        Takaran Irit <span class="hl-brush">2 Tutup / Tangki 16L</span>
