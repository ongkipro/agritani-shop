  <StickyLandingCtaBar
    ctaText="Pesan SARATOGA Pengunci Bunga & Pelebat Buah — COD"
    subText={`Mulai 250ml ${formatIdr(trialVariant?.price ?? 75000)} / 500ml ${formatIdr(preferredVariant?.price ?? 135000)} • Tersedia 1L & 2L`}
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
