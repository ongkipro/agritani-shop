---
/**
 * Native Landing Page: Serum Tanaman Hias, Pemecah Spike Anggrek & Mutasi Merah Aglonema (SARATOGA)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/serum-tanaman-hias-anggrek-aglonema-saratoga.css';

export const prerender = false;

const SLUG = 'serum-tanaman-hias-anggrek-aglonema-saratoga';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/serum-tanaman-hias-anggrek-aglonema-saratoga/hero-problem.webp';
---

<BaseLayout
  title={`Serum Anggrek Pecah 3 Spike 14 Hari & Mutasi Merah Aglonema Tanpa Bau Amis: SARATOGA - ${Astro.locals.tenant.name}`}
  description="Ubah anggrek sayur mogok bunga jadi pecah 2-3 spike mekar lebat dalam 14 hari, kunci kuncup anti bud-blast, dan pompakan daun Aglonema merah merona mengkilap tanpa bercak putih & 100% tanpa bau amis dengan SARATOGA."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Ultra-Clean, Brutal Overclaim, Fast Scan) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-[11px] font-bold tracking-wide text-white shadow-sm">
          STOP KOLEKSI ANGGREK SAYUR & AGLONEMA KERDIL PUCAT!
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[28px] font-bold leading-[1.14] tracking-tight text-slate-950">
          Paksa Anggrek <span class="hl-brush">PECAH 3 SPIKE 14 HARI</span> & Aglonema Merah Menyala — <span class="hl-brush-red">Tanpa Bau Amis!</span>
        </h1>
        <p class="mx-auto mt-2.5 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup 2 ml/liter <strong class="text-slate-950 font-bold">SARATOGA Japanese Odorless Serum</strong>: bangunkan mata tidur anggrek mogok bunga, kunci kuncup anti rontok (<em>bud blast</em>), dan cetak daun mengkilap bebas kerak putih kapur!
        </p>
      </div>

      <div class="mt-4">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan anggrek gundul mogok bunga dan aglonema pucat vs anggrek pecah 3 tangkai spike mekar lebat dan aglonema merah merona mengkilap dengan Saratoga"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/90 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#4ADE80]">
              14 HARI PECAH SPIKE: Mekar Awet 90 Hari • Daun Kilap Tanpa Kerak • 0% Bau Amis!
            </p>
          </div>
        </div>

        <!-- Clean 3-Chip Brutal Value Strip -->
        <div class="mx-4 mt-3.5 grid grid-cols-3 gap-2 text-center">
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">14 Hari</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Pecah 2–3 Spike</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">0% Amis</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Bersih di Teras</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-bold text-emerald-950">0% Kerak</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Daun Mulus Kontes</p>
          </div>
        </div>

        <div class="mx-4 mt-3.5 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>14 Hari Pecah Spike Serempak</strong> — bangunkan anggrek Bulan, Dendro & Cattleya mogok bunga</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Pompa Mutasi Merah & Daun Jumbo</strong> — cegah daun baru Aglonema mengecil (<em>ngerdil</em>) & pucat</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Akar Jalan & Tunas Bonggol Cepat</strong> — 99% cacah bonggol selamat bebas lonyot bakteri</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Bening Murni Tanpa Bau & Kerak</strong> — bebas bercak putih kapur & bebas semut/lalat media</span>
            </li>
          </ul>

          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[48px] w-full items-center justify-center rounded-xl bg-[#14532D] px-4 py-3 text-center text-[14px] font-bold text-white shadow-md transition-colors hover:bg-[#166534]"
