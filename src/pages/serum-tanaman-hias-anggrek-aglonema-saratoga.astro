          <p class="text-[12px] font-bold text-emerald-950">SARATOGA Original — Japanese Odorless Serum</p>
          <p class="text-[11px] text-slate-600 leading-tight">
            L-Prolin + Boron-GA3 + Kalium Pigmen Tanpa Garam Pembakar Akar (250ml, 500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950 mb-4">
        3 Reaksi Brutal <span class="hl-brush">SARATOGA Pada Tanaman Hias</span>
      </h2>

      <!-- 3 Clean Visual Overclaim Cards -->
      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-950">
            <img
              src="/images/landing/serum-tanaman-hias-anggrek-aglonema-saratoga/overclaim-1.webp"
              alt="Batang anggrek Bulan dan Dendrobium tua pecah 3 tangkai spike baru dengan ujung akar velamen hijau segar"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
