            <h3 class="text-[12px] font-bold text-emerald-950">Mekar Kontes & Menyala</h3>
            <p class="mt-0.5 text-[11px] text-emerald-900 font-semibold">Full spike & 100% bebas amis</p>
          </div>
        </div>
      </div>

      <!-- Competitor-Killer Head-to-Head Matrix (Clean 1-Line Scan) -->
      <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-2 bg-slate-900 text-[12px] font-bold text-white">
          <div class="p-2.5 text-red-300 border-r border-slate-800">✗ Vitamin B1, Bubuk & POC Amis</div>
          <div class="p-2.5 text-[#4ADE80]">✓ SARATOGA Japanese Odorless</div>
        </div>
        <div class="divide-y divide-slate-200 text-[12px] leading-snug">
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Cuma anti-stres, gak pecah spike</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Pecah 2–3 spike dalam 14 hari</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Bercak kerak putih merusak daun</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">100% Bening murni kilap kontes</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Bau amis undang semut & lalat</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">100% Tanpa Bau Amis di teras</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Garam NPK bakar ujung akar</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Akar jalan & tunas bonggol cepat</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS (Clean Overlay Cards) -->
    <section class="bg-slate-50/70 px-5 py-7">
      <div class="-mx-5 mb-4 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/serum-tanaman-hias-anggrek-aglonema-saratoga/saratoga-hero.webp"
          alt="Botol resmi SARATOGA Japanese Odorless Serum untuk Anggrek, Aglonema dan Monstera"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Shieldtag Badge -->
      <div class="mb-5 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi SARATOGA Segel Hologram Shieldtag Anti-Pemalsuan"
          class="h-12 w-12 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
