      <h2 class="text-center text-[24px] font-bold leading-tight tracking-tight text-slate-950">
        Bukti 14 Hari: <span class="hl-brush-red">Mogok Bunga</span> Jadi <span class="hl-brush">Full Spike & Merona</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-4 relative bg-slate-950">
        <img
          src="/images/landing/serum-tanaman-hias-anggrek-aglonema-saratoga/overclaim-timeline.webp"
          alt="Tahapan kebangkitan anggrek dan aglonema dari hari 0 mogok bunga hingga hari 7 akar jalan dan hari 14 pecah spike mekar lebat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 0: Mogok Spike</span>
          <span class="text-amber-300">Hari 7: Akar Hijau Jalan</span>
          <span class="text-emerald-400">14 Hari: Pecah 3 Spike</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-red-200 bg-red-50/30 shadow-sm">
          <img
            src="/images/landing/serum-tanaman-hias-anggrek-aglonema-saratoga/kondisi-rusak.webp"
            alt="Anggrek gundul tanpa bunga dan aglonema kusam pucat tanpa Saratoga"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa SARATOGA
          </div>
          <div class="p-2.5 text-center">
            <h3 class="text-[12px] font-bold text-red-950">Anggrek Sayur & Pucat</h3>
            <p class="mt-0.5 text-[11px] text-slate-600">Macet spike & daun berkerak</p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-300 bg-emerald-50/50 shadow-sm">
          <img
            src="/images/landing/serum-tanaman-hias-anggrek-aglonema-saratoga/kondisi-pulih.webp"
            alt="Anggrek mekar rimbun dan aglonema merah menyala mengkilap dengan Saratoga"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
