              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
