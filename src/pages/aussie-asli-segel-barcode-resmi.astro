---
/**
 * Native Landing Page: Pupuk Organik Cair AUSSIE Asli Segel Barcode Resmi Pabrik
 *
 * Clean, High-Contrast Direct-Response LP (Precision Visuals & Scannable Copy)
 * Master Product: aussie-pupuk-cair-organik (ID: 26039)
 * Architecture Contract: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/aussie-asli-segel-barcode-resmi.css';

export const prerender = false;

const SLUG = 'aussie-asli-segel-barcode-resmi';

const product =
  (await getStorefrontProduct(Astro.locals, 'aussie-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '26039'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/aussie-asli-segel-barcode-resmi/hero-problem.webp';
---

<BaseLayout
  title={`Pupuk Organik Cair AUSSIE Asli Segel Barcode Resmi Pabrik - ${Astro.locals.tenant.name}`}
  description="Pastikan Anda membeli Pupuk Organik Cair AUSSIE Asli bersegel QR barcode resmi T16 Indonesia. Hati-hati barang tiruan tanpa segel yang merusak kebun sawit Anda."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-5">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white">
          PUSAT DISTRIBUSI RESMI AUSSIE ORIGINAL
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[24px] font-bold leading-[1.18] tracking-tight text-slate-950">
          Waspada Barang Tiruan! Pastikan <span class="hl-brush">AUSSIE ASLI SEGEL QR</span> Resmi Pabrik T16 Indonesia!
        </h1>
        <p class="mx-auto mt-2.5 max-w-[400px] text-[14px] font-normal leading-snug text-slate-700">
          Jangan pertaruhkan ratusan pokok sawit Anda dengan cairan palsu! Kemasan resmi dilengkapi segel QR barcode di tutup botol.
        </p>
      </div>

      <div class="mt-4">
        <div class="overflow-hidden bg-slate-950">
          <img
            src={heroImage}
            alt="Pupuk Organik Cair AUSSIE Asli Segel Barcode Resmi Pabrik"
            class="aspect-[16/9] w-full object-cover"
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="grid grid-cols-2 border-t border-slate-800 bg-slate-950 text-xs font-bold">
            <div class="border-r border-slate-800 bg-red-950/80 px-2.5 py-2 text-red-200">
              PALSU: Tanpa Segel & Pohon Rusak
            </div>
            <div class="bg-emerald-950/80 px-2.5 py-2 text-emerald-200">
              ASLI: Segel QR & Panen Melimpah
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-4 text-xs font-semibold text-slate-700">
          <span>✓ Garansi 100% Asli</span>
          <span class="text-slate-300">•</span>
          <span>✓ Segel Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>✓ Bisa COD</span>
        </div>

        <!-- Scannable 4-Point Checklist + Primary CTA -->
        <div class="mx-5 mt-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Segel QR Barcode Tutup Botol:</strong> Setiap botol memiliki ID unik resmi yang terhubung ke sistem pabrik.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Formula Asli Immune Cellactivator:</strong> Kental, beraroma khas fermentasi organik, tidak membakar akar.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Garansi Uang Kembali 100%:</strong> Jaminan pengiriman langsung dari gudang resmi Agritani.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Bisa Cek Barang Saat COD:</strong> Buka paket di depan kurir, pastikan segel QR utuh baru bayar.</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan AUSSIE Original Resmi Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION -->
    <section class="bg-red-50/40 px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        2 Bahaya Fatal <span class="hl-brush-red">Tertipu Pupuk AUSSIE Palsu</span>
      </h2>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/aussie-asli-segel-barcode-resmi/gejala-1.webp"
              alt="Cairan Palsu Hanya Air Berwarna Tanpa Nutrisi"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 1
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Cairan Palsu Hanya Air Berwarna Tanpa Nutrisi</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Barang tiruan di marketplace murah hanya berisi air pewarna dan garam yang membuat daun sawit menguning terbakar.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/aussie-asli-segel-barcode-resmi/gejala-2.webp"
              alt="Rugi Waktu 6 Bulan & Pokok Sawit Makin Rusak"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 2
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Rugi Waktu 6 Bulan & Pokok Sawit Makin Rusak</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Bukannya sembuh dari bunga jantan dan trek, tanah makin asam dan akar membusuk akibat bahan kimia oplosan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        Bukti Perubahan: <span class="hl-brush-red">Korban Barang Palsu</span> Jadi <span class="hl-brush">Hasil AUSSIE Original</span>
      </h2>

      <div class="-mx-5 mt-3.5 mb-4 overflow-hidden bg-slate-950">
        <img
          src="/images/landing/aussie-asli-segel-barcode-resmi/overclaim-timeline.webp"
          alt="Tahapan pemulihan dan panen"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 border-t border-slate-800 bg-slate-950 px-2 py-2 text-center text-xs font-bold">
          <span class="text-amber-300">Cek 1: Segel QR Tutup Utuh</span>
          <span class="text-emerald-300">Cek 2: Logo T16 Indonesia</span>
          <span class="text-emerald-400">Hasil: TBS 35+ Kg Melimpah</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
          <img
            src="/images/landing/aussie-asli-segel-barcode-resmi/kondisi-rusak.webp"
            alt="Tutup Polos & Cairan Encer"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
            Produk Palsu
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-slate-900">Tutup Polos & Cairan Encer</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-slate-600">
              Tanpa segel barcode, daun menguning, panen gagal total.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40">
          <img
            src="/images/landing/aussie-asli-segel-barcode-resmi/kondisi-pulih.webp"
            alt="Segel QR & Tandan Padat"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-xs font-bold text-white">
            AUSSIE Resmi
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-emerald-950">Segel QR & Tandan Padat</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-emerald-900">
              Bisa scan barcode resmi, pokok pulih dan buah melingkar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SHOWCASE & 3 CORE PILLARS -->
    <section class="bg-emerald-950 px-5 py-7 text-white">
      <div class="text-center">
        <span class="inline-block rounded-full bg-emerald-800 px-3 py-1 text-xs font-bold text-emerald-100">
          FORMULA BIOAKTIF RESMI
        </span>
        <h2 class="mx-auto mt-2 text-[20px] font-bold leading-[1.2] tracking-tight text-white">
          3 Keunggulan <span class="hl-brush">Ciri Kemasan AUSSIE Resmi</span>
        </h2>
      </div>

      <!-- Full-Width 16:9 Precision Product Bottle Card -->
      <div class="mt-4 overflow-hidden rounded-xl border border-emerald-700 bg-emerald-900/60 shadow-sm">
        <img
          src="/images/landing/aussie-asli-segel-barcode-resmi/aussie-hero.webp"
          alt="Kemasan Resmi AUSSIE 500ML (Segel QR Tutup Botol)"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3.5 text-center">
          <h3 class="text-[15px] font-bold text-white">Kemasan Resmi AUSSIE 500ML (Segel QR Tutup Botol)</h3>
          <p class="mt-0.5 text-xs font-normal text-emerald-200">
            T16 Indonesia • Bisa Scan Video Tutorial & Cek Keaslian
          </p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Segel Hologram QR di Tutup Botol</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Stiker segel keamanan menempel rapat di tutup ulir putih dengan kode ID.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Label Merah Maroon T16 Indonesia</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Cetakan tajam presisi dengan QR Scan Video Tutorial di bagian bawah.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Embuh Botol HYBRID TECHNOLOGY</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Botol silinder abu-putih tebal berembos timbul di bagian dasar botol.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. FARMER TESTIMONIALS -->
    <section class="bg-white px-5 py-7">
      <div class="text-center">
        <h2 class="mx-auto text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Hasil Nyata di Lapangan
        </h2>
      </div>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/aussie-asli-segel-barcode-resmi/testi-1.webp"
            alt="Pak Rusli — Kampar, Riau"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Rusli — Kampar, Riau</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Kapok Beli Murah Palsu</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Pernah tergiur harga 50 ribuan di toko sebelah, datangnya botol polos air bau comberan. Beli di sini asli ada segel QR tutupnya, baru 1 bulan sawit langsung keluar mayang betina!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/aussie-asli-segel-barcode-resmi/testi-2.webp"
            alt="Pak Marwan — Muaro Jambi, Jambi"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Marwan — Muaro Jambi, Jambi</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Asli Bersegel Hologram</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Kurir datang langsung saya cek segel QR di tutupnya persis seperti di foto. Kocor ke 50 pokok yang trek, sekarang panen rutin 1.8 ton."
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/aussie-asli-segel-barcode-resmi/testi-3.webp"
            alt="Pak Yosef — Sanggau, Kalbar"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Yosef — Sanggau, Kalbar</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Langganan Gudang Resmi</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Sudah 4 kali repeat order kemasan 1 liter. Kualitas konsisten kental dan hasil di timbangan TBS nggak pernah bohong."
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. CHECKOUT FORM SECTION -->
    <section id="checkout-form" class="scroll-mt-8 border-t border-slate-100 bg-white py-8">
      <div class="px-5 pb-5 text-center">
        <h2 class="mx-auto max-w-[360px] text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">AUSSIE Original Segel Resmi</span>
        </h2>
        <p class="mx-auto mt-1.5 max-w-[360px] text-[13px] font-normal text-slate-600">
          Pilih kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}). Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={preferredVariant?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <StickyLandingCtaBar
    ctaText="Pesan AUSSIE Resmi — Bisa COD"
    subText="Cek Segel QR Saat Barang Sampai • Garansi 100% Asli"
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
