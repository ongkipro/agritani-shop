            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="px-2.5 py-2 text-center">
            <h3 class="text-[12px] font-extrabold text-slate-900">Panen Lebat Beruntun</h3>
            <p class="text-[10px] text-slate-500">Buah padat mengkilap Grade A</p>
