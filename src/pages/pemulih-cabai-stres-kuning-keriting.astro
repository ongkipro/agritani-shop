            alt="Tajuk tanaman cabai hijau rimbun penuh trubus muda dan bakal buah"
            class="aspect-[3/2] w-full shrink-0 object-cover object-center"
            width="960"
            height="644"
            loading="lazy"
            decoding="async"
          />
          <div class="px-2.5 py-2 text-center">
            <h3 class="text-[12px] font-extrabold text-slate-900">Trubus Mulus Terus</h3>
