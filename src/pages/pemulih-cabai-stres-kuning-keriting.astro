    <!-- 7. CHECKOUT FORM SECTION: AdsBook CMS Form Hybrid -->
    <section id="checkout-form" class="scroll-mt-8 bg-white py-10">
      <div class="px-5 pb-5 text-center">
        <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-900">
          Garansi Produk Asli {product.productName} — Segel Shieldtag Resmi
        </span>
        <h2 class="mx-auto mt-2 max-w-[340px] text-[23px] font-extrabold leading-[1.15] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Pemulih Cabai Stres & Overdosis Obat</span>
        </h2>
        <p class="mx-auto mt-1.5 max-w-[340px] text-[12px] text-slate-600 leading-snug">
          Paket Default <strong>500ml ({formatIdr(preferredVariant?.price ?? product.price)})</strong> cukup 16–20 tangki semprot — atau pilih <strong>1 Liter (Rp 215.000) Lebih Hemat</strong>. Bisa COD!
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={preferredVariant?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <StickyLandingCtaBar
    ctaText="Pesan Pemulih Cabai Stres & Overdosis — Bisa COD"
    subText="Paket Hemat 500ml Rp 130.000 (16–20 Tangki) • Segel Shieldtag Asli"
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
