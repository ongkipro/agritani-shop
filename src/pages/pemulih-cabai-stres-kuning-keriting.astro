---
/**
 * Native Landing Page: Pemulih Cabai Stres Kuning, Layu & Pucuk Keriting 3x Cepat (BENSU)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: bensu-pupuk-cair-organik (ID: 21329)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/pemulih-cabai-stres-kuning-keriting.css';

export const prerender = false;

const SLUG = 'pemulih-cabai-stres-kuning-keriting';

const product =
  (await getStorefrontProduct(Astro.locals, 'bensu-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '21329'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /500\s*ml/i.test(v.label)) ??
  cheapest ??
  product.variants[0];
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/pemulih-cabai-stres-kuning-keriting/hero-problem.webp';
---

<BaseLayout
  title={`Pemulih Cabai Stres Cuaca, Overdosis Obat & Pucuk Keriting 72 Jam: BENSU - ${Astro.locals.tenant.name}`}
  description="Solusi darurat cabai stres cuaca ekstrem, overdosis/keracunan obat semprot, daun kuning layu, dan pucuk macet keriting. Pulihkan trubus hijau lebat dalam 72 jam dengan BENSU Original."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Ultra-Clean, Brutal Over-Claim, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-sm">
          DARURAT CABAI STRES CUACA & OVERDOSIS OBAT SEMPROT!
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[27px] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Pulihkan Cabai <span class="hl-brush-red">Stres Cuaca & Overdosis Obat</span> Jadi <span class="hl-brush">TRUBUS HIJAU LEBAT 72 JAM!</span>
        </h1>
        <p class="mx-auto mt-2.5 max-w-[390px] text-[13px] font-medium leading-snug text-slate-600">
          1 Tutup <strong class="text-slate-950 font-bold">BENSU Original</strong> netralisir racun overdosis pestisida, buka pucuk keriting kaku, dan bangkitkan imun cabai 3X lebih cepat.
        </p>
      </div>

      <div class="mt-4">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Perbandingan tanaman cabai menguning layu keriting stres cuaca dan overdosis obat vs pulih keluar trubus hijau lebat dalam 72 jam dengan Bensu"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/90 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-extrabold text-[#4ADE80]">
              72 JAM TRUBUS MEKAR: Racun Obat Luntur • Pucuk Keriting Buka • Bunga Mengunci!
            </p>
          </div>
        </div>

        <!-- Clean 3-Chip Brutal Value Strip -->
        <div class="mx-4 mt-3.5 grid grid-cols-3 gap-2 text-center">
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-extrabold text-emerald-950">24 Jam</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Detoks Overdosis Obat</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-extrabold text-emerald-950">72 Jam</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Buka Pucuk Keriting</p>
          </div>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 px-2 py-2">
            <p class="text-[13px] font-extrabold text-emerald-950">3X Imun</p>
            <p class="text-[10px] font-semibold text-slate-600 leading-tight">Tahan Cuaca & Mulsa</p>
          </div>
        </div>

        <div class="mx-4 mt-3.5">
          <a
            href="#checkout-form"
            class="flex min-h-[48px] w-full items-center justify-center rounded-xl bg-[#14532D] px-4 py-3 text-center text-[14px] font-extrabold text-white shadow-md transition-colors hover:bg-[#166534]"
          >
            AMBIL PAKET PEMULIH CABAI (MULAI Rp 130.000) →
          </a>
          <p class="mt-1.5 text-[11px] font-semibold text-slate-500">
            ✓ Bisa Bayar di Tempat (COD) • ✓ Segel Hologram Shieldtag Resmi
          </p>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (Clean Photo Cards, Minimal Text) -->
    <section class="bg-red-50/40 px-5 py-7">
      <div class="text-center mb-4">
        <span class="inline-block rounded bg-red-100 px-2.5 py-0.5 text-[10px] font-extrabold text-red-800">
          KENAPA CABAI MACET TOTAL & DAUN RONTOK?
        </span>
        <h2 class="mt-1 text-[22px] font-extrabold leading-tight tracking-tight text-slate-950">
          2 Pemicu <span class="hl-brush-red">Cabai Kerdil & Gagal Panen</span>
        </h2>
      </div>

      <div class="space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pemulih-cabai-stres-kuning-keriting/gejala-1.webp"
              alt="Daun cabai menguning pucat layu terkulai dan pucuk mengerut kaku keriting akibat stres cuaca dan overdosis obat"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent p-3">
              <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-extrabold text-white">
                BAHAYA 1 • OVERDOSIS / KERACUNAN OBAT SEMPROT
              </span>
              <h3 class="mt-1 text-[14px] font-bold text-white leading-tight">
                Salah Oplos Pestisida Panas: Pucuk Mengerut Kaku & Daun Terbakar!
              </h3>
            </div>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pemulih-cabai-stres-kuning-keriting/gejala-2.webp"
              alt="Tanaman cabai mandek kerdil dan bunga berguguran di atas mulsa plastik karena stres cuaca ekstrem"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent p-3">
              <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-[10px] font-extrabold text-white">
                BAHAYA 2 • STRES CUACA EKSTREM & HAWA MULSA PANAS
              </span>
              <h3 class="mt-1 text-[14px] font-bold text-white leading-tight">
                Hujan-Panas Mendadak: Imun Drop, Daun Menguning Layu & Bunga Gugur!
              </h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-center text-[22px] font-extrabold leading-tight tracking-tight text-slate-950">
        Reaksi 72 Jam: <span class="hl-brush-red">Stres & Keriting</span> Jadi <span class="hl-brush">Trubus Lebat</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-4 relative bg-slate-950">
        <img
          src="/images/landing/pemulih-cabai-stres-kuning-keriting/overclaim-timeline.webp"
          alt="Tahapan pemulihan cabai stres cuaca dan overdosis obat dari hari ke-1 hingga hari ke-3 memakai Bensu"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Jam 0: Overdosis & Kaku</span>
          <span class="text-amber-300">24 Jam: Racun Luntur</span>
          <span class="text-emerald-400">72 Jam: Trubus Mekar</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-red-200 bg-red-50/30 shadow-sm">
          <img
            src="/images/landing/pemulih-cabai-stres-kuning-keriting/kondisi-rusak.webp"
            alt="Tanaman cabai tanpa Bensu tetap menguning layu dan pucuk keriting macet"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa BENSU
          </div>
          <div class="p-2.5 text-center">
            <h3 class="text-[12px] font-extrabold text-red-950">Macet & Kerdil Total</h3>
            <p class="mt-0.5 text-[11px] text-slate-600">Pucuk mengeras & bunga rontok</p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-300 bg-emerald-50/50 shadow-sm">
          <img
            src="/images/landing/pemulih-cabai-stres-kuning-keriting/kondisi-pulih.webp"
            alt="Tanaman cabai pakai Bensu pulih dengan trubus daun hijau lebar dan bunga lebat"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai BENSU
          </div>
          <div class="p-2.5 text-center">
            <h3 class="text-[12px] font-extrabold text-emerald-950">Trubus Hijau Lebar</h3>
            <p class="mt-0.5 text-[11px] text-emerald-900 font-semibold">Pulih 72 jam & full bunga</p>
          </div>
        </div>
      </div>

      <!-- Competitor-Killer Head-to-Head Matrix (Clean 1-Line Scan) -->
      <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-2 bg-slate-900 text-[12px] font-bold text-white">
          <div class="p-2.5 text-red-300 border-r border-slate-800">✗ Dihantam Pupuk Kimia Panas</div>
          <div class="p-2.5 text-[#4ADE80]">✓ Semprot BENSU Detoks & Imun</div>
        </div>
        <div class="divide-y divide-slate-200 text-[12px] leading-snug">
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Daun overdosis makin gosong</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Cuci racun obat dalam 24 jam</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Pucuk keriting kaku tetap macet</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Buka trubus baru dalam 72 jam</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Kuning layu saat mulsa panas</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Imun 3X tahan cuaca ekstrem</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">Boros biaya obat ratusan ribu</div>
            <div class="p-2.5 font-bold text-emerald-950 bg-emerald-50/40">Irit 1 tutup/tangki (16–20 tangki)</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS (Clean Overlay Cards) -->
    <section class="bg-slate-50/70 px-5 py-7">
      <div class="-mx-5 mb-4 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/pemulih-cabai-stres-kuning-keriting/bensu-hero.webp"
          alt="Botol resmi Bensu Pupuk Cair Organik dengan Logo Timbul dan Hologram Shieldtag"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Shieldtag Badge -->
      <div class="mb-5 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi BENSU Segel Hologram Shieldtag Anti-Pemalsuan"
          class="h-12 w-12 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-extrabold text-emerald-950">BENSU Original — Botol Logo Timbul & Shieldtag</p>
          <p class="text-[11px] text-slate-600 leading-tight">
            Immune Cellactivator + Sulfur & Molibdenum Teknologi Thailand (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-center text-[22px] font-extrabold leading-tight tracking-tight text-slate-950 mb-4">
        3 Efek Brutal <span class="hl-brush">BENSU Pada Cabai Stres</span>
      </h2>

      <!-- 3 Clean Visual Overclaim Cards (Zero Clutter Below Image) -->
      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-slate-950 shadow-sm">
          <div class="relative aspect-[3/2] w-full">
            <img
              src="/images/landing/pemulih-cabai-stres-kuning-keriting/overclaim-1.webp"
              alt="Pucuk cabai yang semula keriting kaku membuka menjadi trubus daun hijau muda lebar"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-extrabold text-white">
                EFEK 1 • DETOKS OVERDOSIS OBAT & BUKA KERITING
              </span>
              <h3 class="mt-1 text-[15px] font-extrabold text-white leading-tight">
                Lunturkan Residu Pestisida Panas & Pecah Trubus Baru 72 Jam!
              </h3>
            </div>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-slate-950 shadow-sm">
          <div class="relative aspect-[3/2] w-full">
            <img
              src="/images/landing/pemulih-cabai-stres-kuning-keriting/overclaim-2.webp"
              alt="Daun cabai yang menguning dan layu kembali tegak hijau pekat mengkilap"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-extrabold text-white">
                EFEK 2 • PULIHKAN STRES CUACA & HIJAUKAN DAUN
              </span>
              <h3 class="mt-1 text-[15px] font-extrabold text-white leading-tight">
                Daun Kuning Layu Kembali Hijau Pekat Berdiri Tahan Mulsa Panas!
              </h3>
            </div>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200 bg-slate-950 shadow-sm">
          <div class="relative aspect-[3/2] w-full">
            <img
              src="/images/landing/pemulih-cabai-stres-kuning-keriting/overclaim-3.webp"
              alt="Percabangan cabai sehat penuh bunga putih dan buah cabai lebat tanpa rontok"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/65 to-transparent p-3.5">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-extrabold text-white">
                EFEK 3 • KUNCI BUNGA & LEDAKKAN BUAH CABAI
              </span>
              <h3 class="mt-1 text-[15px] font-extrabold text-white leading-tight">
                Setiap Ruas Cabang Mengikat Bunga & Pentil Cabai Tanpa Rontok!
              </h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. ULTRA-CLEAN SOP (Gambar + 3 Kotak Singkat) -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-center text-[22px] font-extrabold leading-tight tracking-tight text-slate-950">
        Takaran Irit <span class="hl-brush">1 Tutup / Tangki</span>
      </h2>

      <div class="-mx-5 my-3.5">
        <img
          src="/images/landing/pemulih-cabai-stres-kuning-keriting/aplikasi-kebun.webp"
          alt="Petani menyemprotkan kabut nutrisi Bensu pada tanaman cabai di pagi hari"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 gap-2 text-center">
        <div class="rounded-xl border border-emerald-100 bg-emerald-50/50 p-2.5">
          <span class="mx-auto flex h-5 w-5 items-center justify-center rounded-full bg-[#14532D] text-[10px] font-bold text-white">1</span>
          <p class="mt-1.5 text-[11px] font-extrabold text-slate-900">1 Tutup (30ml)</p>
          <p class="text-[10px] text-slate-600">Per tangki 16L air</p>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-emerald-50/50 p-2.5">
          <span class="mx-auto flex h-5 w-5 items-center justify-center rounded-full bg-[#14532D] text-[10px] font-bold text-white">2</span>
          <p class="mt-1.5 text-[11px] font-extrabold text-slate-900">Semprot & Kocor</p>
          <p class="text-[10px] text-slate-600">Bawah daun & mulsa</p>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-emerald-50/50 p-2.5">
          <span class="mx-auto flex h-5 w-5 items-center justify-center rounded-full bg-[#14532D] text-[10px] font-bold text-white">3</span>
          <p class="mt-1.5 text-[11px] font-extrabold text-slate-900">Tiap 3–4 Hari</p>
          <p class="text-[10px] text-slate-600">Saat darurat stres</p>
        </div>
      </div>
    </section>

    <!-- 6. VISUAL TESTIMONIALS (1-Sentence Punchy Quotes) -->
    <section class="bg-slate-50/60 px-5 py-7">
      <h2 class="text-center text-[22px] font-extrabold leading-tight tracking-tight text-slate-950">
        Bukti Petani: <span class="hl-brush">Cabai Overdosis & Keriting Pulih</span>
      </h2>

      <div class="mt-4 space-y-4">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/pemulih-cabai-stres-kuning-keriting/testi-1.webp"
            alt="Pak Wahyudi di Kediri Jawa Timur menunjukkan tanaman cabai rawit yang pulih dari keriting daun"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[13px] font-extrabold text-slate-950">Pak Wahyudi — Kediri</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-900">Sembuh Overdosis Obat</span>
            </div>
            <p class="mt-1 text-[12px] leading-snug text-slate-700">
              "Salah oplos obat bikin 3.500 cabai mengerut kaku, disemprot BENSU 2x <strong class="bg-emerald-100 px-1 text-emerald-900">3 hari langsung pecah trubus hijau mulus & bunga keluar rapat!</strong>"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/pemulih-cabai-stres-kuning-keriting/testi-2.webp"
            alt="Pak Deden di Garut Jawa Barat di kebun cabai merah besar yang sembuh dari layu dan kuning"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[13px] font-extrabold text-slate-950">Pak Deden — Garut</h3>
