---
/**
 * Native Landing Page: Booster Pengisi Umbi Bawang Merah Super Jumbo & Anti Pucuk Kuning: Saratoga
 *
 * Clean, High-Contrast Direct-Response LP (Precision Visuals & Scannable Copy)
 * Master Product: saratoga-serum-tanaman-premium (ID: 50510)
 * Architecture Contract: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/pengisi-umbi-bawang-merah-super.css';

export const prerender = false;

const SLUG = 'pengisi-umbi-bawang-merah-super';

const product =
  (await getStorefrontProduct(Astro.locals, 'saratoga-serum-tanaman-premium')) ??
  (await getStorefrontProduct(Astro.locals, '50510'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/pengisi-umbi-bawang-merah-super/hero-problem.webp';
---

<BaseLayout
  title={`Booster Pengisi Umbi Bawang Merah Super Jumbo & Anti Pucuk Kuning: Saratoga - ${Astro.locals.tenant.name}`}
  description="Hentikan daun bawang merah ngacung berlebih dan pompa seluruh nutrisi menjadi umbi bawang merah super jumbo, padat, dan merah menyala dengan SARATOGA."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-5">
        <span class="inline-block rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white">
          BOOSTER PENGISI UMBI BAWANG MERAH
        </span>
        <h1 class="mx-auto mt-2.5 max-w-[440px] text-[24px] font-bold leading-[1.18] tracking-tight text-slate-950">
          Pompa Nutrisi Daun Turun ke Akar Jadi <span class="hl-brush">UMBI BAWANG SUPER JUMBO</span> Padat & Merah Menyala!
        </h1>
        <p class="mx-auto mt-2.5 max-w-[400px] text-[14px] font-normal leading-snug text-slate-700">
          Jangan biarkan bawang merah hanya rimbun daun! Paksa seluruh sari makanan turun mengisi siung sejak umur 28 HST.
        </p>
      </div>

      <div class="mt-4">
        <div class="overflow-hidden bg-slate-950">
          <img
            src={heroImage}
            alt="Booster Pengisi Umbi Bawang Merah Super Jumbo & Anti Pucuk Kuning: Saratoga"
            class="aspect-[16/9] w-full object-cover"
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="grid grid-cols-2 border-t border-slate-800 bg-slate-950 text-xs font-bold">
            <div class="border-r border-slate-800 bg-red-950/80 px-2.5 py-2 text-red-200">
              SEBELUM: Umbi Kecil & Pucat
            </div>
            <div class="bg-emerald-950/80 px-2.5 py-2 text-emerald-200">
              SESUDAH: Siung Jumbo Merah Padat
            </div>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-4 text-xs font-semibold text-slate-700">
          <span>✓ Garansi 100% Asli</span>
          <span class="text-slate-300">•</span>
          <span>✓ Segel Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>✓ Bisa COD</span>
        </div>

        <!-- Scannable 4-Point Checklist + Primary CTA -->
        <div class="mx-5 mt-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Fokuskan Energi ke Pembesaran Siung:</strong> Hentikan vegetatif berlebih dan alihkan fotosintat langsung ke umbi.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Ukuran Umbi Seragam Kelas Super A:</strong> Dongkrak persentase umbi ukuran jumbo di atas 80% per petak.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Warna Kulit Merah Keunguan Mengkilap:</strong> Tingkatkan antosianin alami kulit umbi agar laku mahal di pasar.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">✓</span>
              <span><strong class="font-bold text-slate-950">Padat Keras & Rendah Susut Kering:</strong> Daging siung penuh berisi, tidak gampang gembos saat disimpan.</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Booster Umbi Bawang Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION -->
    <section class="bg-red-50/40 px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        2 Masalah Klasik <span class="hl-brush-red">Umbi Bawang Kecil & Gembos</span>
      </h2>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pengisi-umbi-bawang-merah-super/gejala-1.webp"
              alt="Daun Rimbun Ngacung Tapi Umbi Kecil"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 1
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Daun Rimbun Ngacung Tapi Umbi Kecil</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Kelebihan Nitrogen membuat tanaman terus memanjangkan daun sementara umbi di bawah tanah tidak mau membengkak.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/pengisi-umbi-bawang-merah-super/gejala-2.webp"
              alt="Umbi Pucat & Susut Berat Saat Dijemur"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
              MASALAH 2
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[15px] font-bold leading-snug text-slate-950">Umbi Pucat & Susut Berat Saat Dijemur</h3>
            <p class="mt-1 text-[13px] font-normal leading-snug text-slate-600">
              Pengisian sel umbi yang kurang padat membuat bobot panen hilang hingga 35% setelah dijemur kering.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE & COMPARISON -->
    <section class="bg-white px-5 py-7">
      <h2 class="text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        Bukti Perubahan: <span class="hl-brush-red">Umbi Kecil Pucat</span> Jadi <span class="hl-brush">Umbi Super Jumbo</span>
      </h2>

      <div class="-mx-5 mt-3.5 mb-4 overflow-hidden bg-slate-950">
        <img
          src="/images/landing/pengisi-umbi-bawang-merah-super/overclaim-timeline.webp"
          alt="Tahapan pemulihan dan panen"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 border-t border-slate-800 bg-slate-950 px-2 py-2 text-center text-xs font-bold">
          <span class="text-amber-300">28 HST: Leher Batang Melunak</span>
          <span class="text-emerald-300">40 HST: Siung Membengkak Keluar</span>
          <span class="text-emerald-400">55 HST: Panen Umbi Jumbo Padat</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
          <img
            src="/images/landing/pengisi-umbi-bawang-merah-super/kondisi-rusak.webp"
            alt="Kecil & Gampang Kempes"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">
            Tanpa SARATOGA
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-slate-900">Kecil & Gampang Kempes</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-slate-600">
              Umbi seukuran kelereng, warna pucat, susut jemur tinggi.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40">
          <img
            src="/images/landing/pengisi-umbi-bawang-merah-super/kondisi-pulih.webp"
            alt="Jumbo Merah Menyala"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-xs font-bold text-white">
            Pakai SARATOGA
          </span>
          <div class="p-3">
            <h3 class="text-[13px] font-bold leading-tight text-emerald-950">Jumbo Merah Menyala</h3>
            <p class="mt-1 text-xs font-normal leading-snug text-emerald-900">
              Siung besar padat merata, kulit mengkilap, timbangan berat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT SHOWCASE & 3 CORE PILLARS -->
    <section class="bg-emerald-950 px-5 py-7 text-white">
      <div class="text-center">
        <span class="inline-block rounded-full bg-emerald-800 px-3 py-1 text-xs font-bold text-emerald-100">
          FORMULA BIOAKTIF RESMI
        </span>
        <h2 class="mx-auto mt-2 text-[20px] font-bold leading-[1.2] tracking-tight text-white">
          3 Keunggulan <span class="hl-brush">Formula SARATOGA Pengisi Umbi</span>
        </h2>
      </div>

      <!-- Full-Width 16:9 Precision Product Bottle Card -->
      <div class="mt-4 overflow-hidden rounded-xl border border-emerald-700 bg-emerald-900/60 shadow-sm">
        <img
          src="/images/landing/pengisi-umbi-bawang-merah-super/saratoga-hero.webp"
          alt="SARATOGA 500ML — Serum Pengisi Umbi Bawang"
          class="aspect-[16/9] w-full object-cover"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div class="p-3.5 text-center">
          <h3 class="text-[15px] font-bold text-white">SARATOGA 500ML — Serum Pengisi Umbi Bawang</h3>
          <p class="mt-0.5 text-xs font-normal text-emerald-200">
            Japan Technology • Pembesar Siung & Pengilap Warna Merah
          </p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Translokator Karbohidrat Japan Tech</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Mempercepat aliran gula dari daun menuju pangkal umbi sejak fase generatif.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Kalium & Asam Amino Pembentuk Siung</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Memacu pembelahan sel umbi agar siung membengkak maksimal tanpa pecah.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-emerald-800 bg-emerald-900/50 p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-white">Aktivator Pigmen Merah & Aroma Tajam</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-emerald-100">Membuat warna kulit bawang merah menyala dan daya simpan gudang lebih lama.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. COMPACT SOP FIELD GUIDE -->
    <section class="bg-slate-50 px-5 py-7">
      <h2 class="text-center text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
        3 Langkah Mudah <span class="hl-brush">Dosis & Aplikasi</span>
      </h2>

      <div class="mt-4 space-y-2.5">
        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">1</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Awal Pembentukan Umbi (28–32 HST)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Semprot 2–3 ml SARATOGA per liter air untuk memulai pengisian siung.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">2</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Puncak Pembesaran (38–42 HST)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Ulangi semprotan pagi hari agar siung membengkak padat merata.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white">3</span>
          <div>
            <h3 class="text-[14px] font-bold text-slate-950">Pemadatan Akhir (48–50 HST)</h3>
            <p class="mt-0.5 text-xs font-normal leading-snug text-slate-600">Aplikasi terakhir untuk mengunci bobot dan warna merah mengkilap.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FARMER TESTIMONIALS -->
    <section class="bg-white px-5 py-7">
      <div class="text-center">
        <h2 class="mx-auto text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Hasil Nyata di Lapangan
        </h2>
      </div>

      <div class="mt-4 space-y-3.5">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/pengisi-umbi-bawang-merah-super/testi-1.webp"
            alt="Pak H.arto — Brebes, Jateng"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak H.arto — Brebes, Jateng</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Tembus Harga Tertinggi</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Umur 30 hari saya semprot SARATOGA 3 kali sampai panen. Umbinya nongol keluar tanah besar-besar semua, penebas langsung berani bayar di atas harga pasar!"
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/pengisi-umbi-bawang-merah-super/testi-2.webp"
            alt="Mas Rinto — Probolinggo, Jatim"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Mas Rinto — Probolinggo, Jatim</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Susut Kering Sangat Kecil</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Bawang Birma saya jadi padat keras banget. Dijemur 7 hari susutnya sedikit dan warnanya merah gelap mengkilap."
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img
            src="/images/landing/pengisi-umbi-bawang-merah-super/testi-3.webp"
            alt="Pak Kadir — Bima, NTB"
            class="aspect-[16/9] w-full object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-[14px] font-bold text-slate-950">Pak Kadir — Bima, NTB</h3>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">Naik 3.5 Kuintal Per Petak</span>
            </div>
            <p class="mt-1.5 text-[13px] font-normal leading-snug text-slate-700">
              "Rumpunnya pecah 14–16 siung dan ukurannya rata gede semua, hampir nggak ada bawang kricik kecilnya."
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. CHECKOUT FORM SECTION -->
    <section id="checkout-form" class="scroll-mt-8 border-t border-slate-100 bg-white py-8">
      <div class="px-5 pb-5 text-center">
        <h2 class="mx-auto max-w-[360px] text-[20px] font-bold leading-[1.2] tracking-tight text-slate-950">
          Form Pemesanan <span class="hl-brush">Booster Bawang SARATOGA Original</span>
        </h2>
        <p class="mx-auto mt-1.5 max-w-[360px] text-[13px] font-normal text-slate-600">
          Pilih kemasan resmi ({product.variants.map((v) => `${v.label} ${formatIdr(v.price)}`).join(' / ')}). Bisa bayar di tempat (COD) saat barang sampai.
        </p>
      </div>

      <GeoIpResolvedForm
        productSlug={product.slug}
        selectedVariantId={preferredVariant?.id}
        mode="hybrid"
        embedded={true}
      />
    </section>
  </main>

  <StickyLandingCtaBar
    ctaText="Pesan SARATOGA Bawang — Bisa COD"
    subText="Garansi Original Japan Technology • Bayar di Tempat"
  />

  <script slot="head" is:inline>
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element
          ? e.target.closest('a[href="#checkout-form"]')
          : null;
      if (!target) return;
      e.preventDefault();
      document
        .getElementById('checkout-form')
        ?.scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
