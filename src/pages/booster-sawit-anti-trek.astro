---
/**
 * Native Landing Page: Booster Sawit Anti-Trek & Pengisi Bobot TBS (AUSSIE)
 *
 * Visual-First Clean Direct-Response LP (High Overclaim Visuals, Concise Copy)
 * Master Product: aussie-pupuk-cair-organik (ID: 26039)
 * Kontrak Arsitektur: docs/LANDING-PAGES.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import StickyLandingCtaBar from '../components/storefront/shared/StickyLandingCtaBar.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { formatIdr } from '../lib/format-idr';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/booster-sawit-anti-trek.css';

export const prerender = false;

const SLUG = 'booster-sawit-anti-trek';

const product =
  (await getStorefrontProduct(Astro.locals, 'aussie-pupuk-cair-organik')) ??
  (await getStorefrontProduct(Astro.locals, '26039'));
if (!product) return Astro.rewrite('/404');

const socialProofOrders = await recentOrderCount(
  getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const preferredVariant =
  product.variants.find((v) => /1\s*liter|\b1\s*l\b/i.test(v.label)) ??
  product.variants[1] ??
  cheapest;
const price = preferredVariant?.price ?? cheapest?.price ?? product.price;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const heroImage = '/images/landing/booster-sawit-anti-trek/hero-problem.webp';
---

<BaseLayout
  title={`Booster Sawit Anti-Trek, Obat Buah Cengkeh & Sawit Jantan: Aussie - ${Astro.locals.tenant.name}`}
  description="Stop panen buah cengkeh, buah landak, dan bunga jantan! Buka kuncian bunga betina di tiap ketiak pelepah, dijamin sawit anti-trek dan bobot TBS naik +5 s/d +8 Kg/janjang."
  image={heroImage}
  preloadImages={heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <div data-landing-hero aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-screen"></div>
  <SocialProofToast
    orderCount={socialProofOrders}
    heroSelector="[data-landing-hero]"
    formSelector="#checkout-form"
  />
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName || product.productName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-20 text-slate-950">
    <!-- 1. HERO SECTION (Over-Claim, Competitor-Killer, Visual-First) -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          <span class="block text-red-600 mb-1.5 tracking-tight text-[18px]">STOP PANEN BUAH CENGKEH, LANDAK & BUNGA JANTAN!</span>
          Buka Kuncian Bunga Betina: Dijamin <span class="hl-brush">SAWIT ANTI-TREK</span> & Bobot TBS Meledak +5 s/d +8 KG/Janjang!
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[14px] font-normal leading-snug text-slate-700">
          Cukup kocor piringan & semprot ketiak pelepah dengan <strong class="text-slate-950 font-bold">AUSSIE</strong>: ubah buah cengkeh/landak & sawit jantan (vesipera) jadi tandan normal 30+ Kg berondol merah padat!
        </p>
      </div>

      <div class="mt-5">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/2]">
          <img
            src={heroImage}
            alt="Tandan buah segar kelapa sawit super padat melingkar penuh di ketiak pelepah sehabis aplikasi AUSSIE"
            class="h-full w-full object-cover"
            width="960"
            height="644"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2 text-center backdrop-blur-sm">
            <p class="text-[12px] font-bold text-[#BBF7D0]">
              Terbukti di Lapangan: Buah cengkeh/landak jadi normal & berat janjang di RAM naik +5 s/d +8 Kg!
            </p>
          </div>
        </div>

        <div class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 text-[11px] font-semibold text-slate-700">
          <span>Obat Buah Cengkeh & Landak</span>
          <span class="text-slate-300">•</span>
          <span>Bisa Scan Barcode Resmi</span>
          <span class="text-slate-300">•</span>
          <span>Bisa COD (Bayar di Tempat)</span>
        </div>

        <!-- 4 Point Over-Claim Checklist + Above-the-Fold CTA -->
        <div class="mx-5 mt-5 rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3.5 text-left">
          <ul class="space-y-2 text-[13px] font-normal leading-snug text-slate-800">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Ubah Buah Cengkeh & Landak Jadi Normal</strong> — berondolan terisi penuh, rapat, merah berminyak tanpa potongan sortasi RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Pulihkan Sawit Jantan / Vesipera</strong> agar setiap ketiak pelepah kembali melahirkan bunga betina melingkar penuh</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Bongkar Hara NPK Terkunci</strong> di tanah gambut, salin & mineral masam — hemat pupuk kimia sampai 40%</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-[10px] font-bold text-white">✓</span>
              <span><strong>Dongkrak Tonase +5 s/d +8 Kg/Janjang</strong> — 1 botol 1 Liter cukup untuk 1 Hektar (130 pokok sawit)</span>
            </li>
          </ul>
          <a
            href="#checkout-form"
            class="mt-3.5 flex min-h-[46px] w-full items-center justify-center rounded-lg bg-[#14532D] px-4 py-2.5 text-center text-[14px] font-bold text-white shadow-sm transition-colors hover:bg-[#166534]"
          >
            Pesan Paket Booster Anti-Trek Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 2. VISUAL PROBLEM SECTION (2 Gejala Mematikan dengan Bukti Foto) -->
    <section class="bg-red-50/35 px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        2 Biang Kerok Tonase Sawit <span class="hl-brush-red">Anjlok & Trek Panjang</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-2 mb-5">
        Sudah tabur NPK dan KCl berkarung-karung tapi buah tetap sepi dan cengkeh? Ini penyebabnya:
      </p>

      <div class="space-y-4">
        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-sawit-anti-trek/gejala-1.webp"
              alt="Ketiak pelepah kelapa sawit kosong hanya keluar bunga jantan kering saat trek panjang"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              1. Ketiak Kosong & Sawit Jantan / Vesipera
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Stres Hormon Mengubah Calon Buah Jadi Bunga Jantan</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Saat akar stres kemarau atau tanah masam mengunci hara, pohon membatalkan pembentukan bunga betina sehingga berbulan-bulan hanya keluar bunga jantan kosong.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
          <div class="relative aspect-[16/9] w-full bg-slate-900">
            <img
              src="/images/landing/booster-sawit-anti-trek/gejala-2.webp"
              alt="Tandan buah sawit menjadi buah landak kerdil cengkeh dan berondolan kempes"
              class="h-full w-full object-cover"
              width="960"
              height="536"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-2.5 top-2.5 rounded bg-red-600 px-2.5 py-0.5 text-[10px] font-bold text-white shadow">
              2. Buah Landak / Cengkeh & Janjang Enteng
            </span>
          </div>
          <div class="p-3.5">
            <h3 class="text-[14px] font-bold text-slate-950">Defisiensi Boron-Kalium & Kunci Hara di Tanah</h3>
            <p class="text-[12px] text-slate-600 mt-1 leading-snug">
              Penyerbukan gagal sempurna, tandan berduri jarang seperti bunga cengkeh (buah landak), daging mesokarp tipis, dan kena potongan sortasi tinggi di pabrik/RAM.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISUAL RECOVERY TIMELINE, COMPARISON & COMPETITOR-KILLER MATRIX -->
    <section class="bg-white px-5 py-8">
      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        Transformasi Kebun: <span class="hl-brush-red">Trek & Cengkeh</span> Jadi <span class="hl-brush">Panen Raya</span>
      </h2>

      <!-- 3-Stage Visual Progression Banner -->
      <div class="-mx-5 mt-4 mb-5 relative bg-slate-950">
        <img
          src="/images/landing/booster-sawit-anti-trek/overclaim-timeline.webp"
          alt="Progres kebun kelapa sawit dari kondisi trek kosong hingga muncul bunga betina dan TBS padat"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="grid grid-cols-3 bg-slate-950 text-center text-[11px] font-bold py-2 px-2 border-t border-slate-800">
          <span class="text-red-400">Hari 14: Akar Aktif</span>
          <span class="text-amber-300">Hari 30: Bunga Betina</span>
          <span class="text-emerald-400">Hari 60+: TBS 30+ Kg</span>
        </div>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-3">
        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
          <img
            src="/images/landing/booster-sawit-anti-trek/kondisi-rusak.webp"
            alt="Kondisi kelapa sawit trek kosong buah dan pelepah pucat"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-red-600 px-2 py-0.5 text-[10px] font-bold text-white">
            Tanpa AUSSIE
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-slate-900">Trek & Buah Cengkeh</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-500">
              Pelepah kaku pucat, bunga jantan semua, tandan landak kempes.
            </p>
          </div>
        </div>

        <div class="relative flex h-full flex-col overflow-hidden rounded-xl border border-emerald-200 bg-emerald-50/40 shadow-sm">
          <img
            src="/images/landing/booster-sawit-anti-trek/kondisi-pulih.webp"
            alt="Kondisi kelapa sawit berbuah melingkar penuh di setiap ketiak pelepah"
            class="aspect-[16/9] w-full shrink-0 object-cover"
            width="960"
            height="536"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-2 top-2 rounded bg-emerald-700 px-2 py-0.5 text-[10px] font-bold text-white">
            Pakai AUSSIE
          </div>
          <div class="flex flex-1 flex-col justify-center p-3">
            <h3 class="text-[12px] font-bold leading-tight text-emerald-900">TBS Melingkar Penuh</h3>
            <p class="mt-1 text-[11px] leading-snug text-slate-600">
              Pelepah lentur membuka, bunga betina susul-menyusul, janjang +5–8 Kg.
            </p>
          </div>
        </div>
      </div>

      <!-- Competitor-Killer Head-to-Head Matrix -->
      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-50/60 shadow-sm">
        <div class="bg-slate-900 px-3.5 py-2.5 text-center">
          <h3 class="text-[13px] font-bold text-white">
            Mengapa NPK Tunggal & ZPT Kimia Murahan Gagal vs AUSSIE?
          </h3>
        </div>
        <div class="divide-y divide-slate-200 text-[11px] leading-snug">
          <div class="grid grid-cols-2 bg-slate-100 font-bold text-slate-900">
            <div class="p-2.5 text-red-700 border-r border-slate-200">✕ Pupuk NPK Tunggal & ZPT Kimia Murahan</div>
            <div class="p-2.5 text-emerald-800 bg-emerald-50/60">✓ AUSSIE Booster Bunga Betina</div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Membatu di Tanah Gambut/Masam:</strong> Hingga 50% pupuk butiran mengendap terkunci tidak terserap akar.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Bongkar Kuncian Hara:</strong> Asam Humat-Fulvat mencairkan residu pupuk di piringan agar langsung tersedot akar.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Gagal Obati Buah Cengkeh:</strong> Tidak mengandung Boron-Kalium kelat mikro sehingga tandan tetap landak.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Tuntas Buah Cengkeh & Landak:</strong> Penyerbukan sempurna, berondolan padat berisi penuh sampai ke dalam.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Bikin Trek Makin Panjang:</strong> ZPT kimia memeras cadangan makanan pohon lalu sawit mogok berbuah 6 bulan.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">Ubah Sawit Jantan Jadi Betina:</strong> L-Prolin mengunci pembentukan bunga betina tiap ketiak pelepah tanpa putus.
            </div>
          </div>
          <div class="grid grid-cols-2">
            <div class="p-2.5 text-slate-600 border-r border-slate-200">
              <strong class="text-slate-900">Rawan Oplosan Tanpa Segel:</strong> Banyak cairan tiruan di pasaran tanpa identitas resmi.
            </div>
            <div class="p-2.5 text-slate-800 bg-emerald-50/30">
              <strong class="text-emerald-950">100% Bisa Scan Barcode:</strong> Botol resmi AUSSIE dilengkapi Barcode Verifikasi & Segel Hologram.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. PRODUCT & 3 BRUTAL VISUAL OVERCLAIMS -->
    <section class="bg-slate-50/70 px-5 py-8">
      <!-- Authentic Bottle Held by Farmer -->
      <div class="-mx-5 mb-5 overflow-hidden bg-slate-100">
        <img
          src="/images/landing/booster-sawit-anti-trek/aussie-hero.webp"
          alt="Botol Nutrisi Organik Kelapa Sawit AUSSIE Asli Dipegang Petani"
          class="aspect-[4/5] w-full object-cover object-top"
          width="960"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Compact Official Hologram & Barcode Badge -->
      <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-2.5 shadow-sm">
        <img
          src={product.heroImage}
          alt="Foto Botol Resmi AUSSIE Segel Hologram Anti-Pemalsuan"
          class="h-14 w-14 shrink-0 rounded-lg object-contain bg-emerald-50/50 border border-emerald-100 p-0.5"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <div class="min-w-0">
          <p class="text-[12px] font-bold text-emerald-950">AUSSIE Original - Bisa Scan Barcode & Segel Hologram</p>
          <p class="text-[11px] text-slate-600 leading-tight mt-0.5">
            Garansi 100% Asli: Scan Barcode pada botol untuk verifikasi resmi. Kalium-Boron Kelat + L-Prolin + Asam Humat (500ml, 1L & 2L).
          </p>
        </div>
      </div>

      <h2 class="text-[24px] font-bold leading-[1.15] tracking-tight text-slate-950">
        3 Efek <span class="hl-brush">Pengungkit Tonase AUSSIE</span>
      </h2>
      <p class="text-[14px] text-slate-600 mt-1.5 mb-5">
        Membongkar sisa pupuk yang terkunci di tanah dan mengubahnya menjadi bobot TBS:
      </p>

      <div class="space-y-5">
        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-sawit-anti-trek/overclaim-1.webp"
              alt="Dompolan bunga betina dan buah pasir kelapa sawit muncul rapat melingkar penuh di ketiak pelepah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 1 • OBAT SAWIT JANTAN & BUAH CENGKEH
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Ketiak Pelepah Penuh Bunga Betina & Buah Cengkeh Jadi Normal!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam Amino L-Prolin & Boron aktif menekan hormon stres pemicu bunga jantan (vesipera) dan mengunci penyerbukan sempurna bebas buah cengkeh/landak.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-sawit-anti-trek/overclaim-2.webp"
              alt="Tandan buah segar kelapa sawit ukuran jumbo 30 kg dengan berondolan merah oranye padat"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 2 • DONGKRAK BOBOT +5 S/D +8 KG
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Biji Berondolan Gendut Padat, Berat Janjang Naik Drastis!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Kalium organik mempercepat pengisian daging buah (mesokarp) dan minyak CPO sehingga janjang terasa jauh lebih berat saat dipikul ke TPH.
          </p>
        </div>

        <div class="overflow-hidden rounded-xl border border-emerald-200/80 bg-white shadow-sm">
          <div class="relative aspect-[3/2] w-full bg-slate-900">
            <img
              src="/images/landing/booster-sawit-anti-trek/overclaim-3.webp"
              alt="Akar serabut kelapa sawit putih gondrong aktif menyerap pupuk di piringan tanah"
              class="h-full w-full object-cover"
              width="960"
              height="644"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent px-3.5 pb-2.5 pt-6">
              <span class="inline-block rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                EFEK 3 • BONGKAR HARA GAMBUT & MASAM
              </span>
              <h3 class="text-[15px] font-bold text-white mt-1">
                Aktifkan Metabolisme Akar & Hemat Pupuk Kimia 40%!
              </h3>
            </div>
          </div>
          <p class="p-3 text-[12px] text-slate-600 leading-snug">
            Asam Humat-Fulvat menetralkan pH tanah gambut/salin/masam dan mencairkan residu pupuk NPK yang membatu di tanah agar langsung tersedot akar.
          </p>
        </div>
      </div>

      <!-- Macro Detail Proof -->
      <div class="-mx-5 mt-6 relative">
        <img
          src="/images/landing/booster-sawit-anti-trek/macro-proof.webp"
          alt="Detail makro akar serap putih kelapa sawit dan pelepah hijau segar"
          class="aspect-[16/9] w-full object-cover"
          width="960"
          height="536"
          loading="lazy"
          decoding="async"
        />
        <div class="bg-slate-900 py-2 px-4 text-center">
          <p class="text-[11px] font-bold text-[#BBF7D0]">
            Reaksi Cepat: 1 Liter AUSSIE cukup untuk 35–40 tangki (1 Hektar / 130 pokok sawit)!
